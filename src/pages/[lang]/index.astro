---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEO from '../../components/SEO.astro';
import { getCategories, getTextDictionary } from '../../lib/sheets';

const { lang = 'tr' } = Astro.params;

const [categories, dict] = await Promise.all([
  getCategories(),
  getTextDictionary(lang)
]);

const isEnglish = lang === 'en';
const isMontenegrin = lang === 'me';

const heroTitle =
  dict['home.hero.title'] ||
  dict['home.title'] ||
  'TURSKA PIJACA';

const heroDesc =
  dict['home.hero.text'] ||
  dict['home.hero.subtitle'] ||
  '';

const catTitle =
  dict['home.categories.title'] ||
  (isEnglish
    ? 'Categories'
    : isMontenegrin
      ? 'Kategorije'
      : 'Kategorije');

const pageDescription =
  heroDesc ||
  (isEnglish
    ? 'Wholesale product supply and distribution from Türkiye to Montenegro.'
    : isMontenegrin
      ? 'Veleprodajno snabdijevanje i distribucija proizvoda iz Turske u Crnoj Gori.'
      : 'Türkiye’den Karadağ’a toptan ürün tedariki ve dağıtımı.');

const homeBlocks = [];
const blockNames = new Set();

Object.keys(dict).forEach((key) => {
  if (key.startsWith('home.') || key.startsWith('anasayfa.')) {
    const parts = key.split('.');

    if (
      parts.length >= 2 &&
      !['hero', 'title', 'categories'].includes(parts[1])
    ) {
      blockNames.add(parts[1]);
    }
  }
});

blockNames.forEach((blockName) => {
  const title =
    dict[`home.${blockName}.title`] ||
    dict[`anasayfa.${blockName}.baslik`] ||
    '';

  const content =
    dict[`home.${blockName}.text`] ||
    dict[`home.${blockName}.aciklama`] ||
    dict[`anasayfa.${blockName}.metin`] ||
    '';

  if (title || content) {
    homeBlocks.push({ title, content });
  }
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Turska Pijaca',
  url: Astro.url.href,
  description: pageDescription,
  inLanguage: lang === 'me' ? 'sr-Latn-ME' : lang
};
---

<!doctype html>
<html lang={lang === 'me' ? 'sr-Latn-ME' : lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SEO
      title={heroTitle}
      description={pageDescription}
      lang={lang}
      canonicalUrl={Astro.url.href}
      jsonLd={jsonLd}
    />

    <style>
      :global(body) {
        margin: 0;
        font-family: 'Inter', system-ui, sans-serif;
        color: #0f172a;
        background: #f8fafc;
      }

      .hero {
        padding: 5rem 1.5rem;
        color: #ffffff;
        text-align: center;
        background: linear-gradient(135deg, #0b2218, #143d2c);
      }

      .hero h1 {
        margin: 0 0 1rem;
        font-size: clamp(2.2rem, 6vw, 3.8rem);
        font-weight: 900;
        line-height: 1.1;
      }

      .hero p {
        max-width: 800px;
        margin: 0 auto;
        color: #e2e8f0;
        font-size: clamp(1rem, 2vw, 1.25rem);
        line-height: 1.6;
      }

      .container {
        width: min(100% - 3rem, 1300px);
        min-height: 50vh;
        margin: 4rem auto;
      }

      .section-title {
        margin: 0 0 2.5rem;
        color: #0b2218;
        font-size: clamp(1.8rem, 4vw, 2.2rem);
        font-weight: 800;
        text-align: center;
      }

      .categories-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 1.5rem;
        margin-bottom: 4rem;
      }

      .category-card {
        display: block;
        overflow: hidden;
        padding: 1.25rem;
        color: #0f172a;
        text-align: center;
        text-decoration: none;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        transition:
          transform 0.2s ease,
          border-color 0.2s ease,
          box-shadow 0.2s ease;
      }

      .category-card:hover {
        border-color: #059669;
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
        transform: translateY(-4px);
      }

      .cat-img,
      .cat-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 180px;
        margin-bottom: 1rem;
        object-fit: contain;
        background: #f8fafc;
        border-radius: 8px;
      }

      .cat-placeholder {
        padding: 1rem;
        color: #64748b;
        box-sizing: border-box;
      }

      .cat-name {
