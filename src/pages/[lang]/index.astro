---
import Header from '../../components/Header.astro';
import { getPages } from '../../lib/sheets';

const { lang } = Astro.params;
const validLangs = ['tr', 'en', 'me'];

// Güvenlik: Desteklenmeyen bir dil girilirse anında Türkçe'ye at
if (!validLangs.includes(lang)) {
  return Astro.redirect('/tr');
}

// Ana Sayfa SEO verilerini çek
const pages = await getPages();
const homePage = pages.find(p => p.kod === 'ANA_SAYFA') || {};

// Dil tablosundan başlıkları bul, bulamazsa yedeği kullan
const title = homePage[`ad${lang}`] || homePage['adtr'] || 'Turska Pijaca';
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body style="margin: 0; font-family: system-ui, sans-serif; background: #f8fafc;">
    <Header />
    <main style="max-width: 1200px; margin: 3rem auto; padding: 2rem; background: white; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
      <h1 style="color: #0b2218; font-size: 2.5rem;">{title}</h1>
      <p style="color: #475569; font-size: 1.2rem;">Dinamik ana sayfamız ve dil altyapımız kusursuz çalışıyor.</p>
    </main>
  </body>
</html>
