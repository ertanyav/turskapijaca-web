---
import { getMenu, getPages } from '../lib/sheets';

let menuItems = [];
try {
  menuItems = await getMenu();
  if (!menuItems || menuItems.length === 0) {
    const allPages = await getPages();
    menuItems = allPages || [];
  }
} catch (e) {
  console.error("Header menu error:", e);
}

const { pathname } = Astro.url;
const segments = pathname.split('/').filter(Boolean);
const currentLang = (segments[0] === 'en' || segments[0] === 'me' || segments[0] === 'tr') ? segments[0] : 'tr';

const languages = [
  { code: 'tr', label: 'TR' },
  { code: 'en', label: 'EN' },
  { code: 'me', label: 'ME' }
];

function getLangPath(targetLangCode) {
  if (segments.length === 0) return `/${targetLangCode}`;
  const newSegments = [...segments];
  if (['tr', 'en', 'me'].includes(newSegments[0])) {
    newSegments[0] = targetLangCode;
  } else {
    newSegments.unshift(targetLangCode);
  }
  return '/' + newSegments.join('/');
}
---

<header class="main-header">
  <div class="header-container">
    <div class="logo">
      <a href={`/${currentLang}`}>
        <span class="brand-title">TURSKA PIJACA</span>
      </a>
    </div>

    <nav class="main-menu">
      <ul>
        <li>
          <a href={`/${currentLang}`}>
            {currentLang === 'en' ? 'Home' : currentLang === 'me' ? 'Početna' : 'Ana Sayfa'}
          </a>
        </li>
        {menuItems.map(item => {
          const langKey = currentLang.toUpperCase();
          const name = item[`Ad ${langKey}`] || item['Ad TR'] || item.Kod || '';
          const rawAddress = item[`Adres ${langKey}`] || item['Adres TR'] || '';
          
          if (!name || item.Kod === 'ANA_SAYFA') return null;

          const path = rawAddress.startsWith('/') ? rawAddress : `/${rawAddress}`;
          const finalPath = `/${currentLang}${path}`;

          return (
            <li>
              <a href={finalPath}>{name}</a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="language-switcher">
      {languages.map(lang => (
        <a 
          href={getLangPath(lang.code)} 
          class={currentLang === lang.code ? 'active' : ''}
        >
          {lang.label}
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  .main-header {
    background-color: #0b2218;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo a {
    text-decoration: none;
  }
  .brand-title {
    color: #ffffff;
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: 0.5px;
  }
  .main-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.8rem;
    align-items: center;
  }
  .main-menu a {
    text-decoration: none;
    color: #cbd5e1;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .main-menu a:hover {
    color: #34d399;
  }
  .language-switcher {
    display: flex;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .language-switcher a {
    text-decoration: none;
    color: #94a3b8;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    transition: all 0.2s;
  }
  .language-switcher a:hover {
    color: #ffffff;
  }
  .language-switcher a.active {
    background-color: #34d399;
    color: #0b2218;
  }
</style>
