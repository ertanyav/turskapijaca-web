---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPages, getTexts, getProducts, getCategories, getBrands, getDealers, getDocuments, getTextDictionary } from '../../lib/sheets';

const { lang = 'tr', slug } = Astro.params;
const target = (slug || '').toLowerCase();

const [pages, texts, products, categories, brands, dealers, documents, dict] = await Promise.all([
  getPages(), getTexts(), getProducts(), getCategories(), getBrands(), getDealers(), getDocuments(), getTextDictionary(lang)
]);

const currentPage = pages.find(p => {
  if (!p) return false;
  return target === String(p.adrestr || '').replace(/^\//, '').toLowerCase() || 
         target === String(p.adresen || '').replace(/^\//, '').toLowerCase() || 
         target === String(p.adresme || '').replace(/^\//, '').toLowerCase() || 
         target === (p.kod || '').toLowerCase();
});

const matchedCategory = categories.find(c => target === String(c.adrestr || '').replace(/^\//, '').toLowerCase());
const isProductPage = (currentPage && (currentPage.kod === 'products' || currentPage.kod === 'catalog' || target.includes('urunler'))) || matchedCategory;

const isBrandsPage = currentPage && currentPage.kod === 'brands';
const isDealersPage = currentPage && currentPage.kod === 'network';
const isDocsPage = currentPage && currentPage.kod === 'documents';

const phone = dict['contact.phone'] || '+38263256666';
const cleanPhone = phone.replace(/[^0-9]/g, '');

let pageTitle = currentPage ? (currentPage[`ad${lang}`] || currentPage.adtr) : (matchedCategory ? matchedCategory[`ad${lang}`] || matchedCategory.adtr : 'Katalog');
let pageParagraphs = [];

if (texts && currentPage) {
  const langCol = lang === 'en' ? 'english' : lang === 'me' ? 'crnogorski' : 'turkce';
  const pagePrefix = `${(currentPage.kod || '').toLowerCase()}.`;
  texts.forEach(t => {
    const key = (t.anahtar || '').toLowerCase();
    if (key.startsWith(pagePrefix) && !key.endsWith('.title') && (t[langCol] || t.turkce)) {
      pageParagraphs.push(t[langCol] || t.turkce);
    }
  });
}
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle} | TURSKA PIJACA</title>
    <style>
      body { margin: 0; font-family: 'Inter', system-ui, sans-serif; background: #f8fafc; color: #0f172a; }
      .container { max-width: 1280px; margin: 2.5rem auto; padding: 0 1.5rem; min-height: 65vh; }
      .page-header h1 { font-size: 2.2rem; color: #0b2218; font-weight: 800; margin: 0 0 1.5rem; }
      
      /* Filter controls */
      .catalog-controls { background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.2rem; margin-bottom: 2rem; display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
      .search-input { flex: 1; min-width: 220px; padding: 0.65rem 1rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.95rem; }
      .select-input { padding: 0.65rem 1rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.95rem; background: white; }

      /* Product Grid */
      .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem; }
      .product-card { background: white; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; transition: border-color 0.2s; }
      .product-card:hover { border-color: #34d399; }
      .product-img { width: 100%; height: 200px; object-fit: contain; padding: 12px; background: #ffffff; border-bottom: 1px solid #f1f5f9; }
      .product-info { padding: 1.2rem; display: flex; flex-direction: column; flex-grow: 1; }
      .product-name { font-size: 1rem; font-weight: 700; color: #0b2218; margin: 0 0 0.5rem; }
      .product-specs { font-size: 0.82rem; color: #64748b; margin-bottom: 0.8rem; }
      .product-price { font-size: 1.1rem; font-weight: 800; color: #059669; margin-bottom: 1rem; }
      .whatsapp-btn { margin-top: auto; display: block; text-align: center; background: #25d366; color: white; padding: 0.65rem; border-radius: 6px; text-decoration: none; font-weight: 700; font-size: 0.88rem; }

      /* Entities & Documents */
      .entities-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
      .entity-card { background: white; border: 1px solid #e2e8f0; padding: 1.5rem; border-radius: 8px; text-decoration: none; color: inherit; display: flex; flex-direction: column; }
      .entity-img { width: 100%; height: 80px; object-fit: contain; margin-bottom: 1rem; }
      .doc-card { display: flex; justify-content: space-between; align-items: center; background: white; padding: 1.2rem 1.5rem; border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 1rem; }
      .doc-btn { background: #0b2218; color: white; padding: 0.5rem 1.2rem; border-radius: 6px; text-decoration: none; font-weight: 700; font-size: 0.9rem; }
    </style>
  </head>
  <body>
    <Header />
    <main class="container">
      <div class="page-header"><h1>{pageTitle}</h1></div>

      {isProductPage ? (
        <div>
          <div class="catalog-controls">
            <input type="text" id="searchInput" class="search-input" placeholder="Ürün adı veya kodu arayın / Search name or code..." />
            <select id="categorySelect" class="select-input">
              <option value="">Tüm Kategoriler / All Categories</option>
              {categories.map(c => <option value={(c.kod || '').toLowerCase()} selected={matchedCategory && (matchedCategory.kod || '').toLowerCase() === (c.kod || '').toLowerCase()}>{c[`ad${lang}`] || c.adtr}</option>)}
            </select>
            <select id="brandSelect" class="select-input">
              <option value="">Tüm Markalar / All Brands</option>
              {brands.map(b => <option value={(b.marka || '').toLowerCase()}>{b.marka}</option>)}
            </select>
            <select id="sortSelect" class="select-input">
              <option value="default">Sıralama: Varsayılan</option>
              <option value="price-asc">Fiyat: Düşükten Yükseğe</option>
              <option value="price-desc">Fiyat: Yüksekten Düşüğe</option>
            </select>
          </div>

          <div class="products-grid" id="productsContainer">
            {products.map(p => {
              const name = p[`ad${lang}`] || p.adtr || p.icad || 'Ürün';
              const code = p.urunno || p.kayitid || '';
              const catKey = (p.kategori || '').toLowerCase();
              const brandKey = (p.marka || '').toLowerCase();
              const priceVal = parseFloat(String(p.fiyateur || '0').replace(',', '.')) || 0;
              const priceFormatted = p.fiyateur ? `${p.fiyateur} €` : '';
              const waText = encodeURIComponent(`Merhaba, sipariş vermek istiyorum: ${name} (Kod: ${code})`);

              return (
                <div class="product-card" data-name={name.toLowerCase()} data-code={code.toLowerCase()} data-cat={catKey} data-brand={brandKey} data-price={priceVal}>
                  <img src={p.gorselurl || 'https://via.placeholder.com/300'} alt={name} class="product-img" loading="lazy" />
                  <div class="product-info">
                    <div class="product-name">{name}</div>
                    <div class="product-specs">{p.ambalaj ? `${p.ambalaj} · ` : ''}Kod: {code}</div>
                    {priceFormatted && <div class="product-price">{priceFormatted}</div>}
                    <a href={`https://wa.me/${cleanPhone}?text=${waText}`} target="_blank" class="whatsapp-btn">💬 Sipariş Ver / Order</a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ) : (
        <div style="background: white; border: 1px solid #e2e8f0; padding: 2.5rem; border-radius: 8px;">
          {pageParagraphs.map(txt => <p style="font-size: 1.05rem; line-height: 1.8; color: #334155;">{txt}</p>)}

          {/* Markalar */}
          {isBrandsPage && brands && (
            <div>
              <h2 style="color:#0b2218; margin-top:1.5rem;">Distribütörlüğünü Yaptığımız Markalar</h2>
              <div class="entities-grid">
                {brands.filter(b => (b.tur || '').includes('DISTRIBUTOR')).map(b => (
                  <a href={`/${lang}/ürünler/tüm-ürünler?marka=${b.marka}`} class="entity-card">
                    {b.gorselurl ? <img src={b.gorselurl} class="entity-img" alt={b.marka} /> : <h3>{b.marka}</h3>}
                  </a>
                ))}
              </div>
              <h2 style="color:#0b2218; margin-top:3rem;">Satış Portföyümüzdeki Markalar</h2>
              <div class="entities-grid">
                {brands.filter(b => !(b.tur || '').includes('DISTRIBUTOR')).map(b => (
                  <a href={`/${lang}/ürünler/tüm-ürünler?marka=${b.marka}`} class="entity-card">
                    {b.gorselurl ? <img src={b.gorselurl} class="entity-img" alt={b.marka} /> : <h3>{b.marka}</h3>}
                  </a>
                ))}
              </div>
            </div>
          )}

          {/* Bayiler ve Depolar */}
          {isDealersPage && dealers && (
            <div>
              <h2 style="color:#0b2218; margin-top:1.5rem;">Yetkili Satış Noktaları</h2>
              <div class="entities-grid">
                {dealers.filter(d => (d.tur || '').includes('DEALER')).map(d => (
                  <div class="entity-card">
                    <h3 style="margin:0 0 0.5rem; color:#0b2218;">{d.ad}</h3>
                    <div style="font-weight:700; color:#34d399; font-size:0.9rem;">{d.sehir}</div>
                    {d.adres && <div style="font-size:0.88rem; color:#475569; margin-top:0.4rem;">📍 {d.adres}</div>}
                  </div>
                ))}
              </div>
              <h2 style="color:#0b2218; margin-top:3rem;">Depolarımız</h2>
              <div class="entities-grid">
                {dealers.filter(d => (d.tur || '').includes('WAREHOUSE')).map(d => (
                  <div class="entity-card" style="background:#f8fafc;">
                    <h3 style="margin:0 0 0.5rem; color:#0b2218;">{d.ad}</h3>
                    <div style="font-weight:700; color:#0b2218; font-size:0.9rem;">{d.sehir}</div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Dokümanlar */}
          {isDocsPage && documents && (
            <div style="margin-top:2rem;">
              {documents.map(doc => (
                <div class="doc-card">
                  <div>
                    <h3 style="margin:0 0 0.3rem; color:#0b2218;">{doc[`ad${lang}`] || doc.adtr}</h3>
                    <div style="font-size:0.88rem; color:#64748b;">{doc[`aciklama${lang}`] || doc.aciklamatr}</div>
                  </div>
                  <a href={`https://drive.google.com/file/d/${doc.driveid}/view`} target="_blank" class="doc-btn">Görüntüle / View</a>
                </div>
              ))}
            </div>
          )}
        </div>
      )}
    </main>

    <script>
      // Canlı Arama ve Filtreleme Logiği
      const searchInput = document.getElementById('searchInput');
      const categorySelect = document.getElementById('categorySelect');
      const brandSelect = document.getElementById('brandSelect');
      const sortSelect = document.getElementById('sortSelect');
      const container = document.getElementById('productsContainer');

      if (container) {
        const cards = Array.from(container.children);

        function filterAndSort() {
          const q = searchInput?.value.toLowerCase().trim() || '';
          const cat = categorySelect?.value.toLowerCase() || '';
          const brand = brandSelect?.value.toLowerCase() || '';
          const sort = sortSelect?.value || 'default';

          let visibleCards = cards.filter(card => {
            const name = card.getAttribute('data-name') || '';
            const code = card.getAttribute('data-code') || '';
            const cCat = card.getAttribute('data-cat') || '';
            const cBrand = card.getAttribute('data-brand') || '';

            const matchQuery = !q || name.includes(q) || code.includes(q);
            const matchCat = !cat || cCat === cat;
            const matchBrand = !brand || cBrand === brand;

            return matchQuery && matchCat && matchBrand;
          });

          cards.forEach(card => card.style.display = 'none');

          if (sort === 'price-asc') {
            visibleCards.sort((a, b) => parseFloat(a.getAttribute('data-price')) - parseFloat(b.getAttribute('data-price')));
          } else if (sort === 'price-desc') {
            visibleCards.sort((a, b) => parseFloat(b.getAttribute('data-price')) - parseFloat(a.getAttribute('data-price')));
          }

          visibleCards.forEach(card => {
            card.style.display = 'flex';
            container.appendChild(card);
          });
        }

        searchInput?.addEventListener('input', filterAndSort);
        categorySelect?.addEventListener('change', filterAndSort);
        brandSelect?.addEventListener('change', filterAndSort);
        sortSelect?.addEventListener('change', filterAndSort);

        // URL parametresi ile gelindiyse (ör. ?marka=Heynut)
        const urlParams = new URLSearchParams(window.location.search);
        const markaParam = urlParams.get('marka');
        if (markaParam && brandSelect) {
          brandSelect.value = markaParam.toLowerCase();
          filterAndSort();
        }
      }
    </script>
    <Footer lang={lang} />
  </body>
</html>
