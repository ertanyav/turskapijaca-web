---
import { getMenu, getLogoUrl, getTextDictionary } from '../lib/sheets';

const { pathname = '' } = Astro.url;
const segments = pathname.split('/').filter(Boolean);
const currentLang = ['tr', 'en', 'me'].includes(segments[0]) ? segments[0] : 'tr';

let menuItems = [];
let logoUrl = '';
let dict = {};

try {
  [menuItems, logoUrl, dict] = await Promise.all([
    getMenu(),
    getLogoUrl(),
    getTextDictionary(currentLang)
  ]);
} catch (error) {
  console.error('Header verileri yüklenemedi:', error);
}

const languages = [
  { code: 'tr', label: 'TR' },
  { code: 'en', label: 'EN' },
  { code: 'me', label: 'ME' }
];

function getLangPath(targetCode) {
  if (segments.length === 0) return `/${targetCode}`;

  const newSegments = [...segments];

  if (['tr', 'en', 'me'].includes(newSegments[0])) {
    newSegments[0] = targetCode;
  } else {
    newSegments.unshift(targetCode);
  }

  return '/' + newSegments.join('/');
}

// Master dosyadan dinamik metinler
const txtCart =
  dict['common.cart'] ||
  dict['ortak.sepet'] ||
  (currentLang === 'en'
    ? 'Cart'
    : currentLang === 'me'
      ? 'Korpa'
      : 'Sepet');

const txtCheckout =
  dict['cart.checkout'] ||
  (currentLang === 'en'
    ? 'Complete Order'
    : currentLang === 'me'
      ? 'Naruči'
      : 'Siparişi Tamamla');

const txtEmpty =
  dict['cart.empty'] ||
  (currentLang === 'en'
    ? 'Cart is empty'
    : currentLang === 'me'
      ? 'Korpa je prazna'
      : 'Sepetiniz boş.');

const txtCode =
  dict['product.code'] ||
  (currentLang === 'en'
    ? 'Code'
    : currentLang === 'me'
      ? 'Šifra'
      : 'Kod');

const txtMenu =
  currentLang === 'en'
    ? 'Menu'
    : currentLang === 'me'
      ? 'Meni'
      : 'Menü';

const phone = dict['contact.phone'] || '38263256666';
const cleanPhone = String(phone).replace(/[^0-9]/g, '');
---

<header class="main-header">
  <div class="header-container">
    <a href={`/${currentLang}`} class="logo-link" aria-label="TURSKA PIJACA">
      {logoUrl && (
        <img
          src={logoUrl}
          alt="TURSKA PIJACA"
          class="site-logo"
          width="180"
          height="48"
        />
      )}
    </a>

    <button
      id="mobile-menu-toggle"
      class="mobile-menu-toggle"
      type="button"
      aria-label={txtMenu}
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav id="main-navigation" class="main-menu" aria-label={txtMenu}>
      <ul>
        {menuItems.map(item => {
          const name = item[`ad${currentLang}`] || item.adtr;
          const rawAddress = item[`adres${currentLang}`] || item.adrestr;

          if (!name || item.kod === 'home' || !rawAddress) return null;

          const cleanAddress = String(rawAddress)
            .replace(/^\/+/, '')
            .replace(/\/+$/, '');

          const finalPath = `/${currentLang}/${cleanAddress}`.toLowerCase();
          const hasChildren = item.children && item.children.length > 0;

          return (
            <li class={`menu-item ${hasChildren ? 'has-dropdown' : ''}`}>
              <a href={finalPath} class="menu-link">
                {name}
                {hasChildren && <span class="arrow" aria-hidden="true">▾</span>}
              </a>

              {hasChildren && (
                <ul class="dropdown-menu">
                  {item.children.map(child => {
                    const childName = child[`ad${currentLang}`] || child.adtr;
                    const childAddr = child[`adres${currentLang}`] || child.adrestr;

                    if (!childName || !childAddr) return null;

                    const childPath = `/${currentLang}/${String(childAddr)
                      .replace(/^\/+/, '')
                      .replace(/\/+$/, '')}`.toLowerCase();

                    return (
                      <li>
                        <a href={childPath}>{childName}</a>
                      </li>
                    );
                  })}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-right">
      <button
        id="cart-toggle"
        class="cart-btn"
        type="button"
        aria-label={txtCart}
        aria-expanded="false"
        aria-controls="cart-sidebar"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>

        <span class="cart-count-badge" id="cart-count" aria-live="polite">0</span>
      </button>

      <div class="language-switcher" aria-label="Language selection">
        {languages.map(language => (
          <a
            href={getLangPath(language.code)}
            class={currentLang === language.code ? 'active' : ''}
            aria-current={currentLang === language.code ? 'page' : undefined}
          >
            {language.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<div id="mobile-menu-overlay" class="mobile-menu-overlay"></div>

<aside
  id="cart-sidebar"
  class="cart-sidebar"
  aria-hidden="true"
  aria-label={txtCart}
>
  <div class="cart-header">
    <h2>{txtCart}</h2>

    <button
      id="cart-close"
      class="cart-close"
      type="button"
      aria-label={currentLang === 'en' ? 'Close cart' : currentLang === 'me' ? 'Zatvori korpu' : 'Sepeti kapat'}
    >
      ×
    </button>
  </div>

  <div id="cart-items" class="cart-items"></div>

  <div class="cart-footer">
    <button
      id="checkout-btn"
      class="checkout-btn"
      type="button"
      data-phone={cleanPhone}
    >
      {txtCheckout}
    </button>
  </div>
</aside>

<div id="cart-overlay" class="cart-overlay"></div>

<script define:vars={{ txtEmpty, txtCode }}>
  const CART_STORAGE_KEY = 'tp_cart';
  const FALLBACK_IMAGE = 'https://via.placeholder.com/70';

  let cart = [];

  function readCart() {
    try {
      const storedCart = JSON.parse(
        localStorage.getItem(CART_STORAGE_KEY) || '[]'
      );

      if (!Array.isArray(storedCart)) return [];

      return storedCart
        .filter(item => item && item.id)
        .map(item => ({
          id: String(item.id),
          name: String(item.name || ''),
          img: String(item.img || ''),
          qty: Math.max(1, Number(item.qty) || 1)
        }));
    } catch (error) {
      console.error('Sepet okunamadı:', error);
      return [];
    }
  }

  function saveCart() {
    localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
  }

  function getCartQuantity() {
    return cart.reduce((total, item) => total + item.qty, 0);
  }

  function updateCartCount() {
    const countElement = document.getElementById('cart-count');

    if (!countElement) return;

    const quantity = getCartQuantity();

    countElement.textContent = String(quantity);
    countElement.hidden = quantity === 0;
  }

  function createElement(tagName, className, text = '') {
    const element = document.createElement(tagName);

    if (className) {
      element.className = className;
    }

    if (text) {
      element.textContent = text;
    }

    return element;
  }

  function renderCart() {
    const itemsContainer = document.getElementById('cart-items');

    updateCartCount();

    if (!itemsContainer) return;

    itemsContainer.replaceChildren();

    if (cart.length === 0) {
      const emptyMessage = createElement('p', 'cart-empty', txtEmpty);
      itemsContainer.appendChild(emptyMessage);
      return;
    }

    cart.forEach((item, index) => {
      const cartItem = createElement('div', 'cart-item');

      const image = document.createElement('img');
      image.src = item.img || FALLBACK_IMAGE;
      image.alt = item.name;
      image.width = 70;
      image.height = 70;
      image.loading = 'lazy';
      image.referrerPolicy = 'no-referrer';

      image.addEventListener('error', () => {
        image.src = FALLBACK_IMAGE;
      }, { once: true });

      const itemInfo = createElement('div', 'cart-item-info');
      const itemName = createElement('div', 'cart-item-name', item.name);
      const itemCode = createElement(
        'div',
        'cart-item-code',
        `${txtCode}: ${item.id}`
      );

      const quantityControls = createElement('div', 'cart-item-qty');

      const decreaseButton = createElement('button', 'qty-button', '−');
      decreaseButton.type = 'button';
      decreaseButton.dataset.index = String(index);
      decreaseButton.dataset.change = '-1';
      decreaseButton.setAttribute('aria-label', 'Decrease quantity');

      const quantity = createElement(
        'span',
        'cart-item-quantity',
        String(item.qty)
      );

      const increaseButton = createElement('button', 'qty-button', '+');
      increaseButton.type = 'button';
      increaseButton.dataset.index = String(index);
      increaseButton.dataset.change = '1';
      increaseButton.setAttribute('aria-label', 'Increase quantity');

      quantityControls.append(
        decreaseButton,
        quantity,
        increaseButton
      );

      itemInfo.append(itemName, itemCode, quantityControls);
      cartItem.append(image, itemInfo);
      itemsContainer.appendChild(cartItem);
    });
  }

  function updateQuantity(index, change) {
    const item = cart[index];

    if (!item) return;

    item.qty += change;

    if (item.qty <= 0) {
      cart.splice(index, 1);
    }

    saveCart();
    renderCart();
    window.dispatchEvent(new Event('cartUpdated'));
  }

  function openCart() {
    const sidebar = document.getElementById('cart-sidebar');
    const overlay = document.getElementById('cart-overlay');
    const toggleButton = document.getElementById('cart-toggle');

    sidebar?.classList.add('open');
    sidebar?.setAttribute('aria-hidden', 'false');
    overlay?.classList.add('open');
    toggleButton?.setAttribute('aria-expanded', 'true');

    renderCart();
  }

  function closeCart() {
    const sidebar = document.getElementById('cart-sidebar');
    const overlay = document.getElementById('cart-overlay');
    const toggleButton = document.getElementById('cart-toggle');

    sidebar?.classList.remove('open');
    sidebar?.setAttribute('aria-hidden', 'true');
    overlay?.classList.remove('open');
    toggleButton?.setAttribute('aria-expanded', 'false');
  }

  function toggleCart() {
    const sidebar = document.getElementById('cart-sidebar');

    if (sidebar?.classList.contains('open')) {
      closeCart();
    } else {
      openCart();
    }
  }

  function addToCart(id, name, img = '') {
    if (!id || !name) return;

    const productId = String(id);
    const productName = String(name);
    const productImage = String(img || '');

    const existingItem = cart.find(item => item.id === productId);

    if (existingItem) {
      existingItem.qty += 1;

      if (!existingItem.img && productImage) {
        existingItem.img = productImage;
      }
    } else {
      cart.push({
        id: productId,
        name: productName,
        img: productImage,
        qty: 1
      });
    }

    saveCart();
    renderCart();
    window.dispatchEvent(new Event('cartUpdated'));
    openCart();
  }

  function toggleMobileMenu() {
    const navigation = document.getElementById('main-navigation');
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const overlay = document.getElementById('mobile-menu-overlay');

    const isOpen = navigation?.classList.toggle('mobile-open');

    toggleButton?.classList.toggle('is-open', Boolean(isOpen));
    toggleButton?.setAttribute('aria-expanded', String(Boolean(isOpen)));
    overlay?.classList.toggle('open', Boolean(isOpen));
    document.body.classList.toggle('menu-open', Boolean(isOpen));
  }

  function closeMobileMenu() {
    const navigation = document.getElementById('main-navigation');
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const overlay = document.getElementById('mobile-menu-overlay');

    navigation?.classList.remove('mobile-open');
    toggleButton?.classList.remove('is-open');
    toggleButton?.setAttribute('aria-expanded', 'false');
    overlay?.classList.remove('open');
    document.body.classList.remove('menu-open');
  }

  cart = readCart();

  document
    .getElementById('cart-toggle')
    ?.addEventListener('click', toggleCart);

  document
    .getElementById('cart-close')
    ?.addEventListener('click', closeCart);

  document
    .getElementById('cart-overlay')
    ?.addEventListener('click', closeCart);

  document
    .getElementById('mobile-menu-toggle')
    ?.addEventListener('click', toggleMobileMenu);

  document
    .getElementById('mobile-menu-overlay')
    ?.addEventListener('click', closeMobileMenu);

  document
    .getElementById('cart-items')
    ?.addEventListener('click', event => {
      const button = event.target.closest('.qty-button');

      if (!button) return;

      const index = Number(button.dataset.index);
      const change = Number(button.dataset.change);

      if (!Number.isInteger(index) || !Number.isFinite(change)) return;

      updateQuantity(index, change);
    });

  document
    .getElementById('checkout-btn')
    ?.addEventListener('click', event => {
      if (cart.length === 0) return;

      const button = event.currentTarget;
      const phone = button?.getAttribute('data-phone') || '';

      const lines = cart.map(
        item => `- ${item.name} (${txtCode}: ${item.id}) x ${item.qty}`
      );

      const message = [
        'Merhaba, aşağıdaki ürünler için toptan sipariş/teklif talep ediyorum:',
        '',
        ...lines
      ].join('\n');

      window.open(
        `https://wa.me/${phone}?text=${encodeURIComponent(message)}`,
        '_blank',
        'noopener,noreferrer'
      );
    });

  document
    .getElementById('main-navigation')
    ?.addEventL
