---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPages, getTexts } from '../../lib/sheets';

const { lang = 'tr', slug } = Astro.params;
const validLangs = ['tr', 'en', 'me'];

if (!validLangs.includes(lang)) {
  return Astro.redirect('/tr');
}

let pages = [];
let texts = [];

try {
  const res = await Promise.all([getPages(), getTexts()]);
  pages = res[0] || [];
  texts = res[1] || [];
} catch (e) {}

const target = (slug || '').toLowerCase();

const currentPage = pages.find(p => {
  if (!p) return false;
  const aTR = String(p.adrestr || '').replace(/^\//, '').toLowerCase();
  const aEN = String(p.adresen || '').replace(/^\//, '').toLowerCase();
  const aME = String(p.adresme || '').replace(/^\//, '').toLowerCase();
  const kod = String(p.kod || '').toLowerCase();
  
  return target === aTR || target === aEN || target === aME || target === kod;
});

if (!currentPage && target !== '') {
  return Astro.redirect(`/${lang}`);
}

let pageTitle = currentPage ? currentPage.kod : 'Sayfa';
let pageContent = '';

if (texts && texts.length > 0 && currentPage) {
  const langCol = lang === 'en' ? 'english' : lang === 'me' ? 'crnogorski' : 'turkce';
  
  const titleRow = texts.find(t => (t.anahtar || '').toLowerCase() === `${(currentPage.kod || '').toLowerCase()}.title`);
  if (titleRow) pageTitle = titleRow[langCol] || titleRow.turkce || currentPage.kod;

  const descRow = texts.find(t => (t.anahtar || '').toLowerCase() === `${(currentPage.kod || '').toLowerCase()}.description` || (t.anahtar || '').toLowerCase() === `${(currentPage.kod || '').toLowerCase()}.text`);
  if (descRow) pageContent = descRow[langCol] || descRow.turkce || '';
}
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle} | TURSKA PIJACA</title>
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; background-color: #f8fafc; color: #0f172a; }
      .container { max-width: 1000px; margin: 3.5rem auto; padding: 0 1.5rem; min-height: 50vh; }
      .content-card { background: white; padding: 3rem; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; }
      .content-card h1 { color: #0b2218; font-size: 2rem; margin-top: 0; margin-bottom: 1.5rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 1rem; }
      .body-text { font-size: 1.1rem; line-height: 1.8; color: #334155; white-space: pre-wrap; }
    </style>
  </head>
  <body>
    <Header />
    <main class="container">
      <div class="content-card">
        <h1>{pageTitle}</h1>
        
        {pageContent ? (
          <div class="body-text" set:html={pageContent} />
        ) : (
          <div class="body-text">
            <p>Bu sayfa içeriği yakında güncellenecektir.</p>
          </div>
        )}
      </div>
    </main>
    <Footer lang={lang} />
  </body>
</html>
