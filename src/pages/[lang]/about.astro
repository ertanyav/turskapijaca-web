---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getTexts } from '../../lib/sheets';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'me' } },
    { params: { lang: 'tr' } }
  ];
}

const { lang } = Astro.params;
const texts = await getTexts();
const aboutBody = texts['about.body']?.[lang] || 'Türkiye’deki üretim ve tedarik kaynaklarına doğrudan erişim, seçili ürünlerde güçlü bir tedarik avantajı sağlar.';
---

<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <title>Kurumsal & Lojistik Gücümüz | TURSKA PIJACA</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>
<body style="margin: 0; font-family: system-ui, sans-serif; background: #0d221a; color: #f0f4ed;">
  <Header lang={lang} texts={texts} />

  <main style="max-width: 1000px; margin: 3rem auto; padding: 0 1.5rem;">
    <div style="background: #142e23; border-radius: 16px; padding: 3rem; border: 1px solid #234d3c;">
      
      <span style="background: #d9b871; color: #173f31; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.8rem; font-weight: 800; text-transform: uppercase;">
        UNIVERCERT MNE D.O.O.
      </span>

      <h1 style="font-size: 2.2rem; color: #f0f4ed; margin: 1rem 0 1.5rem 0; font-weight: 800;">
        TURSKA PIJACA — Fabrikadan Doğrudan Karadağ'a B2B Toptan Tedarik
      </h1>

      <div style="font-size: 1.05rem; line-height: 1.8; color: #a3c2b5;">
        <p style="white-space: pre-line;">{aboutBody}</p>

        <div style="background: #173f31; padding: 1.5rem; border-left: 4px solid #d9b871; margin: 2rem 0; border-radius: 0 12px 12px 0;">
          <h3 style="margin: 0 0 0.5rem 0; color: #d9b871;">🏭 Seda Gıda Fabrikası Temsilciliği</h3>
          <p style="margin: 0; color: #f0f4ed;">
            Platformumuz, Türkiye'deki öz fabrikamız olan <strong>Seda Gıda</strong>'nın resmi Karadağ temsilcisidir. Fabrikamızda ürettiğimiz kendi markalarımızın yanı sıra, distribütörü olduğumuz üretici markaları da doğrudan fabrikadan alarak aracısız sunuyoruz.
          </p>
        </div>

        <h2 style="font-size: 1.4rem; color: #d9b871; margin-top: 2rem;">🚚 Kesintisiz Lojistik ve Dağıtım Ağımız</h2>
        <ul style="list-style-type: none; padding: 0; margin: 1rem 0;">
          <li style="padding: 0.8rem 0; border-bottom: 1px solid #234d3c;">
            <strong>Haftalık Fabrika Sevkiyatı:</strong> Türkiye fabrikamızdan Karadağ depomuza her hafta düzenli transfer.
          </li>
          <li style="padding: 0.8rem 0; border-bottom: 1px solid #234d3c;">
            <strong>Karadağ Genelinde Özel Dağıtım Filosu:</strong> Podgorica, Budva, Tivat, Kotor, Nikšić ve Karadağ'ın tüm şehirlerine toptan teslimat.
          </li>
        </ul>

        <div style="margin-top: 2.5rem; text-align: center;">
          <a href={`/${lang}/`} target="_self" style="background: #d9b871; color: #173f31; padding: 0.9rem 2rem; border-radius: 8px; text-decoration: none; font-weight: 800; display: inline-block;">
            ← Ürün Kataloğuna Dön
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer lang={lang} texts={texts} />
</body>
</html>
