---
import { getMenu, getLogoUrl, getTextDictionary } from '../lib/sheets';

const { pathname = '' } = Astro.url;
const segments = pathname.split('/').filter(Boolean);
const currentLang = ['tr', 'en', 'me'].includes(segments[0]) ? segments[0] : 'tr';

let menuItems = [], logoUrl = '', dict = {};
try { [menuItems, logoUrl, dict] = await Promise.all([getMenu(), getLogoUrl(), getTextDictionary(currentLang)]); } catch(e){}

const languages = [ { code: 'tr', label: 'TR' }, { code: 'en', label: 'EN' }, { code: 'me', label: 'ME' } ];
function getLangPath(targetCode) {
  if (segments.length === 0) return `/${targetCode}`;
  const newSegs = [...segments];
  if (['tr', 'en', 'me'].includes(newSegs[0])) newSegs[0] = targetCode; else newSegs.unshift(targetCode);
  return '/' + newSegs.join('/');
}

const companyName = dict['company.name'] || 'UNIVERCERT-MNE D.O.O.';
---

<header class="main-header">
  <div class="header-container">
    <a href={`/${currentLang}`} class="logo-link">
      {logoUrl ? <img src={logoUrl} alt="TURSKA PIJACA" class="site-logo" /> : null}
      <div class="brand-text-wrap">
        <span class="brand-title">TURSKA PIJACA</span>
        <span class="brand-subtitle">{companyName}</span>
      </div>
    </a>

    <nav class="main-menu">
      <ul>
        {menuItems.map(item => {
          const name = item[`ad${currentLang}`] || item.adtr;
          const rawAddress = item[`adres${currentLang}`] || item.adrestr;
          if (!name || item.kod === 'home' || !rawAddress) return null;

          const cleanAddress = String(rawAddress).replace(/^\//, '');
          const finalPath = `/${currentLang}/${cleanAddress}`.toLowerCase();
          const hasChildren = item.children && item.children.length > 0;

          return (
            <li class={`menu-item ${hasChildren ? 'has-dropdown' : ''}`}>
              <a href={finalPath} class="menu-link">{name} {hasChildren && <span class="arrow">▾</span>}</a>
              {hasChildren && (
                <ul class="dropdown-menu">
                  {item.children.map(child => {
                    const childName = child[`ad${currentLang}`] || child.adtr;
                    const childAddr = child[`adres${currentLang}`] || child.adrestr;
                    return <li><a href={`/${currentLang}/${String(childAddr).replace(/^\//, '')}`.toLowerCase()}>{childName}</a></li>;
                  })}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-right">
      <div class="language-switcher">
        {languages.map(lang => <a href={getLangPath(lang.code)} class={currentLang === lang.code ? 'active' : ''}>[{lang.label.toUpperCase()}]</a>)}
      </div>
    </div>
  </div>
</header>

<style>
  .main-header { background: #0b2218; border-bottom: 1px solid rgba(255,255,255,0.12); position: sticky; top: 0; z-index: 1000; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
  .header-container { max-width: 1280px; margin: 0 auto; padding: 0.75rem 1.5rem; display: flex; justify-content: space-between; align-items: center; }
  .logo-link { display: flex; align-items: center; gap: 0.8rem; text-decoration: none; }
  .site-logo { height: 42px; width: auto; object-fit: contain; }
  .brand-text-wrap { display: flex; flex-direction: column; }
  .brand-title { color: #ffffff; font-weight: 800; font-size: 1.25rem; letter-spacing: 0.5px; line-height: 1.1; }
  .brand-subtitle { color: #34d399; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.5px; margin-top: 2px; }
  .main-menu ul { list-style: none; padding: 0; margin: 0; display: flex; gap: 1.6rem; align-items: center; }
  .menu-item { position: relative; }
  .menu-link { text-decoration: none; color: #e2e8f0; font-weight: 600; font-size: 0.92rem; padding: 1rem 0; display: flex; gap: 0.3rem; align-items: center; }
  .menu-link:hover { color: #34d399; }
  
  .dropdown-menu { 
    visibility: hidden; opacity: 0; position: absolute; top: 100%; left: 0; 
    background: #071710; border: 1px solid rgba(255,255,255,0.15); border-radius: 6px; 
    padding: 0.4rem 0; min-width: 220px; display: flex; flex-direction: column; z-index: 100; 
    box-shadow: 0 10px 25px rgba(0,0,0,0.3); transition: all 0.2s ease; transform: translateY(8px);
  }
  .has-dropdown:hover .dropdown-menu { visibility: visible; opacity: 1; transform: translateY(0); }
  .dropdown-menu a { padding: 0.65rem 1.2rem; display: block; text-decoration: none; color: #cbd5e1; font-size: 0.88rem; font-weight: 500; }
  .dropdown-menu a:hover { background: rgba(52, 211, 153, 0.12); color: #34d399; }

  .header-right { display: flex; gap: 1rem; align-items: center; }
  .language-switcher { display: flex; gap: 0.2rem; }
  .language-switcher a { color: #94a3b8; font-size: 0.8rem; font-weight: 700; padding: 0.2rem 0.4rem; text-decoration: none; }
  .language-switcher a.active { color: #34d399; }
</style>
