---
import { getPages, getTexts, getProducts, getBrands, getCategories } from '../../lib/sheets';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'tr' } },
    { params: { lang: 'en' } },
    { params: { lang: 'me' } },
  ];
}

const { lang } = Astro.params;
const currentLang = lang || 'tr';

const texts = await getTexts();
const products = await getProducts();
const brands = await getBrands();
const categories = await getCategories();

// Metin çevirileri için yardımcı fonksiyon
function getText(key, defaultVal) {
  const found = texts.find(t => t.Anahtar === key);
  if (!found) return defaultVal;
  if (currentLang === 'en') return found.English || defaultVal;
  if (currentLang === 'me') return found.Crnogorski || defaultVal;
  return found.Türkçe || defaultVal;
}

// Sayaçlar (Master kurallarına göre filtrelenmiş aktif veriler)
const productCount = products.length; // 120 aktif ürün
const categoryCount = categories.length; // Aktif kategoriler
const brandCount = brands.length; // Aktif markalar
---

<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{getText('home.title', 'Ana Sayfa')} - TURSKA PIJACA</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, -apple-system, sans-serif;
        background-color: #0b2218; /* Kurumsal koyu yeşil arka plan */
        color: #ffffff;
      }
      .hero-section {
        max-width: 1400px;
        margin: 2rem auto;
        padding: 0 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 2rem;
      }
      .hero-content {
        max-width: 700px;
      }
      .hero-title {
        font-size: 2.75rem;
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 1rem;
      }
      .hero-subtitle {
        font-size: 1.2rem;
        color: #cbd5e1;
        line-height: 1.5;
        white-space: pre-line;
      }
      .stats-box {
        display: flex;
        gap: 1.5rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 1.5rem 2rem;
        border-radius: 12px;
        text-align: center;
      }
      .stat-item .number {
        font-size: 2rem;
        font-weight: 700;
        color: #ffffff;
      }
      .stat-item .label {
        font-size: 0.85rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
    </style>
  </head>
  <body>
    <!-- Üst Menü ve Logo Bileşeni -->
    <Header />

    <!-- Ana İçerik / Hero Alanı -->
    <main>
      <section class="hero-section">
        <div class="hero-content">
          <h1 class="hero-title">
            {getText('home.heroTitle', 'TURSKA PIJACA — Karadağ B2B Toptan Tedarik Portalı')}
          </h1>
          <!-- METINLER sekmesinden dinamik gelen ve istediğin ifadeyle tam uyumlu alt başlık -->
          <p class="hero-subtitle">
            {getText('home.heroSubtitle', 'Türkiye’den Karadağ’a.\nDoğrudan tedarik, güçlü dağıtım.')}
          </p>
        </div>

        <!-- Üçlü Sayaç Kutusu -->
        <div class="stats-box">
          <div class="stat-item">
            <div class="number">{productCount}</div>
            <div class="label">ÜRÜN</div>
          </div>
          <div class="stat-item">
            <div class="number">{categoryCount}</div>
            <div class="label">KATEGORİ</div>
          </div>
          <div class="stat-item">
            <div class="number">{brandCount}</div>
            <div class="label">MARKA</div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
