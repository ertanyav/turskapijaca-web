---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getProducts } from '../../../lib/sheets';

const { lang, id } = Astro.params;
const products = await getProducts();

// Kullanıcının tıkladığı URL'deki id ile Kayıt ID (TP-0001) veya Ürün no (868...) eşleştirilir
const product = products.find(p => String(p.kayitid) === String(id) || String(p.urunno) === String(id) || String(p.kod) === String(id)) || products[0];

if (!product) return Astro.redirect(`/${lang}`);

const title = product[`ad${lang}`] || product.adtr || product.icad || product.kod || 'Ürün Detayı';
const img = product.gorselurl || product.gorsel || 'https://via.placeholder.com/600x500?text=Gorsel+Yok';
const price = product.fiyateur ? `${product.fiyateur}` : 'Toptan Fiyat Sorunuz';
const marka = product.marka || '-';
const kategori = product.kategori || product.altkategori || '-';
const mense = product.mense || '-';
const ambalaj = product.ambalaj || product.ambalajtipi || '-';

const whatsappMsg = encodeURIComponent(`Merhaba, ${title} (Kayıt ID: ${product.kayitid || ''}) ürününüz hakkında bilgi almak istiyorum.`);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | B2B</title>
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; background: #f8fafc; color: #0f172a; }
      .container { max-width: 1100px; margin: 3rem auto; padding: 0 1.5rem; }
      .product-detail { background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; padding: 2.5rem; }
      .detail-img { width: 100%; height: 400px; object-fit: contain; border-radius: 12px; background: #fff; border: 1px solid #f1f5f9; padding: 1rem; }
      .detail-content { display: flex; flex-direction: column; }
      .badge { align-self: flex-start; background: #e2e8f0; color: #0b2218; font-weight: 700; font-size: 0.8rem; padding: 0.3rem 0.8rem; border-radius: 20px; margin-bottom: 1rem; }
      .product-title { font-size: 2rem; color: #0b2218; margin: 0 0 1rem 0; font-weight: 800; }
      .product-price { font-size: 1.5rem; color: #059669; font-weight: 800; margin-bottom: 1.5rem; }
      .specs-list { list-style: none; padding: 0; margin: 0 0 2rem 0; background: #f8fafc; padding: 1rem; border-radius: 8px; border: 1px solid #e2e8f0;}
      .specs-list li { margin-bottom: 0.5rem; font-size: 1.05rem; display: flex; justify-content: space-between;}
      .specs-list strong { color: #475569; }
      .btn-whatsapp { background: #25D366; color: white; text-decoration: none; padding: 1rem; border-radius: 8px; text-align: center; font-weight: 700; transition: background 0.2s; }
      .btn-whatsapp:hover { background: #1da851; }
      @media (max-width: 768px) { .product-detail { grid-template-columns: 1fr; gap: 1.5rem; padding: 1.5rem; } .detail-img { height: 280px; } }
    </style>
  </head>
  <body>
    <Header />
    <main class="container">
      <div class="product-detail">
        <img src={img} alt={title} class="detail-img" />
        <div class="detail-content">
          <span class="badge">Kayıt ID: {product.kayitid || product.urunno || 'TP-00'}</span>
          <h1 class="product-title">{title}</h1>
          <div class="product-price">{price}</div>
          
          <ul class="specs-list">
            <li><strong>Marka:</strong> <span>{marka}</span></li>
            <li><strong>Kategori:</strong> <span>{kategori}</span></li>
            <li><strong>Ambalaj:</strong> <span>{ambalaj}</span></li>
            <li><strong>Menşe:</strong> <span>{mense}</span></li>
            {product.icad && <li><strong>İçerik/Açıklama:</strong> <span>{product.icad}</span></li>}
          </ul>

          <a href={`https://wa.me/905000000000?text=${whatsappMsg}`} target="_blank" class="btn-whatsapp">
            💬 WhatsApp ile Tedarik Talebi
          </a>
        </div>
      </div>
    </main>
    <Footer lang={lang} />
  </body>
</html>
