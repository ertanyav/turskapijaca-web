---
import { getMenu, getLogoUrl, getTextDictionary } from '../lib/sheets';

const { pathname = '' } = Astro.url;
const segments = pathname.split('/').filter(Boolean);
const currentLang = ['tr', 'en', 'me'].includes(segments[0]) ? segments[0] : 'tr';

let menuItems = [];
let logoUrl = '';
let dict = {};

try {
  [menuItems, logoUrl, dict] = await Promise.all([
    getMenu(),
    getLogoUrl(),
    getTextDictionary(currentLang)
  ]);
} catch (error) {
  console.error('Header verileri yüklenemedi:', error);
}

const languages = [
  { code: 'tr', label: 'TR' },
  { code: 'en', label: 'EN' },
  { code: 'me', label: 'ME' }
];

function getLangPath(targetCode) {
  if (segments.length === 0) return `/${targetCode}`;

  const newSegments = [...segments];

  if (['tr', 'en', 'me'].includes(newSegments[0])) {
    newSegments[0] = targetCode;
  } else {
    newSegments.unshift(targetCode);
  }

  return '/' + newSegments.join('/');
}

const txtCart =
  dict['common.cart'] ||
  dict['ortak.sepet'] ||
  (currentLang === 'en'
    ? 'Cart'
    : currentLang === 'me'
      ? 'Korpa'
      : 'Sepet');

const txtCheckout =
  dict['cart.checkout'] ||
  (currentLang === 'en'
    ? 'Complete Order'
    : currentLang === 'me'
      ? 'Naruči'
      : 'Siparişi Tamamla');

const txtEmpty =
  dict['cart.empty'] ||
  (currentLang === 'en'
    ? 'Cart is empty'
    : currentLang === 'me'
      ? 'Korpa je prazna'
      : 'Sepetiniz boş.');

const txtCode =
  dict['product.code'] ||
  (currentLang === 'en'
    ? 'Code'
    : currentLang === 'me'
      ? 'Šifra'
      : 'Kod');

const txtMenu =
  currentLang === 'en'
    ? 'Menu'
    : currentLang === 'me'
      ? 'Meni'
      : 'Menü';

const phone = dict['contact.phone'] || '38263256666';
const cleanPhone = String(phone).replace(/[^0-9]/g, '');
---

<header class="main-header">
  <div class="header-container">
    <a href={`/${currentLang}`} class="logo-link" aria-label="TURSKA PIJACA">
      {logoUrl && (
        <img
          src={logoUrl}
          alt="TURSKA PIJACA"
          class="site-logo"
          width="180"
          height="48"
        />
      )}
    </a>

    <button
      id="mobile-menu-toggle"
      class="mobile-menu-toggle"
      type="button"
      aria-label={txtMenu}
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav id="main-navigation" class="main-menu" aria-label={txtMenu}>
      <ul>
        {menuItems.map(item => {
          const name = item[`ad${currentLang}`] || item.adtr;
          const rawAddress = item[`adres${currentLang}`] || item.adrestr;

          if (!name || item.kod === 'home' || !rawAddress) return null;

          const cleanAddress = String(rawAddress)
            .replace(/^\/+/, '')
            .replace(/\/+$/, '');

          const finalPath = `/${currentLang}/${cleanAddress}`.toLowerCase();
          const hasChildren = item.children && item.children.length > 0;

          return (
            <li class={`menu-item ${hasChildren ? 'has-dropdown' : ''}`}>
              <a href={finalPath} class="menu-link">
                {name}
                {hasChildren && (
                  <span class="arrow" aria-hidden="true">▾</span>
                )}
              </a>

              {hasChildren && (
                <ul class="dropdown-menu">
                  {item.children.map(child => {
                    const childName =
                      child[`ad${currentLang}`] || child.adtr;
                    const childAddr =
                      child[`adres${currentLang}`] || child.adrestr;

                    if (!childName || !childAddr) return null;

                    const childPath = `/${currentLang}/${String(childAddr)
                      .replace(/^\/+/, '')
                      .replace(/\/+$/, '')}`.toLowerCase();

                    return (
                      <li>
                        <a href={childPath}>{childName}</a>
                      </li>
                    );
                  })}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-right">
      <button
        id="cart-toggle"
        class="cart-btn"
        type="button"
        aria-label={txtCart}
        aria-expanded="false"
        aria-controls="cart-sidebar"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>

        <span class="cart-count-badge" id="cart-count" aria-live="polite">
          0
        </span>
      </button>

      <div class="language-switcher" aria-label="Language selection">
        {languages.map(language => (
          <a
            href={getLangPath(language.code)}
            class={currentLang === language.code ? 'active' : ''}
            aria-current={
              currentLang === language.code ? 'page' : undefined
            }
          >
            {language.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<div id="mobile-menu-overlay" class="mobile-menu-overlay"></div>

<aside
  id="cart-sidebar"
  class="cart-sidebar"
  aria-hidden="true"
  aria-label={txtCart}
>
  <div class="cart-header">
    <h2>{txtCart}</h2>

    <button
      id="cart-close"
      class="cart-close"
      type="button"
      aria-label={
        currentLang === 'en'
          ? 'Close cart'
          : currentLang === 'me'
            ? 'Zatvori korpu'
            : 'Sepeti kapat'
      }
    >
      ×
    </button>
  </div>

  <div id="cart-items" class="cart-items"></div>

  <div class="cart-footer">
    <button
      id="checkout-btn"
      class="checkout-btn"
      type="button"
      data-phone={cleanPhone}
    >
      {txtCheckout}
    </button>
  </div>
</aside>

<div id="cart-overlay" class="cart-overlay"></div>

<script define:vars={{ txtEmpty, txtCode }}>
  const CART_STORAGE_KEY = 'tp_cart';
  const FALLBACK_IMAGE = 'https://via.placeholder.com/70';

  let cart = [];

  function readCart() {
    try {
      const storedCart = JSON.parse(
        localStorage.getItem(CART_STORAGE_KEY) || '[]'
      );

      if (!Array.isArray(storedCart)) return [];

      return storedCart
        .filter(item => item && item.id)
        .map(item => ({
          id: String(item.id),
          name: String(item.name || ''),
          img: String(item.img || ''),
          qty: Math.max(1, Number(item.qty) || 1)
        }));
    } catch (error) {
      console.error('Sepet okunamadı:', error);
      return [];
    }
  }

  function saveCart() {
    localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
  }

  function getCartQuantity() {
    return cart.reduce((total, item) => total + item.qty, 0);
  }

  function updateCartCount() {
    const countElement = document.getElementById('cart-count');

    if (!countElement) return;

    const quantity = getCartQuantity();

    countElement.textContent = String(quantity);
    countElement.hidden = quantity === 0;
  }

  function createElement(tagName, className, text = '') {
    const element = document.createElement(tagName);

    if (className) {
      element.className = className;
    }

    if (text) {
      element.textContent = text;
    }

    return element;
  }

  function renderCart() {
    const itemsContainer = document.getElementById('cart-items');

    updateCartCount();

    if (!itemsContainer) return;

    itemsContainer.replaceChildren();

    if (cart.length === 0) {
      const emptyMessage = createElement('p', 'cart-empty', txtEmpty);
      itemsContainer.appendChild(emptyMessage);
      return;
    }

    cart.forEach((item, index) => {
      const cartItem = createElement('div', 'cart-item');

      const image = document.createElement('img');
      image.src = item.img || FALLBACK_IMAGE;
      image.alt = item.name;
      image.width = 70;
      image.height = 70;
      image.loading = 'lazy';
      image.referrerPolicy = 'no-referrer';

      image.addEventListener(
        'error',
        () => {
          image.src = FALLBACK_IMAGE;
        },
        { once: true }
      );

      const itemInfo = createElement('div', 'cart-item-info');
      const itemName = createElement('div', 'cart-item-name', item.name);

      const itemCode = createElement(
        'div',
        'cart-item-code',
        `${txtCode}: ${item.id}`
      );

      const quantityControls = createElement('div', 'cart-item-qty');

      const decreaseButton = createElement('button', 'qty-button', '−');
      decreaseButton.type = 'button';
      decreaseButton.dataset.index = String(index);
      decreaseButton.dataset.change = '-1';
      decreaseButton.setAttribute('aria-label', 'Decrease quantity');

      const quantity = createElement(
        'span',
        'cart-item-quantity',
        String(item.qty)
      );

      const increaseButton = createElement('button', 'qty-button', '+');
      increaseButton.type = 'button';
      increaseButton.dataset.index = String(index);
      increaseButton.dataset.change = '1';
      increaseButton.setAttribute('aria-label', 'Increase quantity');

      quantityControls.append(
        decreaseButton,
        quantity,
        increaseButton
      );

      itemInfo.append(itemName, itemCode, quantityControls);
      cartItem.append(image, itemInfo);
      itemsContainer.appendChild(cartItem);
    });
  }

  function updateQuantity(index, change) {
    const item = cart[index];

    if (!item) return;

    item.qty += change;

    if (item.qty <= 0) {
      cart.splice(index, 1);
    }

    saveCart();
    renderCart();
    window.dispatchEvent(new Event('cartUpdated'));
  }

  function openCart() {
    const sidebar = document.getElementById('cart-sidebar');
    const overlay = document.getElementById('cart-overlay');
    const toggleButton = document.getElementById('cart-toggle');

    sidebar?.classList.add('open');
    sidebar?.setAttribute('aria-hidden', 'false');
    overlay?.classList.add('open');
    toggleButton?.setAttribute('aria-expanded', 'true');

    renderCart();
  }

  function closeCart() {
    const sidebar = document.getElementById('cart-sidebar');
    const overlay = document.getElementById('cart-overlay');
    const toggleButton = document.getElementById('cart-toggle');

    sidebar?.classList.remove('open');
    sidebar?.setAttribute('aria-hidden', 'true');
    overlay?.classList.remove('open');
    toggleButton?.setAttribute('aria-expanded', 'false');
  }

  function toggleCart() {
    const sidebar = document.getElementById('cart-sidebar');

    if (sidebar?.classList.contains('open')) {
      closeCart();
    } else {
      openCart();
    }
  }

  function addToCart(id, name, img = '') {
    if (!id || !name) return;

    const productId = String(id);
    const productName = String(name);
    const productImage = String(img || '');

    const existingItem = cart.find(item => item.id === productId);

    if (existingItem) {
      existingItem.qty += 1;

      if (!existingItem.img && productImage) {
        existingItem.img = productImage;
      }
    } else {
      cart.push({
        id: productId,
        name: productName,
        img: productImage,
        qty: 1
      });
    }

    saveCart();
    renderCart();
    window.dispatchEvent(new Event('cartUpdated'));
    openCart();
  }

  function toggleMobileMenu() {
    const navigation = document.getElementById('main-navigation');
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const overlay = document.getElementById('mobile-menu-overlay');

    const isOpen = navigation?.classList.toggle('mobile-open');

    toggleButton?.classList.toggle('is-open', Boolean(isOpen));
    toggleButton?.setAttribute(
      'aria-expanded',
      String(Boolean(isOpen))
    );
    overlay?.classList.toggle('open', Boolean(isOpen));
    document.body.classList.toggle('menu-open', Boolean(isOpen));
  }

  function closeMobileMenu() {
    const navigation = document.getElementById('main-navigation');
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const overlay = document.getElementById('mobile-menu-overlay');

    navigation?.classList.remove('mobile-open');
    toggleButton?.classList.remove('is-open');
    toggleButton?.setAttribute('aria-expanded', 'false');
    overlay?.classList.remove('open');
    document.body.classList.remove('menu-open');
  }

  cart = readCart();

  document
    .getElementById('cart-toggle')
    ?.addEventListener('click', toggleCart);

  document
    .getElementById('cart-close')
    ?.addEventListener('click', closeCart);

  document
    .getElementById('cart-overlay')
    ?.addEventListener('click', closeCart);

  document
    .getElementById('mobile-menu-toggle')
    ?.addEventListener('click', toggleMobileMenu);

  document
    .getElementById('mobile-menu-overlay')
    ?.addEventListener('click', closeMobileMenu);

  document
    .getElementById('cart-items')
    ?.addEventListener('click', event => {
      const button = event.target.closest('.qty-button');

      if (!button) return;

      const index = Number(button.dataset.index);
      const change = Number(button.dataset.change);

      if (!Number.isInteger(index) || !Number.isFinite(change)) {
        return;
      }

      updateQuantity(index, change);
    });

  document
    .getElementById('checkout-btn')
    ?.addEventListener('click', event => {
      if (cart.length === 0) return;

      const button = event.currentTarget;
      const phone = button?.getAttribute('data-phone') || '';

      const lines = cart.map(
        item => `- ${item.name} (${txtCode}: ${item.id}) x ${item.qty}`
      );

      const message = [
        'Merhaba, aşağıdaki ürünler için toptan sipariş/teklif talep ediyorum:',
        '',
        ...lines
      ].join('\n');

      window.open(
        `https://wa.me/${phone}?text=${encodeURIComponent(message)}`,
        '_blank',
        'noopener,noreferrer'
      );
    });

  window.addToCart = addToCart;

  renderCart();
</script>

<style>
  .main-header {
    background: #fff;
    border-bottom: 1px solid #e2e8f0;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.05);
  }

  .header-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0.8rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-logo {
    width: 180px;
    height: 48px;
    object-fit: contain;
  }

  .main-menu {
    flex: 1;
  }

  .main-menu > ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: center;
  }

  .menu-item {
    position: relative;
  }

  .menu-link {
    text-decoration: none;
    color: #0f172a;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 1.5rem 0;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
  }

  .menu-link:hover {
    color: #059669;
  }

  .arrow {
    font-size: 0.75rem;
  }

  .dropdown-menu {
    visibility: hidden;
    opacity: 0;
    position: absolute;
    top: 100%;
    left: 0;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0.5rem 0;
    min-width: 240px;
    display: flex;
    flex-direction: column;
    z-index: 10;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
    transform: translateY(10px);
    list-style: none;
    margin: 0;
  }

  .has-dropdown:hover .dropdown-menu {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  .dropdown-menu a {
    padding: 0.8rem 1.2rem;
    display: block;
    text-decoration: none;
    color: #475569;
    font-size: 0.95rem;
    font-weight: 500;
    border-bottom: 1px solid #f1f5f9;
  }

  .dropdown-menu a:hover {
    background: #f8fafc;
    color: #059669;
  }

  .header-right {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-shrink: 0;
  }

  .cart-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: #0f172a;
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.5rem;
  }

  .cart-count-badge {
    position: absolute;
    top: -5px;
    right: -8px;
    background: #059669;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-count-badge[hidden] {
    display: none;
  }

  .language-switcher {
    display: flex;
    gap: 0.3rem;
  }

  .language-switcher a {
    color: #64748b;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    padding: 0.3rem 0.5rem;
    border-radius: 4px;
  }

  .language-switcher a.active {
    color: #059669;
    background: #f1f5f9;
  }

  .mobile-menu-toggle {
    display: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0.5rem;
    flex-direction: column;
    gap: 5px;
  }

  .mobile-menu-toggle span {
    display: block;
    width: 25px;
    height: 3px;
    background: #0f172a;
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  .mobile-menu-overlay {
    display: none;
  }

  .cart-sidebar {
    position: fixed;
    top: 0;
    right: -450px;
    width: 100%;
    max-width: 400px;
    height: 100vh;
    background: #fff;
    box-shadow: -5px 0 30px rgba(0, 0, 0, 0.15);
    z-index: 10001;
    transition: right 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .cart-sidebar.open {
    right: 0;
  }

  .cart-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(0, 0, 0, 0.5);
    z-index: 10000;
    display: none;
  }

  .cart-overlay.open {
    display: block;
  }

  .cart-header {
    padding: 1.5rem;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cart-header h2 {
    margin: 0;
    font-size: 1.3rem;
    color: #0f172a;
  }

  .cart-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: #64748b;
  }

  .cart-items {
    flex-grow: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .cart-empty {
    text-align: center;
    color: #64748b;
    margin-top: 2rem;
  }

  .cart-item {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 1.5rem;
  }

  .cart-item img {
    width: 70px;
    height: 70px;
    object-fit: contain;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 4px;
  }

  .cart-item-info {
    flex-grow: 1;
  }

  .cart-item-name {
    font-weight: 700;
    color: #0f172a;
    font-size: 0.95rem;
    margin-bottom: 0.2rem;
    line-height: 1.4;
  }

  .cart-item-code {
    font-size: 0.8rem;
    color: #64748b;
    margin-bottom: 0.5rem;
  }

  .cart-item-qty {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .qty-button {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    width: 30px;
    height: 30px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
  }

  .cart-item-quantity {
    min-width: 1.5rem;
    text-align: center;
  }

  .cart-footer {
    padding: 1.5rem;
    border-top: 1px solid #e2e8f0;
    background: #f8fafc;
  }

  .checkout-btn {
    width: 100%;
    background: #25d366;
    color: #fff;
    border: none;
    padding: 1.2rem;
    font-size: 1.05rem;
    font-weight: 800;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }

  .checkout-btn:hover {
    background: #1ebd5a;
  }

  @media (max-width: 900px) {
    .header-container {
      padding: 0.7rem 1rem;
    }

    .site-logo {
      width: 150px;
      height: 42px;
    }

    .main-menu > ul {
      gap: 1rem;
    }

    .menu-link {
      font-size: 0.85rem;
    }

    .header-right {
      gap: 0.7rem;
    }
  }

  @media (max-width: 700px) {
    .header-container {
      justify-content: space-between;
    }

    .mobile-menu-toggle {
      display: flex;
      order: 2;
    }

    .header-right {
      order: 3;
    }

    .main-menu {
      position: fixed;
      top: 0;
      left: -320px;
      width: 300px;
      height: 100vh;
      background: #fff;
      z-index: 10002;
      padding: 5rem 1.25rem 1.5rem;
      overflow-y: auto;
      transition: left 0.3s ease;
      box-shadow: 5px 0 25px rgba(0, 0, 0, 0.15);
    }

    .main-menu.mobile-open {
      left: 0;
    }

    .main-menu > ul {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .menu-link {
      padding: 1rem 0;
      border-bottom: 1px solid #e2e8f0;
    }

    .dropdown-menu {
      position: static;
      visibility: visible;
      opacity: 1;
      transform: none;
      display: none;
      border: 0;
      box-shadow: none;
      padding: 0 0 0 1rem;
      min-width: auto;
    }

    .has-dropdown:hover .dropdown-menu {
      display: flex;
    }

    .dropdown-menu a {
      border-bottom: 0;
      padding: 0.7rem 0;
    }

    .mobile-menu-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      z-index: 10001;
    }

    .mobile-menu-overlay.open {
      display: block;
    }

    body.menu-open {
      overflow: hidden;
    }

    .mobile-menu-toggle.is-open span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }

    .mobile-menu-toggle.is-open span:nth-child(2) {
      opacity: 0;
