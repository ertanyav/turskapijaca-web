---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPages, getTexts, getProducts, getCategories, getBrands, getDealers, getDocuments, getTextDictionary } from '../../lib/sheets';

const { lang = 'tr', slug } = Astro.params;
const target = (slug || '').toLowerCase();

const [pages, texts, products, categories, brands, dealers, documents, dict] = await Promise.all([
  getPages(), getTexts(), getProducts(), getCategories(), getBrands(), getDealers(), getDocuments(), getTextDictionary(lang)
]);

const currentPage = pages.find(p => {
  if (!p) return false;
  return target === String(p.adrestr || '').replace(/^\//, '').toLowerCase() || 
         target === String(p.adresen || '').replace(/^\//, '').toLowerCase() || 
         target === (p.kod || '').toLowerCase();
});

const matchedCategory = categories.find(c => target === String(c.adrestr || '').replace(/^\//, '').toLowerCase());
const isProductPage = (currentPage && (currentPage.kod === 'products' || currentPage.kod === 'catalog' || target.includes('urunler'))) || matchedCategory;

const isBrandsPage = currentPage && currentPage.kod === 'brands';
const isDealersPage = currentPage && currentPage.kod === 'network';
const isDocsPage = currentPage && currentPage.kod === 'documents';

// GET Parametresi kontrolü (Astro'da request.url kullanılır)
const currentUrl = new URL(Astro.request.url);
const brandFilter = currentUrl.searchParams.get('marka');

let displayedProducts = products || [];
if (matchedCategory) displayedProducts = displayedProducts.filter(p => (p.kategori || '').toUpperCase() === (matchedCategory.kod || '').toUpperCase());
if (brandFilter) displayedProducts = displayedProducts.filter(p => (p.marka || '').toLowerCase() === brandFilter.toLowerCase());

let pageTitle = currentPage ? (currentPage[`ad${lang}`] || currentPage.adtr) : (matchedCategory ? matchedCategory[`ad${lang}`] || matchedCategory.adtr : 'Sayfa');
let pageParagraphs = [];

if (texts && currentPage) {
  const langCol = lang === 'en' ? 'english' : lang === 'me' ? 'crnogorski' : 'turkce';
  const pagePrefix = `${(currentPage.kod || '').toLowerCase()}.`;
  texts.forEach(t => {
    const key = (t.anahtar || '').toLowerCase();
    if (key.startsWith(pagePrefix) && !key.endsWith('.title') && (t[langCol] || t.turkce)) {
      pageParagraphs.push(t[langCol] || t.turkce);
    }
  });
}
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <style>
      body { margin: 0; font-family: system-ui; background: #f8fafc; color: #0f172a; }
      .container { max-width: 1250px; margin: 2rem auto; padding: 0 1.5rem; min-height: 60vh; }
      .content-card { background: white; padding: 2rem; border-radius: 12px; border: 1px solid #e2e8f0; }
      
      /* Katalog & Mobile First */
      .catalog-layout { display: grid; grid-template-columns: 240px 1fr; gap: 2rem; margin-top: 1.5rem; }
      .filter-sidebar { background: #fff; padding: 1.5rem; border-radius: 12px; border: 1px solid #e2e8f0; }
      .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
      .product-card { background: white; border-radius: 10px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; overflow: hidden; }
      .product-img { width: 100%; height: 180px; object-fit: contain; padding: 10px; border-bottom: 1px solid #f1f5f9; }
      .product-info { padding: 1rem; display: flex; flex-direction: column; flex-grow: 1; }
      .btn-detail { margin-top: auto; text-align: center; background: #0b2218; color: white; padding: 0.6rem; border-radius: 6px; text-decoration: none; font-size: 0.85rem; font-weight: 600; }
      
      /* Markalar ve Bayiler Grid */
      .entities-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
      .entity-card { background: white; border: 1px solid #e2e8f0; padding: 1.5rem; border-radius: 10px; display: flex; flex-direction: column; text-decoration: none; color: inherit; transition: border-color 0.2s;}
      .entity-card:hover { border-color: #34d399; }
      .entity-img { width: 100%; height: 80px; object-fit: contain; margin-bottom: 1rem;}
      
      /* Dokümanlar */
      .doc-card { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 1rem 1.5rem; border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 1rem;}
      .doc-btn { background: #c5a059; color: white; padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: bold; }

      @media (max-width: 768px) { 
        .catalog-layout { grid-template-columns: 1fr; } 
        .filter-sidebar { display: none; } /* Mobilde filtre gizlenebilir veya popup yapılabilir */
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="container">
      <h1>{pageTitle}</h1>

      {isProductPage ? (
        <div class="catalog-layout">
          <aside class="filter-sidebar">
            <h4 style="margin-top:0;">{dict['common.categories'] || 'Kategoriler'}</h4>
            <ul style="list-style:none; padding:0;">
              <li><a href={`/${lang}/ürünler/tüm-ürünler`} style="color:#475569; text-decoration:none;">Tüm Ürünler</a></li>
              {categories.map(c => <li style="margin-top:0.5rem;"><a href={`/${lang}/${(c.adrestr || '').replace(/^\//, '')}`.toLowerCase()} style="color:#475569; text-decoration:none;">{c[`ad${lang}`] || c.adtr}</a></li>)}
            </ul>
          </aside>
          <section class="products-grid">
            {displayedProducts.map(p => {
              const pId = p.urunno || p.kayitid || p.id;
              return (
                <div class="product-card">
                  <img src={p.gorselurl || 'https://via.placeholder.com/300'} class="product-img" loading="lazy" />
                  <div class="product-info">
                    <h3 style="margin:0 0 0.4rem; font-size:0.95rem;">{p[`ad${lang}`] || p.adtr}</h3>
                    <div style="font-size: 0.8rem; color: #64748b; margin-bottom: 1rem;">{p.marka || '-'}</div>
                    <a href={`/${lang}/products/${pId}`} class="btn-detail">{dict['product.detail'] || 'İncele'}</a>
                  </div>
                </div>
              );
            })}
          </section>
        </div>
      ) : (
        <div class="content-card">
          {pageParagraphs.map(txt => <p style="line-height:1.8; color:#334155;">{txt}</p>)}
          
          {/* MARKALAR: Distribütör ve Portföy Ayrımı */}
          {isBrandsPage && brands && (
            <>
              <h2 style="margin-top:2rem;">Distribütörlüğünü Yaptığımız Markalar</h2>
              <div class="entities-grid">
                {brands.filter(b => b.tur.includes('DISTRIBUTOR')).map(b => (
                  <a href={`/${lang}/ürünler/tüm-ürünler?marka=${b.marka}`} class="entity-card">
                    {b.gorselurl ? <img src={b.gorselurl} class="entity-img" /> : <h3>{b.marka}</h3>}
                    <div style="font-size: 0.85rem; color: #64748b;">{b[`aciklama${lang}`] || b.aciklamatr || 'Ürünleri incelemek için tıklayın'}</div>
                  </a>
                ))}
              </div>
              <h2 style="margin-top:3rem;">Satış Portföyümüzdeki Markalar</h2>
              <div class="entities-grid">
                {brands.filter(b => b.tur.includes('PORTFOLIO') || !b.tur.includes('DISTRIBUTOR')).map(b => (
                  <a href={`/${lang}/ürünler/tüm-ürünler?marka=${b.marka}`} class="entity-card">
                    {b.gorselurl ? <img src={b.gorselurl} class="entity-img" /> : <h3>{b.marka}</h3>}
                  </a>
                ))}
              </div>
            </>
          )}

          {/* BAYİLER VE DEPOLAR */}
          {isDealersPage && dealers && (
            <>
              <h2 style="margin-top:2rem;">Yetkili Satış Noktaları</h2>
              <div class="entities-grid">
                {dealers.filter(d => d.tur.includes('DEALER')).map(d => (
                  <div class="entity-card">
                    <h3 style="margin: 0;">{d.ad}</h3>
                    <div style="font-weight:bold; color:#0b2218; margin:0.5rem 0;">{d.sehir}</div>
                    {d.adres && <div style="font-size: 0.9rem;">📍 {d.adres}</div>}
                    {d.telefon && <div style="font-size: 0.9rem;">📞 {d.telefon}</div>}
                  </div>
                ))}
              </div>
              <h2 style="margin-top:3rem;">Depolarımız</h2>
              <div class="entities-grid">
                {dealers.filter(d => d.tur.includes('WAREHOUSE')).map(d => (
                  <div class="entity-card" style="background:#f1f5f9;">
                    <h3 style="margin: 0;">{d.ad}</h3>
                    <div style="font-weight:bold; color:#c5a059; margin:0.5rem 0;">{d.sehir}</div>
                    {d.adres && <div style="font-size: 0.9rem;">📍 {d.adres}</div>}
                  </div>
                ))}
              </div>
            </>
          )}

          {/* DOKÜMANLAR */}
          {isDocsPage && documents && (
            <div style="margin-top:2rem;">
              {documents.map(doc => (
                <div class="doc-card">
                  <div>
                    <h3 style="margin:0 0 0.3rem;">{doc[`ad${lang}`] || doc.adtr}</h3>
                    <div style="font-size:0.9rem; color:#64748b;">{doc[`aciklama${lang}`] || doc.aciklamatr}</div>
                  </div>
                  <a href={`https://drive.google.com/file/d/${doc.driveid}/view`} target="_blank" class="doc-btn">Görüntüle</a>
                </div>
              ))}
            </div>
          )}

        </div>
      )}
    </main>
    <Footer lang={lang} />
  </body>
</html>
