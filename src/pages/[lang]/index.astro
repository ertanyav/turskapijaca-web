---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getProducts, getTexts } from '../../lib/sheets';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'me' } },
    { params: { lang: 'tr' } }
  ];
}

const { lang } = Astro.params;
const [products, texts] = await Promise.all([getProducts(), getTexts()]);

// Metinleri Master tablodan çekiyoruz
const pageTitle = texts['home_h1']?.[lang] || 'TURSKA PIJACA';
const companySub = texts['company_sub']?.[lang] || '';
const searchPlaceholder = texts['search_placeholder']?.[lang] || 'Search...';
const resetText = texts['btn_reset']?.[lang] || 'Reset';

const uniqueCategories = [...new Set(products.map(p => p['Kategori']).filter(Boolean))];
const uniqueBrands = [...new Set(products.map(p => p['Marka']).filter(Boolean))];
---

<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <title>{pageTitle}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- SEO Hreflang -->
  <link rel="alternate" hreflang="en" href="https://www.turskapijaca.com/" />
  <link rel="alternate" hreflang="me" href="https://www.turskapijaca.me/" />
  <link rel="alternate" hreflang="tr" href="https://www.turskapijaca.com.tr/" />
</head>
<body style="margin: 0; font-family: system-ui, -apple-system, sans-serif; background: #111827; color: #f8fafc;">
  <Header lang={lang} texts={texts} />

  <!-- Hero Banner (Soft Dark) -->
  <section style="background: #1f2937; padding: 3rem 1.5rem; border-bottom: 1px solid #374151;">
    <div style="max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center;">
      <div>
        <div style="display: flex; gap: 0.6rem; margin-bottom: 1rem; flex-wrap: wrap;">
          <span style="background: rgba(5,150,105,0.2); color: #10b981; border: 1px solid #059669; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.75rem; font-weight: bold; text-transform: uppercase;">Direct From Factory</span>
          <span style="background: rgba(59,130,246,0.2); color: #60a5fa; border: 1px solid #3b82f6; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.75rem; font-weight: bold; text-transform: uppercase;">UNIVERCERT MNE D.O.O.</span>
        </div>
        <h1 style="font-size: 2.4rem; margin: 0 0 0.8rem 0; font-weight: 800; line-height: 1.2; color: #f8fafc;">
          {pageTitle}
        </h1>
        <p style="color: #9ca3af; font-size: 1.1rem; margin: 0; max-width: 800px; line-height: 1.6;">
          {companySub}
        </p>
      </div>

      <!-- Quick Stats -->
      <div style="background: #111827; border: 1px solid #374151; padding: 1.5rem 2rem; border-radius: 12px; text-align: center;">
        <span style="font-size: 2.2rem; font-weight: 900; color: #10b981; display: block;">{products.length}</span>
        <span style="font-size: 0.85rem; color: #9ca3af; font-weight: 600; text-transform: uppercase;">Active Products</span>
      </div>
    </div>
  </section>

  <!-- Interactive Search & Catalog -->
  <main style="max-width: 1280px; margin: 2rem auto; padding: 0 1.5rem;">
    
    <!-- Search Bar -->
    <div style="background: #1f2937; padding: 1rem 1.5rem; border-radius: 12px; margin-bottom: 2rem; border: 1px solid #374151; display: flex; gap: 1rem; align-items: center;">
      <input type="text" id="searchInput" placeholder={searchPlaceholder} style="flex: 1; padding: 0.8rem 1.2rem; border-radius: 8px; border: 1px solid #4b5563; background: #111827; color: white; font-size: 1rem; outline: none;" />
      <button id="resetBtn" style="background: #374151; color: white; border: none; padding: 0.8rem 1.5rem; border-radius: 8px; font-weight: bold; cursor: pointer; transition: background 0.2s;">
        {resetText}
      </button>
    </div>

    <div style="display: grid; grid-template-columns: 260px 1fr; gap: 2rem;">
      <!-- Left Filters -->
      <aside style="background: #1f2937; border-radius: 12px; padding: 1.5rem; border: 1px solid #374151; height: fit-content;">
        <div style="margin-bottom: 2rem;">
          <h3 style="font-size: 0.85rem; text-transform: uppercase; color: #9ca3af; font-weight: 800; margin: 0 0 1rem 0; border-bottom: 1px solid #374151; padding-bottom: 0.5rem;">Categories</h3>
          <div style="display: flex; flex-direction: column; gap: 0.4rem;">
            <button class="cat-btn active" data-cat="ALL" style="text-align: left; padding: 0.6rem 0.8rem; border-radius: 6px; border: none; background: #059669; color: white; font-weight: bold; cursor: pointer;">All ({products.length})</button>
            {uniqueCategories.map(cat => (
              <button class="cat-btn" data-cat={cat} style="text-align: left; padding: 0.5rem 0.8rem; border-radius: 6px; border: none; background: transparent; color: #d1d5db; font-weight: 500; cursor: pointer;">{cat}</button>
            ))}
          </div>
        </div>
      </aside>

      <!-- Products Grid -->
      <section>
        <div id="productsGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem;">
          {products.map(p => {
            const title = p[`Ad ${lang.toUpperCase()}`] || p['Ad EN'] || p['İç ad'] || 'Product';
            const code = p['Ürün no'] || p['Kayıt ID'] || '';
            const brand = p['Marka'] || '';
            const cat = p['Kategori'] || '';
            const pack = p['Ambalaj'] || '';
            const image = p['Görsel URL'] && p['Görsel URL'].startsWith('http') ? p['Görsel URL'] : 'https://via.placeholder.com/300x300/1f2937/4ade80?text=TP';

            let rawPrice = p['Fiyat EUR'] ? String(p['Fiyat EUR']).trim() : '';
            rawPrice = rawPrice.replace(/TRY|TL|EUR|€|\$/gi, '').trim();
            const price = (rawPrice && rawPrice !== '0' && rawPrice !== '0,00') ? `€${rawPrice}` : 'Quote';

            return (
              <div class="product-card" data-title={title.toLowerCase()} data-code={code.toLowerCase()} data-cat={cat} style="background: #1f2937; border-radius: 12px; border: 1px solid #374151; padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s, box-shadow 0.2s;">
                <div>
                  <div style="height: 180px; background: white; border-radius: 8px; padding: 0.5rem; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; position: relative;">
                    <img src={image} alt={title} loading="lazy" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
                    <span style="position: absolute; top: 8px; left: 8px; background: #0f172a; color: white; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.7rem; font-weight: bold;">{brand}</span>
                  </div>
                  
                  <span style="font-size: 0.75rem; color: #10b981; font-weight: 800; text-transform: uppercase;">{cat}</span>
                  <h3 style="font-size: 1rem; margin: 0.3rem 0 0.5rem 0; color: #f8fafc; line-height: 1.35; font-weight: 700;">
                    <!-- AYNI PENCEREDE AÇILIR -->
                    <a href={`/${lang}/products/${code}`} target="_self" style="color: inherit; text-decoration: none;">{title}</a>
                  </h3>
                  <p style="font-size: 0.8rem; color: #9ca3af; margin: 0 0 1rem 0;">Code: {code} {pack && `• ${pack}`}</p>
                </div>

                <div style="border-top: 1px solid #374151; padding-top: 1rem; display: flex; justify-content: space-between; align-items: center;">
                  <div>
                    <span style="font-size: 0.7rem; color: #6b7280; display: block; font-weight: bold;">B2B PRICE</span>
                    <span style="font-size: 1.25rem; font-weight: 900; color: #10b981;">{price}</span>
                  </div>
                  <a href={`https://wa.me/38263256666?text=B2B%20Siparis:%20${encodeURIComponent(title)}%20(${code})`} target="_blank" style="background: #059669; color: white; padding: 0.5rem 0.8rem; border-radius: 6px; text-decoration: none; font-size: 0.85rem; font-weight: bold;">
                    Order
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    </div>
  </main>
  
  <Footer lang={lang} texts={texts} />

  <script>
    // Filtreleme scripti aynı kalıyor (önceki koddan devralındı)
    let selectedCat = 'ALL';
    let searchQuery = '';
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const resetBtn = document.getElementById('resetBtn');
    const cards = document.querySelectorAll('.product-card');

    function filterProducts() {
      cards.forEach((card: any) => {
        const title = card.dataset.title;
        const code = card.dataset.code;
        const cat = card.dataset.cat;
        const matchSearch = !searchQuery || title.includes(searchQuery) || code.includes(searchQuery);
        const matchCat = selectedCat === 'ALL' || cat === selectedCat;
        card.style.display = matchSearch && matchCat ? 'flex' : 'none';
      });
    }

    searchInput?.addEventListener('input', (e: any) => {
      searchQuery = e.target.value.toLowerCase().trim();
      filterProducts();
    });

    document.querySelectorAll('.cat-btn').forEach(btn => {
      btn.addEventListener('click', (e: any) => {
        document.querySelectorAll('.cat-btn').forEach(b => (b as HTMLElement).style.background = 'transparent');
        e.currentTarget.style.background = '#059669';
        selectedCat = e.currentTarget.dataset.cat;
        filterProducts();
      });
    });

    resetBtn?.addEventListener('click', () => {
      selectedCat = 'ALL';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      filterProducts();
    });
  </script>
</body>
</html>
