---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPages, getTexts } from '../../lib/sheets';

const { lang, slug } = Astro.params;
const validLangs = ['tr', 'en', 'me'];
if (!validLangs.includes(lang)) return Astro.redirect('/tr');

const [pages, texts] = await Promise.all([ getPages(), getTexts() ]);

// Tıklanan URL'deki adresi adrestr, adresen, adresme sütunlarıyla tam eşleme
const currentPage = pages.find(p => {
  const target = (slug || '').toLowerCase();
  const aTR = String(p.adrestr || '').replace(/^\//, '').toLowerCase();
  const aEN = String(p.adresen || '').replace(/^\//, '').toLowerCase();
  const aME = String(p.adresme || '').replace(/^\//, '').toLowerCase();
  const kod = String(p.kod || '').toLowerCase();
  
  return target === aTR || target === aEN || target === aME || target === kod;
});

if (!currentPage) return Astro.redirect(`/${lang}`);

// Seçilen dil başlığını alır
const pageTitle = currentPage[`ad${lang}`] || currentPage['adtr'] || currentPage.kod;

// METINLER sekmesinden turkce, english, crnogorski sütunlarına bakarak içeriği çeker
let pageContent = '';
if (texts && texts.length > 0) {
  const langColMap = { tr: 'turkce', en: 'english', me: 'crnogorski' };
  const targetCol = langColMap[lang] || 'turkce';
  
  const match = texts.find(t => t.kod === currentPage.kod || t.sayfa === currentPage.kod);
  if (match) {
    pageContent = match[targetCol] || match['turkce'] || match[`icerik${lang}`] || '';
  }
}
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle} | TURSKA PIJACA</title>
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; background-color: #f8fafc; color: #0f172a; }
      .container { max-width: 1000px; margin: 3.5rem auto; padding: 0 1.5rem; min-height: 50vh; }
      .content-card { background: white; padding: 3rem; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; }
      .content-card h1 { color: #0b2218; font-size: 2rem; margin-top: 0; margin-bottom: 1.5rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 1rem; }
      .body-text { font-size: 1.1rem; line-height: 1.8; color: #334155; white-space: pre-wrap; }
    </style>
  </head>
  <body>
    <Header />
    <main class="container">
      <div class="content-card">
        <h1>{pageTitle}</h1>
        
        {pageContent ? (
          <div class="body-text" set:html={pageContent} />
        ) : (
          <div class="body-text">
            <p>Bu sayfa içeriği yakında güncellenecektir.</p>
          </div>
        )}
      </div>
    </main>
    <Footer lang={lang} />
  </body>
</html>
