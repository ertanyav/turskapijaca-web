---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getProducts, getTextDictionary } from '../../../lib/sheets';

const { lang = 'tr', id } = Astro.params;
const [products, dict] = await Promise.all([ getProducts(), getTextDictionary(lang) ]);

const product = products.find(p => String(p.urunno) === id || String(p.kayitid) === id);

// SEO: <html lang> ve hreflang için doğru dil kodları ("me" rotası korunur)
const htmlLang = lang === 'me' ? 'sr-Latn-ME' : lang;
const siteUrl = Astro.url.origin;
const productPath = (l) => `/${l}/products/${encodeURIComponent(id || '')}`;
const canonicalUrl = `${siteUrl}${productPath(lang)}`;

// Ürün bulunamazsa 404 döndür (ana sayfaya yönlendirme SEO için yanlış)
if (!product) {
  Astro.response.status = 404;
}

const name = product ? (product[`ad${lang}`] || product.adtr || product.icad || '') : '';
const desc = product ? (product[`aciklama${lang}`] || product.aciklamatr || product.aciklama || '') : '';
const img = product ? (product.gorselurl || 'https://via.placeholder.com/600') : '';
const code = product ? (product.urunno || product.kayitid || id || '') : (id || '');

const metaDescription = (desc || `${name} — Turska Pijaca B2B kataloğu. Ürün Kodu: ${code}`).slice(0, 160);

const txtBrand = dict['product.brand'] || (lang === 'en' ? 'Brand' : lang === 'me' ? 'Brend' : 'Marka');
const txtCode = dict['product.code'] || (lang === 'en' ? 'Product Code' : lang === 'me' ? 'Šifra' : 'Ürün Kodu');
const txtCategory = dict['product.category'] || (lang === 'en' ? 'Category' : lang === 'me' ? 'Kategorija' : 'Kategori');
const txtPackaging = dict['product.packaging'] || (lang === 'en' ? 'Packaging' : lang === 'me' ? 'Pakovanje' : 'Ambalaj');
const txtOrigin = dict['product.origin'] || (lang === 'en' ? 'Origin' : lang === 'me' ? 'Porijeklo' : 'Menşe');
const txtAddToCart = dict['product.addtocart'] || (lang === 'en' ? 'Add to Sourcing Order' : lang === 'me' ? 'Dodaj u Korpu' : 'Tedarik Sepetine Ekle');
const txtNotFound = dict['product.notfound'] || (lang === 'en' ? 'Product not found' : lang === 'me' ? 'Proizvod nije pronađen' : 'Ürün bulunamadı');
const txtBackHome = dict['product.backhome'] || (lang === 'en' ? 'Back to homepage' : lang === 'me' ? 'Nazad na početnu' : 'Ana sayfaya dön');

// JSON-LD (Product) — B2B olduğu için fiyat/offer bilgisi eklenmiyor
const productJsonLd = product ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: name,
  image: img ? [img] : undefined,
  description: desc || undefined,
  sku: String(code),
  productID: String(product.kayitid || code),
  brand: product.marka ? { '@type': 'Brand', name: product.marka } : undefined
}) : '';
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{product ? `${name} | Turska Pijaca` : `${txtNotFound} | Turska Pijaca`}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="tr" href={siteUrl + productPath('tr')} />
    <link rel="alternate" hreflang="en" href={siteUrl + productPath('en')} />
    <link rel="alternate" hreflang="sr-Latn-ME" href={siteUrl + productPath('me')} />
    <meta property="og:type" content="product" />
    <meta property="og:site_name" content="Turska Pijaca" />
    <meta property="og:title" content={name} />
    <meta property="og:description" content={metaDescription} />
    {img && <meta property="og:image" content={img} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={name} />
    <meta name="twitter:description" content={metaDescription} />
    {img && <meta name="twitter:image" content={img} />}
    {productJsonLd && <script type="application/ld+json" is:inline set:html={productJsonLd} />}
    <style>
      body { margin: 0; font-family: 'Inter', system-ui, sans-serif; background: #fcfcfc; color: #0f172a; }
      .container { max-width: 1200px; margin: 3.5rem auto; padding: 0 1.5rem; }
      .product-wrap { display: grid; grid-template-columns: 1fr 1.1fr; gap: 3.5rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 3rem; box-shadow: 0 4px 20px rgba(0,0,0,0.03); }
      .product-img { width: 100%; max-height: 480px; object-fit: contain; background: #ffffff; border: 1px solid #f1f5f9; border-radius: 6px; padding: 1.5rem; }
      .product-info h1 { font-size: 2.2rem; font-weight: 800; color: #0b2218; margin: 0 0 1.2rem; }

      .spec-table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; background: #f8fafc; border-radius: 6px; overflow: hidden; }
      .spec-table td { padding: 0.85rem 1.2rem; border-bottom: 1px solid #e2e8f0; font-size: 0.95rem; }
      .spec-table td:first-child { font-weight: 700; color: #0b2218; width: 130px; }
      .spec-table td:last-child { color: #475569; }

      .desc { font-size: 1.05rem; line-height: 1.8; color: #475569; margin: 1.5rem 0; }
      .btn-add { background: linear-gradient(135deg, #0b2218, #143d2c); color: #c5a059; border: 1px solid #c5a059; padding: 1.1rem 2rem; font-size: 1.05rem; font-weight: 800; border-radius: 6px; cursor: pointer; width: 100%; letter-spacing: 0.5px; box-shadow: 0 4px 15px rgba(11, 34, 24, 0.2); }
      .btn-add:hover { background: #0b2218; }

      .not-found { text-align: center; padding: 4rem 1.5rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; }
      .not-found h1 { color: #0b2218; font-size: 2rem; margin: 0 0 1.5rem; }
      @media (max-width: 800px) { .product-wrap { grid-template-columns: 1fr; padding: 1.8rem; } }
    </style>
  </head>
  <body>
    <Header />
    <main class="container">
      {product ? (
        <div class="product-wrap">
          <img src={img} alt={name} class="product-img" />
          <div class="product-info">
            <h1>{name}</h1>

            <table class="spec-table">
              <tr><td>{txtCode}</td><td>{code}</td></tr>
              <tr><td>{txtBrand}</td><td>{product.marka || '-'}</td></tr>
              <tr><td>{txtCategory}</td><td>{product.kategori || '-'}</td></tr>
              <tr><td>{txtPackaging}</td><td>{product.ambalaj || product.ambalajtipi || '-'}</td></tr>
              <tr><td>{txtOrigin}</td><td>{product.mense || '-'}</td></tr>
            </table>

            {desc && <p class="desc">{desc}</p>}

            <button
              class="btn-add"
              id="add-product-to-cart"
              data-product-id={String(code)}
              data-product-name={name}
              data-product-image={img}
            >
              🛒 {txtAddToCart}
            </button>
          </div>
        </div>
      ) : (
        <div class="not-found">
          <h1>{txtNotFound}</h1>
          <a href={`/${lang}`} class="btn-add" style="display:inline-block; width:auto; text-decoration:none;">{txtBackHome}</a>
        </div>
      )}
    </main>

    <script>
      const addButton = document.getElementById('add-product-to-cart');

      addButton?.addEventListener('click', () => {
        const id = addButton.dataset.productId || '';
        const name = addButton.dataset.productName || '';
        const img = addButton.dataset.productImage || '';

        // Header içindeki merkezi sepet fonksiyonu kullanılır
        if (typeof window.addToCart === 'function') {
          window.addToCart(id, name, img);
        }
      });
    </script>
    <Footer lang={lang} />
  </body>
</html>
