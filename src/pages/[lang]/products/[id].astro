---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getProducts } from '../../../lib/sheets';

const { lang, id } = Astro.params;
const products = await getProducts();

const product = products.find(p => String(p.id) === String(id) || String(p.kod) === String(id)) || products[0];

if (!product) {
  return Astro.redirect(`/${lang}`);
}

const title = product[`ad${lang}`] || product['adtr'] || product.kod || 'Ürün Detayı';
const desc = product[`aciklama${lang}`] || product['aciklamatr'] || 'Toptan sipariş ve tedarik şartları için iletişime geçiniz.';
const img = product.gorsel || product.resim || product.image || 'https://via.placeholder.com/600x500?text=TURSKA+PIJACA';

const whatsappMsg = encodeURIComponent(`Merhaba, ${title} (Kod: ${product.kod || ''}) ürününüz hakkında toptan fiyat ve detay almak istiyorum.`);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | TURSKA PIJACA B2B</title>
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; background: #f8fafc; color: #0f172a; }
      .container { max-width: 1100px; margin: 3rem auto; padding: 0 1.5rem; }
      .product-detail {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2.5rem;
        padding: 2.5rem;
      }
      .detail-img { width: 100%; height: 400px; object-fit: cover; border-radius: 12px; background: #f1f5f9; }
      .detail-content { display: flex; flex-direction: column; }
      .badge { align-self: flex-start; background: #e2e8f0; color: #0b2218; font-weight: 700; font-size: 0.8rem; padding: 0.3rem 0.8rem; border-radius: 20px; margin-bottom: 1rem; }
      .product-title { font-size: 2rem; color: #0b2218; margin: 0 0 1rem 0; font-weight: 800; }
      .product-desc { color: #475569; font-size: 1.05rem; line-height: 1.6; margin-bottom: 2rem; }
      .b2b-actions { margin-top: auto; display: flex; gap: 1rem; flex-wrap: wrap; }
      .btn-whatsapp {
        flex: 1;
        background: #25D366;
        color: white;
        text-decoration: none;
        padding: 1rem;
        border-radius: 8px;
        text-align: center;
        font-weight: 700;
        transition: background 0.2s;
      }
      .btn-whatsapp:hover { background: #1da851; }
      @media (max-width: 768px) {
        .product-detail { grid-template-columns: 1fr; gap: 1.5rem; padding: 1.5rem; }
        .detail-img { height: 280px; }
      }
    </style>
  </head>
  <body>
    <Header />

    <main class="container">
      <div class="product-detail">
        <img src={img} alt={title} class="detail-img" />
        <div class="detail-content">
          <span class="badge">Ürün Kodu: {product.kod || 'TP-PROD'}</span>
          <h1 class="product-title">{title}</h1>
          <p class="product-desc">{desc}</p>

          <div class="b2b-actions">
            <a href={`https://wa.me/905000000000?text=${whatsappMsg}`} target="_blank" class="btn-whatsapp">
              💬 WhatsApp ile Toptan Fiyat Al
            </a>
          </div>
        </div>
      </div>
    </main>

    <Footer lang={lang} />
  </body>
</html>
