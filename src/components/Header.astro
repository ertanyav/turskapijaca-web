---
import { getPages, getTexts } from '../lib/sheets';

// URL'den aktif dili tespit et (tr, en, me)
const pathname = Astro.url.pathname;
let currentLang = 'tr';
if (pathname.startsWith('/en')) {
  currentLang = 'en';
} else if (pathname.startsWith('/me')) {
  currentLang = 'me';
}

const pages = await getPages();
const texts = await getTexts();

// Sadece Menüde = EVET ve Yayında = EVET olan sayfaları al, Sıra'ya göre sırala
const menuPages = pages
  .filter(p => p.Yayında === 'EVET' && p.Menüde === 'EVET')
  .sort((a, b) => Number(a.Sıra || 0) - Number(b.Sıra || 0));

// Metin çevirileri için yardımcı fonksiyon
function getText(key, defaultVal) {
  const found = texts.find(t => t.Anahtar === key);
  if (!found) return defaultVal;
  if (currentLang === 'en') return found.English || defaultVal;
  if (currentLang === 'me') return found.Crnogorski || defaultVal;
  return found.Türkçe || defaultVal;
}
---

<header class="site-header">
  <div class="header-inner">
    <div class="logo">
      <a href={currentLang === 'en' ? '/en/home' : currentLang === 'me' ? '/me/početna' : '/tr/ana-sayfa'}>
        <strong>TURSKA PIJACA</strong>
      </a>
    </div>

    <nav class="main-nav">
      <ul>
        {menuPages.map((page) => {
          // Master'dan gelen adresi al ve aktif dile göre [lang] prefix'i ile uyumlu hale getir
          let rawPath = page['Adres TR'];
          if (currentLang === 'en') rawPath = page['Adres EN'] || rawPath;
          if (currentLang === 'me') rawPath = page['Adres ME'] || rawPath;

          // Eğer yol slash ile başlamıyorsa ekle
          if (!rawPath.startsWith('/')) rawPath = '/' + rawPath;

          // Dil prefix'ini doğru konumlandırma (örnek: /tr/ana-sayfa, /en/products vb.)
          let finalHref = `/${currentLang}${rawPath}`;
          // Eğer ana sayfa kök dizin ise veya özel durum varsa temizle
          if (rawPath === '/ana-sayfa' || rawPath === '/home' || rawPath === '/početna') {
            finalHref = `/${currentLang}`;
          }

          const titleKey = `${page.Kod}.title`;
          const menuTitle = getText(titleKey, page.Kod);

          return (
            <li>
              <a href={finalHref}>{menuTitle}</a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    background: transparent; /* Sitenin kendi koyu yeşil arka planına uyum sağlar */
    padding: 1.25rem 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo a {
    color: #ffffff;
    text-decoration: none;
    font-size: 1.25rem;
    letter-spacing: 0.5px;
  }
  .main-nav ul {
    display: flex;
    list-style: none;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }
  .main-nav a {
    color: #e2e8f0;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 400;
    transition: color 0.2s ease;
  }
  .main-nav a:hover {
    color: #ffffff;
    text-decoration: underline;
  }
</style>
