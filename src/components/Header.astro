---
import { getMenu, getLogoUrl, getTextDictionary } from '../lib/sheets';

const { pathname = '' } = Astro.url;
const segments = pathname.split('/').filter(Boolean);
const currentLang = ['tr', 'en', 'me'].includes(segments[0]) ? segments[0] : 'tr';

let menuItems = [];
let logoUrl = '';
let dict = {};

try {
  [menuItems, logoUrl, dict] = await Promise.all([
    getMenu(),
    getLogoUrl(),
    getTextDictionary(currentLang)
  ]);
} catch (error) {
  console.error('Header verileri yüklenemedi:', error);
}

const languages = [
  { code: 'tr', label: 'TR' },
  { code: 'en', label: 'EN' },
  { code: 'me', label: 'ME' }
];

function getLangPath(targetCode) {
  if (segments.length === 0) return `/${targetCode}`;

  const newSegments = [...segments];

  if (['tr', 'en', 'me'].includes(newSegments[0])) {
    newSegments[0] = targetCode;
  } else {
    newSegments.unshift(targetCode);
  }

  return '/' + newSegments.join('/');
}

// Master dosyadan dinamik metinler
const txtCart =
  dict['common.cart'] ||
  dict['ortak.sepet'] ||
  (currentLang === 'en'
    ? 'Cart'
    : currentLang === 'me'
      ? 'Korpa'
      : 'Sepet');

const txtCheckout =
  dict['cart.checkout'] ||
  (currentLang === 'en'
    ? 'Complete Order'
    : currentLang === 'me'
      ? 'Naruči'
      : 'Siparişi Tamamla');

const txtEmpty =
  dict['cart.empty'] ||
  (currentLang === 'en'
    ? 'Cart is empty'
    : currentLang === 'me'
      ? 'Korpa je prazna'
      : 'Sepetiniz boş.');

const txtCode =
  dict['product.code'] ||
  (currentLang === 'en'
    ? 'Code'
    : currentLang === 'me'
      ? 'Šifra'
      : 'Kod');

const txtMenu =
  currentLang === 'en'
    ? 'Menu'
    : currentLang === 'me'
      ? 'Meni'
      : 'Menü';

const phone = dict['contact.phone'] || '38263256666';
const cleanPhone = String(phone).replace(/[^0-9]/g, '');
---

<header class="main-header">
  <div class="header-container">
    <a href={`/${currentLang}`} class="logo-link" aria-label="TURSKA PIJACA">
      {logoUrl && (
        <img
          src={logoUrl}
          alt="TURSKA PIJACA"
          class="site-logo"
          width="180"
          height="48"
        />
      )}
    </a>

    <button
      id="mobile-menu-toggle"
      class="mobile-menu-toggle"
      type="button"
      aria-label={txtMenu}
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav id="main-navigation" class="main-menu" aria-label={txtMenu}>
      <ul>
        {menuItems.map(item => {
          const name = item[`ad${currentLang}`] || item.adtr;
          const rawAddress = item[`adres${currentLang}`] || item.adrestr;

          if (!name || item.kod === 'home' || !rawAddress) return null;

          const cleanAddress = String(rawAddress)
            .replace(/^\/+/, '')
            .replace(/\/+$/, '');

          const finalPath = `/${currentLang}/${cleanAddress}`.toLowerCase();
          const hasChildren = item.children && item.children.length > 0;

          return (
            <li class={`menu-item ${hasChildren ? 'has-dropdown' : ''}`}>
              <a href={finalPath} class="menu-link">
                {name}
                {hasChildren && <span class="arrow" aria-hidden="true">▾</span>}
              </a>

              {hasChildren && (
                <ul class="dropdown-menu">
                  {item.children.map(child => {
                    const childName = child[`ad${currentLang}`] || child.adtr;
                    const childAddr = child[`adres${currentLang}`] || child.adrestr;

                    if (!childName || !childAddr) return null;

                    const childPath = `/${currentLang}/${String(childAddr)
                      .replace(/^\/+/, '')
                      .replace(/\/+$/, '')}`.toLowerCase();

                    return (
                      <li>
                        <a href={childPath}>{childName}</a>
                      </li>
                    );
                  })}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-right">
      <button
        id="cart-toggle"
        class="cart-btn"
        type="button"
        aria-label={txtCart}
        aria-expanded="false"
        aria-controls="cart-sidebar"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>

        <span class="cart-count-badge" id="cart-count" aria-live="polite">0</span>
      </button>

      <div class="language-switcher" aria-label="Language selection">
        {languages.map(language => (
          <a
            href={getLangPath(language.code)}
            class={currentLang === language.code ? 'active' : ''}
            aria-current={currentLang === language.code ? 'page' : undefined}
          >
            {language.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<div id="mobile-menu-overlay" class="mobile-menu-overlay"></div>

<aside
  id="cart-sidebar"
  class="cart-sidebar"
  aria-hidden="true"
  aria-label={txtCart}
>
  <div class="cart-header">
    <h2>{txtCart}</h2>

    <button
      id="cart-close"
      class="cart-close"
      type="button"
      aria-label={currentLang === 'en' ? 'Close cart' : currentLang === 'me' ? 'Zatvori korpu' : 'Sepeti kapat'}
    >
      ×
    </button>
  </div>

  <div id="cart-items" class="cart-items"></div>

  <div class="cart-footer">
    <button
      id="checkout-btn"
      class="checkout-btn"
      type="button"
      data-phone={cleanPhone}
    >
      {txtCheckout}
    </button>
  </div>
</aside>

<div id="cart-overlay" class="cart-overlay"></div>

<script define:vars={{ txtEmpty, txtCode }}>
  const CART_STORAGE_KEY = 'tp_cart';
  const FALLBACK_IMAGE = 'https://via.placeholder.com/70';

  let cart = [];

  function readCart() {
    try {
      const storedCart = JSON.parse(
        localStorage.getItem(CART_STORAGE_KEY) || '[]'
      );

      if (!Array.isArray(storedCart)) return [];

      return storedCart
        .filter(item => item && item.id)
        .map(item => ({
          id: String(item.id),
          name: String(item.name || ''),
          img: String(item.img || ''),
          qty: Math.max(1, Number(item.qty) || 1)
        }));
    } catch (error) {
      console.error('Sepet okunamadı:', error);
      return [];
    }
  }

  function saveCart() {
    localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
  }

  function getCartQuantity() {
    return cart.reduce((total, item) => total + item.qty, 0);
  }

  function updateCartCount() {
    const countElement = document.getElementById('cart-count');

    if (!countElement) return;

    const quantity = getCartQuantity();

    countElement.textContent = String(quantity);
    countElement.hidden = quantity === 0;
  }

  function createElement(tagName, className, text = '') {
    const element = document.createElement(tagName);

    if (className) {
      element.className = className;
    }

    if (text) {
      element.textContent = text;
    }

    return element;
  }

  function renderCart() {
    const itemsContainer = document.getElementById('cart-items');

    updateCartCount();

    if (!itemsContainer) return;

    itemsContainer.replaceChildren();

    if (cart.length === 0) {
      const emptyMessage = createElement('p', 'cart-empty', txtEmpty);
      itemsContainer.appendChild(emptyMessage);
      return;
    }

    cart.forEach((item, index) => {
      const cartItem = createElement('div', 'cart-item');

      const image = document.createElement('img');
      image.src = item.img || FALLBACK_IMAGE;
      image.alt = item.name;
      image.width = 70;
      image.height = 70;
      image.loading = 'lazy';
      image.referrerPolicy = 'no-referrer';

      image.addEventListener('error', () => {
        image.src = FALLBACK_IMAGE;
      }, { once: true });

      const itemInfo = createElement('div', 'cart-item-info');
      const itemName = createElement('div', 'cart-item-name', item.name);
      const itemCode = createElement(
        'div',
        'cart-item-code',
        `${txtCode}: ${item.id}`
      );

      const quantityControls = createElement('div', 'cart-item-qty');

      const decreaseButton = createElement('button', 'qty-button', '−');
      decreaseButton.type = 'button';
      decreaseButton.dataset.index = String(index);
      decreaseButton.dataset.change = '-1';
      decreaseButton.setAttribute('aria-label', 'Decrease quantity');

      const quantity = createElement(
        'span',
        'cart-item-quantity',
        String(item.qty)
      );

      const increaseButton = createElement('button', 'qty-button', '+');
      increaseButton.type = 'button';
      increaseButton.dataset.index = String(index);
      increaseButton.dataset.change = '1';
      increaseButton.setAttribute('aria-label', 'Increase quantity');

      quantityControls.append(
        decreaseButton,
        quantity,
        increaseButton
      );

      itemInfo.append(itemName, itemCode, quantityControls);
      cartItem.append(image, itemInfo);
      itemsContainer.appendChild(cartItem);
    });
  }

  function updateQuantity(index, change) {
    const item = cart[index];

    if (!item) return;

    item.qty += change;

    if (item.qty <= 0) {
      cart.splice(index, 1);
    }

    saveCart();
    renderCart();
    window.dispatchEvent(new Event('cartUpdated'));
  }

  function openCart() {
    const sidebar = document.getElementById('cart-sidebar');
    const overlay = document.getElementById('cart-overlay');
    const toggleButton = document.getElementById('cart-toggle');

    sidebar?.classList.add('open');
    sidebar?.setAttribute('aria-hidden', 'false');
    overlay?.classList.add('open');
    toggleButton?.setAttribute('aria-expanded', 'true');

    renderCart();
  }

  function closeCart() {
    const sidebar = document.getElementById('cart-sidebar');
    const overlay = document.getElementById('cart-overlay');
    const toggleButton = document.getElementById('cart-toggle');

    sidebar?.classList.remove('open');
    sidebar?.setAttribute('aria-hidden', 'true');
    overlay?.classList.remove('open');
    toggleButton?.setAttribute('aria-expanded', 'false');
  }

  function toggleCart() {
    const sidebar = document.getElementById('cart-sidebar');

    if (sidebar?.classList.contains('open')) {
      closeCart();
    } else {
      openCart();
    }
  }

  function addToCart(id, name, img = '') {
    if (!id || !name) return;

    const productId = String(id);
    const productName = String(name);
    const productImage = String(img || '');

    const existingItem = cart.find(item => item.id === productId);

    if (existingItem) {
      existingItem.qty += 1;

      if (!existingItem.img && productImage) {
        existingItem.img = productImage;
      }
    } else {
      cart.push({
        id: productId,
        name: productName,
        img: productImage,
        qty: 1
      });
    }

    saveCart();
    renderCart();
    window.dispatchEvent(new Event('cartUpdated'));
    openCart();
  }

  function toggleMobileMenu() {
    const navigation = document.getElementById('main-navigation');
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const overlay = document.getElementById('mobile-menu-overlay');

    const isOpen = navigation?.classList.toggle('mobile-open');

    toggleButton?.classList.toggle('is-open', Boolean(isOpen));
    toggleButton?.setAttribute('aria-expanded', String(Boolean(isOpen)));
    overlay?.classList.toggle('open', Boolean(isOpen));
    document.body.classList.toggle('menu-open', Boolean(isOpen));
  }

  function closeMobileMenu() {
    const navigation = document.getElementById('main-navigation');
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const overlay = document.getElementById('mobile-menu-overlay');

    navigation?.classList.remove('mobile-open');
    toggleButton?.classList.remove('is-open');
    toggleButton?.setAttribute('aria-expanded', 'false');
    overlay?.classList.remove('open');
    document.body.classList.remove('menu-open');
  }

  cart = readCart();

  document
    .getElementById('cart-toggle')
    ?.addEventListener('click', toggleCart);

  document
    .getElementById('cart-close')
    ?.addEventListener('click', closeCart);

  document
    .getElementById('cart-overlay')
    ?.addEventListener('click', closeCart);

  document
    .getElementById('mobile-menu-toggle')
    ?.addEventListener('click', toggleMobileMenu);

  document
    .getElementById('mobile-menu-overlay')
    ?.addEventListener('click', closeMobileMenu);

  document
    .getElementById('cart-items')
    ?.addEventListener('click', event => {
      const button = event.target.closest('.qty-button');

      if (!button) return;

      const index = Number(button.dataset.index);
      const change = Number(button.dataset.change);

      if (!Number.isInteger(index) || !Number.isFinite(change)) return;

      updateQuantity(index, change);
    });

  document
    .getElementById('checkout-btn')
    ?.addEventListener('click', event => {
      if (cart.length === 0) return;

      const button = event.currentTarget;
      const phone = button?.getAttribute('data-phone') || '';

      const lines = cart.map(
        item => `- ${item.name} (${txtCode}: ${item.id}) x ${item.qty}`
      );

      const message = [
        'Merhaba, aşağıdaki ürünler için toptan sipariş/teklif talep ediyorum:',
        '',
        ...lines
      ].join('\n');

      window.open(
        `https://wa.me/${phone}?text=${encodeURIComponent(message)}`,
        '_blank',
        'noopener,noreferrer'
      );
    });

document
    .getElementById('main-navigation')
    ?.addEventListener('click', event => {
      const link = event.target.closest('a');

      if (!link) return;

      closeMobileMenu();
    });

  renderCart();
</script>

<style>
  .main-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.06);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(100% - 2rem, 1280px);
    min-height: 76px;
    margin: 0 auto;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    text-decoration: none;
  }

  .site-logo {
    display: block;
    width: 180px;
    height: 48px;
    object-fit: contain;
  }

  .main-menu {
    display: flex;
    align-items: center;
    margin-left: auto;
  }

  .main-menu ul {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-item {
    position: relative;
  }

  .menu-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.75rem 0.7rem;
    color: #0f172a;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    border-radius: 8px;
  }

  .menu-link:hover,
  .menu-link:focus-visible {
    color: #047857;
    background: #ecfdf5;
  }

  .arrow {
    font-size: 0.7rem;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    display: none !important;
    min-width: 220px;
    margin: 0;
    padding: 0.5rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.14);
  }

  .has-dropdown:hover > .dropdown-menu,
  .has-dropdown:focus-within > .dropdown-menu {
    display: block !important;
  }

  .dropdown-menu li {
    display: block;
  }

  .dropdown-menu a {
    display: block;
    padding: 0.65rem 0.75rem;
    color: #334155;
    font-size: 0.9rem;
    line-height: 1.35;
    text-decoration: none;
    border-radius: 6px;
  }

  .dropdown-menu a:hover,
  .dropdown-menu a:focus-visible {
    color: #047857;
    background: #ecfdf5;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex: 0 0 auto;
  }

  .cart-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    padding: 0;
    color: #0f172a;
    cursor: pointer;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 50%;
  }

  .cart-btn:hover {
    color: #047857;
    border-color: #10b981;
    background: #ecfdf5;
  }

  .cart-count-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    background: #dc2626;
    border: 2px solid #ffffff;
    border-radius: 999px;
  }

  .cart-count-badge[hidden] {
    display: none;
  }

  .language-switcher {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .language-switcher a {
    padding: 0.35rem 0.45rem;
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 5px;
  }

  .language-switcher a:hover,
  .language-switcher a.active {
    color: #047857;
    background: #ecfdf5;
  }

  .mobile-menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4px;
    width: 42px;
    height: 42px;
    padding: 0;
    cursor: pointer;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
  }

  .mobile-menu-toggle span {
    display: block;
    width: 21px;
    height: 2px;
    background: #0f172a;
    border-radius: 2px;
  }

  .cart-sidebar {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 1200;
    display: flex;
    flex-direction: column;
    width: min(390px, 100%);
    height: 100vh;
    padding: 1.25rem;
    background: #ffffff;
    box-sizing: border-box;
    transform: translateX(100%);
    transition: transform 0.25s ease;
  }

  .cart-sidebar.open {
    transform: translateX(0);
  }

  .cart-overlay,
  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 1100;
    display: none;
    background: rgba(15, 23, 42, 0.48);
  }

  .cart-overlay.open,
  .mobile-menu-overlay.open {
    display: block;
  }

  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .cart-header h2 {
    margin: 0;
    color: #0f172a;
    font-size: 1.25rem;
  }

  .cart-close {
    padding: 0.25rem 0.6rem;
    color: #475569;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    background: transparent;
    border: 0;
  }

  .cart-items {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0;
  }

  .cart-empty {
    color: #64748b;
    text-align: center;
  }

  .cart-item {
    display: flex;
    gap: 0.75rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid #e2e8f0;
  }

  .cart-item img {
    flex: 0 0 70px;
    width: 70px;
    height: 70px;
    object-fit: contain;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
  }

  .cart-item-info {
    min-width: 0;
  }

  .cart-item-name {
    color: #0f172a;
    font-weight: 700;
  }

  .cart-item-code {
    margin-top: 0.25rem;
    color: #64748b;
    font-size: 0.78rem;
  }

  .cart-item-qty {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 0.6rem;
  }

  .qty-button {
    width: 28px;
    height: 28px;
    cursor: pointer;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
  }

  .cart-footer {
    padding-top: 1rem;
    border-top: 1px solid #e2e8f0;
  }

  .checkout-btn {
    width: 100%;
    padding: 0.85rem 1rem;
    color: #ffffff;
    font-weight: 700;
    cursor: pointer;
    background: #047857;
    border: 0;
    border-radius: 8px;
  }

  .checkout-btn:hover {
    background: #065f46;
  }

  @media (max-width: 900px) {
    .header-container {
      min-height: 68px;
    }

    .main-menu {
      position: fixed;
      top: 68px;
      left: 0;
      z-index: 1150;
      display: block;
      width: min(320px, 86vw);
      height: calc(100vh - 68px);
      padding: 1rem;
      overflow-y: auto;
      background: #ffffff;
      box-shadow: 8px 0 24px rgba(15, 23, 42, 0.12);
      transform: translateX(-105%);
      transition: transform 0.25s ease;
    }

    .main-menu.mobile-open {
      transform: translateX(0);
    }

    .main-menu ul {
      display: block;
    }

    .menu-link {
      display: flex;
      justify-content: space-between;
      width: 100%;
      box-sizing: border-box;
    }

    .dropdown-menu {
      position: static;
      display: block !important;
      min-width: 0;
      margin: 0.25rem 0 0.5rem 0.75rem;
      padding: 0 0 0 0.5rem;
      border: 0;
      border-left: 2px solid #d1fae5;
      box-shadow: none;
    }

    .mobile-menu-toggle {
      display: inline-flex;
      order: 2;
    }

    .logo-link {
      order: 1;
      margin-right: auto;
    }

    .header-right {
      order: 3;
    }

    .site-logo {
      width: 145px;
      height: 42px;
    }
  }

  @media (max-width: 520px) {
    .header-container {
      width: calc(100% - 1rem);
      gap: 0.5rem;
    }

    .language-switcher {
      display: none;
    }

    .site-logo {
      width: 130px;
    }
  }
</style>
