---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCategories, getTextDictionary } from '../../lib/sheets';

const { lang = 'tr' } = Astro.params;
const [categories, dict] = await Promise.all([ getCategories(), getTextDictionary(lang) ]);

const heroTitle = dict['home.hero.title'] || 'TURSKA PIJACA';
const heroSubtitle = dict['home.hero.subtitle'] || 'Production in Türkiye. Strong supply in Montenegro.';
const heroDesc = dict['home.hero.text'] || 'Direct supply and wholesale distribution for markets, hotels, restaurants and cafes.';
const heroBtn = dict['home.hero.button'] || 'Tüm Ürünler / All Products';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{heroTitle} | B2B Supply Montenegro</title>
    <style>
      body { margin: 0; font-family: 'Inter', system-ui, sans-serif; background: #f8fafc; color: #0f172a; }
      .hero { background: linear-gradient(135deg, #071710 0%, #0b2218 100%); color: white; padding: 4.5rem 1.5rem; text-align: center; border-bottom: 3px solid #34d399; }
      .hero-sub { color: #34d399; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; font-size: 0.85rem; margin-bottom: 0.8rem; }
      .hero h1 { font-size: 2.6rem; font-weight: 800; margin: 0 0 1rem; }
      .hero p { font-size: 1.15rem; color: #cbd5e1; max-width: 720px; margin: 0 auto 2rem; line-height: 1.6; }
      .hero-btn { display: inline-block; background: #34d399; color: #0b2218; padding: 0.85rem 2.2rem; border-radius: 6px; text-decoration: none; font-weight: 800; font-size: 0.95rem; }
      
      .container { max-width: 1280px; margin: 3.5rem auto; padding: 0 1.5rem; }
      .section-title { text-align: center; font-size: 1.8rem; color: #0b2218; font-weight: 800; margin-bottom: 2rem; }
      .categories-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.5rem; }
      .category-card { background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.2rem; text-align: center; text-decoration: none; color: #0b2218; font-weight: 700; transition: transform 0.2s, border-color 0.2s; }
      .category-card:hover { transform: translateY(-3px); border-color: #34d399; }
      .cat-img { width: 100%; height: 150px; object-fit: contain; margin-bottom: 0.8rem; background: #f8fafc; border-radius: 6px; padding: 8px; }
    </style>
  </head>
  <body>
    <Header />
    <section class="hero">
      <div class="hero-sub">{heroSubtitle}</div>
      <h1>{heroTitle}</h1>
      <p>{heroDesc}</p>
      <a href={`/${lang}/ürünler/tüm-ürünler`} class="hero-btn">{heroBtn}</a>
    </section>

    <main class="container">
      <h2 class="section-title">Kategoriler / Categories</h2>
      <div class="categories-grid">
        {categories.map(c => {
          const name = c[`ad${lang}`] || c.adtr;
          const targetAddr = (c[`adres${lang}`] || c.adrestr || '').replace(/^\//, '');
          return (
            <a href={`/${lang}/${targetAddr}`.toLowerCase()} class="category-card">
              <img src={c.gorselurl || 'https://via.placeholder.com/300x200'} alt={name} class="cat-img" loading="lazy" />
              <div>{name}</div>
            </a>
          );
        })}
      </div>
    </main>

    <Footer lang={lang} />
  </body>
</html>
