---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPages, getTexts } from '../../lib/sheets';

const { lang, slug } = Astro.params;
const validLangs = ['tr', 'en', 'me'];
if (!validLangs.includes(lang)) return Astro.redirect('/tr');

const [pages, texts] = await Promise.all([ getPages(), getTexts() ]);

const currentPage = pages.find(p => {
  const pathStr = p[`adres${lang}`] || p['adrestr'] || p.kod;
  if (!pathStr) return false;
  return String(pathStr).replace(/^\//, '').toLowerCase() === (slug || '').toLowerCase();
});

if (!currentPage) return Astro.redirect(`/${lang}`);

// Sayfa başlığı artık kesinlikle tıklanan menünün o dildeki adına eşitleniyor
const pageTitle = currentPage[`ad${lang}`] || currentPage['adtr'] || currentPage.kod;

// METINLER sekmesinden o sayfaya ait metni çekiyoruz
let pageContent = '';
if (texts && texts.length > 0) {
  const langKey = lang === 'en' ? 'english' : lang === 'me' ? 'crnogorski' : 'turkce';
  const matchingText = texts.find(t => t.kod === currentPage.kod || t.sayfa === currentPage.kod);
  if (matchingText) {
    pageContent = matchingText[langKey] || matchingText[`icerik${lang}`] || matchingText['turkce'] || '';
  }
}
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle} | TURSKA PIJACA</title>
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; background-color: #f8fafc; color: #0f172a; }
      .container { max-width: 1000px; margin: 3.5rem auto; padding: 0 1.5rem; min-height: 50vh; }
      .content-card { background: white; padding: 3rem; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; }
      .content-card h1 { color: #0b2218; font-size: 2.2rem; margin-top: 0; margin-bottom: 1.5rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 1rem; }
      .body-text { font-size: 1.1rem; line-height: 1.8; color: #334155; white-space: pre-wrap; }
    </style>
  </head>
  <body>
    <Header />
    <main class="container">
      <div class="content-card">
        <h1>{pageTitle}</h1>
        
        {pageContent ? (
          <div class="body-text" set:html={pageContent} />
        ) : (
          <div class="body-text">
            <p>Bu sayfa için içerik yakında güncellenecektir.</p>
          </div>
        )}
      </div>
    </main>
    <Footer lang={lang} />
  </body>
</html>
