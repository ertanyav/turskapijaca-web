---
const {
  product = {},
  lang = 'en',
  addToCartLabel,
  codeLabel,
  quoteLabel
} = Astro.props;

const productKeys = Object.keys(product);

const getValue = (keys, fallback = '') => {
  const key = productKeys.find((item) =>
    keys.some((candidate) => item.toLowerCase() === candidate.toLowerCase())
  );

  return key ? String(product[key] || '').trim() : fallback;
};

const localizedName =
  getValue([`ad${lang}`, `Ad ${lang}`, `ad_${lang}`]) ||
  getValue(['adtr', 'Ad TR', 'ad_tr']) ||
  getValue(['ad', 'name', 'title']) ||
  'Ürün';

const code =
  getValue(['urunno', 'Ürün No', 'ürün no', 'urun_no', 'kayitid', 'Kayıt ID']) ||
  '';

const imageCandidate = getValue([
  'gorselurl',
  'Görsel URL',
  'gorsel_url',
  'image',
  'imageurl'
]);

const image = /^https?:\/\//i.test(imageCandidate) ? imageCandidate : '';
const detailUrl = `/${lang}/products/${encodeURIComponent(code)}`;

const labels = {
  tr: {
    add: 'Sepete Ekle',
    code: 'Kod',
    quote: 'Teklif İste'
  },
  en: {
    add: 'Add to Cart',
    code: 'Code',
    quote: 'Request Quote'
  },
  me: {
    add: 'Dodaj u korpu',
    code: 'Šifra',
    quote: 'Zatražite ponudu'
  }
};

const currentLabels = labels[lang] || labels.en;
const finalAddLabel = addToCartLabel || currentLabels.add;
const finalCodeLabel = codeLabel || currentLabels.code;
const finalQuoteLabel = quoteLabel || currentLabels.quote;
---

<article class="product-card">
  <a class="product-image-link" href={detailUrl}>
    {image ? (
      <img
        src={image}
        alt={localizedName}
        width="400"
        height="300"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="image-placeholder" aria-label={localizedName}>
        {localizedName}
      </div>
    )}
  </a>

  <div class="product-content">
    <h2 class="product-title">
      <a href={detailUrl}>{localizedName}</a>
    </h2>

    {code && (
      <p class="product-code">
        {finalCodeLabel}: {code}
      </p>
    )}

    <div class="product-actions">
      <a class="details-link" href={detailUrl}>
        {finalQuoteLabel}
      </a>

      <button
        type="button"
        class="add-to-cart-button"
        data-add-to-cart
        data-product-id={code}
        data-product-name={localizedName}
        data-product-image={image}
      >
        {finalAddLabel}
      </button>
    </div>
  </div>
</article>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const button = target.closest('[data-add-to-cart]');
    if (!(button instanceof HTMLElement)) return;

    const productId = button.dataset.productId || '';
    const productName = button.dataset.productName || '';
    const productImage = button.dataset.productImage || '';

    if (!productId || typeof window.addToCart !== 'function') {
      return;
    }

    window.addToCart(productId, productName, productImage);
  });
</script>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .product-card:hover {
    border-color: #059669;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
    transform: translateY(-3px);
  }

  .product-image-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 220px;
    padding: 1rem;
    background: #f8fafc;
    text-decoration: none;
  }

  .product-image-link img {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: contain;
  }

  .image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 220px;
    padding: 1rem;
    color: #64748b;
    font-size: 0.9rem;
    text-align: center;
  }

  .product-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem;
  }

  .product-title {
    margin: 0;
    color: #0f172a;
    font-size: 1.05rem;
    line-height: 1.4;
  }

  .product-title a {
    color: inherit;
    text-decoration: none;
  }

  .product-title a:hover {
    color: #059669;
  }

  .product-code {
    margin: 0.6rem 0 1.2rem;
    color: #64748b;
    font-size: 0.85rem;
  }

  .product-actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: auto;
  }

  .details-link,
  .add-to-cart-button {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
    cursor: pointer;
  }

  .details-link {
    color: #047857;
    border: 1px solid #a7f3d0;
    text-decoration: none;
  }

  .details-link:hover {
    background: #ecfdf5;
  }

  .add-to-cart-button {
    color: #ffffff;
    background: #059669;
    border: 1px solid #059669;
  }

  .add-to-cart-button:hover {
    background: #047857;
    border-color: #047857;
  }
</style>
