---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getProducts, getTexts } from '../../../lib/sheets';

export async function getStaticPaths() {
  const products = await getProducts();
  return ['en', 'me', 'tr'].flatMap(lang => 
    products.map(p => ({
      params: { lang, id: String(p['Ürün no'] || p['Kayıt ID']).trim() },
      props: { product: p }
    }))
  ).filter(p => p.params.id);
}

const { lang, id } = Astro.params;
const { product } = Astro.props;
const texts = await getTexts();

const title = product[`Ad ${lang.toUpperCase()}`] || product['Ad EN'] || product['İç ad'];
const category = product['Kategori'] || 'General';
const brand = product['Marka'] || 'TURSKA PIJACA';
const image = product['Görsel URL'] || 'https://via.placeholder.com/500/1f2937/4ade80?text=TP';
let rawPrice = (product['Fiyat EUR'] ? String(product['Fiyat EUR']) : '').replace(/TRY|TL|EUR|€|\$/gi, '').trim();
const price = (rawPrice && rawPrice !== '0') ? `€${rawPrice}` : 'Quote';
---

<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <title>{title} | TURSKA PIJACA</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>
<body style="margin: 0; font-family: system-ui, sans-serif; background: #111827; color: #f8fafc;">
  <Header lang={lang} texts={texts} />

  <main style="max-width: 1000px; margin: 3rem auto; padding: 0 1.5rem;">
    <!-- Breadcrumb (Aynı pencerede açılır) -->
    <div style="margin-bottom: 1.5rem; font-size: 0.85rem; color: #9ca3af;">
      <a href={`/${lang}/`} target="_self" style="color: #10b981; text-decoration: none; font-weight: bold;">Catalog</a> / 
      <span>{category}</span> / <strong style="color: white;">{title}</strong>
    </div>

    <div style="background: #1f2937; border-radius: 16px; padding: 2.5rem; border: 1px solid #374151; display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem;">
      <div style="background: white; border-radius: 12px; padding: 1.5rem; display: flex; justify-content: center;">
        <img src={image} alt={title} style="max-width: 100%; max-height: 400px; object-fit: contain;" />
      </div>

      <div>
        <span style="background: #374151; color: white; font-size: 0.8rem; padding: 0.3rem 0.8rem; border-radius: 4px; font-weight: bold;">{brand}</span>
        <h1 style="font-size: 2rem; margin: 1rem 0; color: white; font-weight: 800; line-height: 1.2;">{title}</h1>

        <div style="background: #111827; padding: 1.2rem; border-radius: 8px; border: 1px solid #374151; margin-bottom: 1.5rem;">
          <span style="font-size: 0.8rem; color: #9ca3af; font-weight: bold; display: block;">B2B PRICE</span>
          <span style="font-size: 2.2rem; font-weight: 900; color: #10b981;">{price}</span>
        </div>

        <a href={`https://wa.me/38263256666?text=Order:%20${encodeURIComponent(title)}%20(${id})`} target="_blank" style="display: block; text-align: center; background: #059669; color: white; padding: 1rem; border-radius: 8px; text-decoration: none; font-weight: bold; font-size: 1.1rem;">
          💬 WhatsApp B2B Order
        </a>
      </div>
    </div>
  </main>
</body>
</html>
