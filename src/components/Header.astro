---
import { getPages, getTexts } from '../lib/sheets';

// URL'den aktif dili tespit et (tr, en, me)
const pathname = Astro.url.pathname;
let currentLang = 'tr';
if (pathname.startsWith('/en')) {
  currentLang = 'en';
} else if (pathname.startsWith('/me')) {
  currentLang = 'me';
}

const pages = await getPages();
const texts = await getTexts();

// Sadece Menüde = EVET ve Yayında = EVET olan sayfaları al, Sıra'ya göre sırala
const menuPages = pages
  .filter(p => p.Yayında === 'EVET' && p.Menüde === 'EVET')
  .sort((a, b) => Number(a.Sıra || 0) - Number(b.Sıra || 0));

// Metin çevirileri için yardımcı fonksiyon
function getText(key, defaultVal) {
  const found = texts.find(t => t.Anahtar === key);
  if (!found) return defaultVal;
  if (currentLang === 'en') return found.English || defaultVal;
  if (currentLang === 'me') return found.Crnogorski || defaultVal;
  return found.Türkçe || defaultVal;
}
---

<header class="site-header">
  <div class="container header-container">
    <div class="logo">
      <a href={currentLang === 'en' ? '/home' : currentLang === 'me' ? '/početna' : '/ana-sayfa'}>
        <strong>TURSKA PIJACA</strong>
      </a>
    </div>

    <nav class="main-nav">
      <ul>
        {menuPages.map((page) => {
          // Dile göre uygun adres sütununu seç
          let href = page['Adres TR'];
          if (currentLang === 'en') href = page['Adres EN'] || href;
          if (currentLang === 'me') href = page['Adres ME'] || href;

          // Menü başlığı için METINLER tablosundan çeviri al (örn: catalog.title -> Tüm ürünler)
          const titleKey = `${page.Kod}.title`;
          const menuTitle = getText(titleKey, page.Kod);

          return (
            <li>
              <a href={href}>{menuTitle}</a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: #fff;
    border-bottom: 1px solid #eaeaea;
    padding: 1rem 0;
  }
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .main-nav ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-nav a {
    text-decoration: none;
    color: #333;
    font-weight: 500;
  }
  .main-nav a:hover {
    color: #e53e3e;
  }
</style>
