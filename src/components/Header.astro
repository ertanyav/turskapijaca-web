---
import { getMenu, getLogoUrl, getTextDictionary } from '../lib/sheets';

const { pathname = '' } = Astro.url;
const segments = pathname.split('/').filter(Boolean);
const currentLang = ['tr', 'en', 'me'].includes(segments[0]) ? segments[0] : 'tr';

let menuItems = [], logoUrl = '', dict = {};
try {
  [menuItems, logoUrl, dict] = await Promise.all([
    getMenu(),
    getLogoUrl(),
    getTextDictionary(currentLang)
  ]);
} catch (e) {}

const languages = [
  { code: 'tr', label: 'TR' },
  { code: 'en', label: 'EN' },
  { code: 'me', label: 'ME' }
];

function getLangPath(targetCode) {
  if (segments.length === 0) return `/${targetCode}`;
  const newSegs = [...segments];
  if (['tr', 'en', 'me'].includes(newSegs[0])) newSegs[0] = targetCode;
  else newSegs.unshift(targetCode);
  return '/' + newSegs.join('/');
}

const cartText = dict['common.cart'] || (currentLang === 'en' ? 'Cart' : currentLang === 'me' ? 'Korpa' : 'Sepet');
const subtitleText = dict['header.subtitle'] || 'Turski Proizvodi';
---

<header class="main-header">
  <div class="header-container">
    <a href={`/${currentLang}`} class="logo-link">
      {logoUrl ? (
        <img src={logoUrl} alt="TURSKA PIJACA" class="site-logo" />
      ) : (
        <div class="logo-fallback-badge">TP</div>
      )}
      <div class="brand-text-wrap">
        <span class="brand-title">TURSKA PIJACA</span>
        <span class="brand-subtitle">{subtitleText}</span>
      </div>
    </a>

    <nav class="main-menu">
      <ul>
        {menuItems.map(item => {
          const name = item[`ad${currentLang}`] || item.adtr;
          const rawAddress = item[`adres${currentLang}`] || item.adrestr;
          if (!name || item.kod === 'home' || !rawAddress) return null;

          const cleanAddress = String(rawAddress).replace(/^\//, '');
          const finalPath = `/${currentLang}/${cleanAddress}`.toLowerCase();
          const hasChildren = item.children && item.children.length > 0;
          const isActive = pathname.toLowerCase().includes(cleanAddress.toLowerCase());

          return (
            <li class={`menu-item ${hasChildren ? 'has-dropdown' : ''}`}>
              <a href={finalPath} class={isActive ? 'active' : ''}>
                {name} {hasChildren && <span class="arrow">▾</span>}
              </a>
              {hasChildren && (
                <ul class="dropdown-menu">
                  {item.children.map(child => {
                    const childName = child[`ad${currentLang}`] || child.adtr;
                    const childAddr = child[`adres${currentLang}`] || child.adrestr;
                    return (
                      <li>
                        <a href={`/${currentLang}/${String(childAddr).replace(/^\//, '')}`.toLowerCase()}>
                          {childName}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-right">
      <button id="cart-button" class="cart-btn" aria-label="Sepet">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span>{cartText}</span>
        <span id="cart-count" class="cart-badge">0</span>
      </button>

      <div class="language-switcher">
        {languages.map(lang => (
          <a href={getLangPath(lang.code)} class={currentLang === lang.code ? 'active' : ''}>
            {lang.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<!-- Mobil Cihazlar İçin Sabit Alt Navigasyon (App-Like Bottom Bar) -->
<nav class="mobile-bottom-bar">
  <a href={`/${currentLang}`} class={pathname === `/${currentLang}` ? 'active' : ''}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    <span>{currentLang === 'en' ? 'Home' : currentLang === 'me' ? 'Početna' : 'Anasayfa'}</span>
  </a>
  <a href={`/${currentLang}/ürünler`} class={pathname.includes('urunler') || pathname.includes('products') ? 'active' : ''}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
    <span>{currentLang === 'en' ? 'Products' : currentLang === 'me' ? 'Proizvodi' : 'Ürünler'}</span>
  </a>
  <a href="#cart" id="mobile-cart-btn">
    <div class="icon-wrap">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      <span id="mobile-cart-count" class="mobile-badge">0</span>
    </div>
    <span>{cartText}</span>
  </a>
</nav>

<script>
  function updateCartCount() {
    const cart = JSON.parse(localStorage.getItem('tp_cart') || '[]');
    const count = cart.length;
    const countEl = document.getElementById('cart-count');
    const mobCountEl = document.getElementById('mobile-cart-count');
    if (countEl) countEl.innerText = count;
    if (mobCountEl) mobCountEl.innerText = count;
  }
  document.addEventListener('DOMContentLoaded', updateCartCount);
  window.addEventListener('storage', updateCartCount);
  window.addEventListener('cartUpdated', updateCartCount);

  const showCartMsg = () => alert("Sipariş Sepetiniz hazırlanıyor. B2B alımları için teklif oluşturabilirsiniz.");
  document.getElementById('cart-button')?.addEventListener('click', showCartMsg);
  document.getElementById('mobile-cart-btn')?.addEventListener('click', (e) => { e.preventDefault(); showCartMsg(); });
</script>

<style>
  .main-header {
    background: #0b2218;
    border-bottom: 1px solid rgba(197, 160, 89, 0.25);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }
  .header-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0.9rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
  }
  .site-logo {
    height: 46px;
    width: auto;
    object-fit: contain;
  }
  .logo-fallback-badge {
    width: 40px;
    height: 40px;
    background: #c5a059;
    color: #0b2218;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
  }
  .brand-text-wrap {
    display: flex;
    flex-direction: column;
  }
  .brand-title {
    color: #ffffff;
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.8px;
    line-height: 1.1;
  }
  .brand-subtitle {
    color: #c5a059;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-top: 2px;
  }
  .main-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.8rem;
    align-items: center;
  }
  .menu-item {
    position: relative;
    padding: 0.5rem 0;
  }
  .main-menu a {
    text-decoration: none;
    color: #cbd5e1;
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: 0.3px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .main-menu a:hover, .main-menu a.active {
    color: #c5a059;
  }
  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: #071710;
    border: 1px solid rgba(197, 160, 89, 0.3);
    border-radius: 6px;
    padding: 0.5rem 0;
    min-width: 220px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    flex-direction: column;
    z-index: 100;
  }
  .dropdown-menu a {
    padding: 0.65rem 1.2rem;
    color: #94a3b8;
    font-size: 0.88rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }
  .dropdown-menu a:hover {
    background: rgba(197, 160, 89, 0.12);
    color: #ffffff;
  }
  .has-dropdown:hover .dropdown-menu {
    display: flex;
  }
  .header-right {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .cart-btn {
    background: linear-gradient(135deg, #c5a059, #a37f3e);
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 700;
    cursor: pointer;
    color: #0b2218;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    box-shadow: 0 2px 10px rgba(197, 160, 89, 0.2);
    transition: transform 0.2s;
  }
  .cart-btn:hover {
    transform: translateY(-1px);
  }
  .cart-badge {
    background: #0b2218;
    color: #c5a059;
    padding: 0.15rem 0.45rem;
    border-radius: 12px;
    font-size: 0.75rem;
  }
  .language-switcher {
    display: flex;
    gap: 0.2rem;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.25rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .language-switcher a {
    color: #94a3b8;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s;
  }
  .language-switcher a.active {
    background: #c5a059;
    color: #0b2218;
  }

  /* Mobil Bottom Bar Styles */
  .mobile-bottom-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #0b2218;
    border-top: 1px solid rgba(197, 160, 89, 0.3);
    z-index: 9999;
    padding: 0.5rem 0;
    justify-content: space-around;
    align-items: center;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.3);
  }
  .mobile-bottom-bar a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.7rem;
    font-weight: 600;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }
  .mobile-bottom-bar a.active {
    color: #c5a059;
  }
  .icon-wrap {
    position: relative;
    display: flex;
  }
  .mobile-badge {
    position: absolute;
    top: -5px;
    right: -8px;
    background: #c5a059;
    color: #0b2218;
    font-size: 0.65rem;
    font-weight: 900;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .main-menu { display: none; }
    .mobile-bottom-bar { display: flex; }
    body { padding-bottom: 60px; }
  }
</style>
