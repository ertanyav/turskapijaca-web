---
const { lang = 'en', texts = {} } = Astro.props;

// Master METINLER tablosundan dinamik çekim
const siteTitle = 'TURSKA PIJACA';
const wholesaleSub = 'UNIVERCERT MNE D.O.O. · Seda Gıda Official Representative';

const logoUrl = 'https://lh3.googleusercontent.com/d/14BFS24JrQOpz1ALBLzUGd0T-0Jw4c0jy=w200';

const navCatalog = texts['ui.fullCatalog']?.[lang] || 'Ürün Kataloğu';
const navAbout = texts['ui.company']?.[lang] || 'Kurumsal & Lojistik';
---

<header style="background: #173f31; color: #f0f4ed; border-bottom: 3px solid #d9b871; position: sticky; top: 0; z-index: 1000; box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
  <!-- Top Bar -->
  <div style="background: #0d221a; font-size: 0.8rem; padding: 0.4rem 1.5rem; border-bottom: 1px solid #234d3c;">
    <div style="max-width: 1280px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
      <div style="color: #d9b871; display: flex; gap: 1.2rem; font-weight: 600;">
        <span>🏢 UNIVERCERT MNE D.O.O.</span>
        <span>🚚 Weekly Direct Factory Transfer (Seda Gıda)</span>
      </div>
      <div style="display: flex; gap: 0.8rem; align-items: center;">
        <span style="color: #a3c2b5; font-size: 0.75rem;">Domains:</span>
        <a href="https://www.turskapijaca.com/en/" target="_self" style={`color: ${lang === 'en' ? '#d9b871' : '#a3c2b5'}; text-decoration: none; font-weight: bold;`}>Global (.com)</a>
        <a href="https://www.turskapijaca.me/me/" target="_self" style={`color: ${lang === 'me' ? '#d9b871' : '#a3c2b5'}; text-decoration: none; font-weight: bold;`}>Montenegro (.me)</a>
        <a href="https://www.turskapijaca.com.tr/tr/" target="_self" style={`color: ${lang === 'tr' ? '#d9b871' : '#a3c2b5'}; text-decoration: none; font-weight: bold;`}>Türkiye (.com.tr)</a>
      </div>
    </div>
  </div>

  <!-- Main Header -->
  <div style="max-width: 1280px; margin: 0 auto; padding: 0.8rem 1.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
    <!-- Logo & Title -->
    <a href={`/${lang}/`} target="_self" style="color: white; font-weight: 800; font-size: 1.5rem; text-decoration: none; display: flex; align-items: center; gap: 0.8rem;">
      <img src={logoUrl} alt="TURSKA PIJACA Logo" style="height: 48px; width: auto; object-fit: contain; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));" onerror="this.style.display='none'; document.getElementById('altLogo').style.display='flex';" />
      <div id="altLogo" style="display: none; background: #d9b871; color: #173f31; padding: 0.3rem 0.6rem; border-radius: 6px; font-weight: 900;">TP</div>
      <div>
        <span style="color: #f0f4ed; letter-spacing: -0.5px; display: block; font-size: 1.4rem;">{siteTitle}</span>
        <span style="font-size: 0.7rem; color: #d9b871; font-weight: 500; display: block; margin-top: -2px;">{wholesaleSub}</span>
      </div>
    </a>

    <!-- Nav & B2B Cart Button -->
    <nav style="display: flex; gap: 1.5rem; align-items: center;">
      <a href={`/${lang}/`} target="_self" style="color: #f0f4ed; text-decoration: none; font-weight: 600; font-size: 0.95rem;">{navCatalog}</a>
      <a href={`/${lang}/about`} target="_self" style="color: #a3c2b5; text-decoration: none; font-weight: 600; font-size: 0.95rem;">{navAbout}</a>
      
      <!-- B2B Sepet Açma Butonu -->
      <button id="openCartBtn" style="background: #d9b871; color: #173f31; border: none; padding: 0.55rem 1.1rem; border-radius: 8px; font-weight: 800; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; box-shadow: 0 2px 10px rgba(217,184,113,0.3);">
        🛒 <span>Sepetim</span>
        <span id="cartBadge" style="background: #173f31; color: #d9b871; padding: 0.15rem 0.5rem; border-radius: 20px; font-size: 0.75rem; font-weight: 900;">0</span>
      </button>
    </nav>
  </div>
</header>
