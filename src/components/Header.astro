---
import { getMenu, getLogoUrl, getTextDictionary } from '../lib/sheets';

const { pathname = '' } = Astro.url;
const segments = pathname.split('/').filter(Boolean);
const currentLang = ['tr', 'en', 'me'].includes(segments[0]) ? segments[0] : 'tr';

let menuItems = [];
let logoUrl = '';
let dict = {};

try {
  [menuItems, logoUrl, dict] = await Promise.all([getMenu(), getLogoUrl(), getTextDictionary(currentLang)]);
} catch (e) {}

const languages = [ { code: 'tr', label: 'TR' }, { code: 'en', label: 'EN' }, { code: 'me', label: 'ME' } ];
function getLangPath(targetLangCode) {
  if (segments.length === 0) return `/${targetLangCode}`;
  const newSegments = [...segments];
  if (['tr', 'en', 'me'].includes(newSegments[0])) newSegments[0] = targetLangCode;
  else newSegments.unshift(targetLangCode);
  return '/' + newSegments.join('/');
}

// METINLER'den Sepet yazısını çekiyoruz
const cartText = dict['common.cart'] || dict['ortak.sepet'] || (currentLang === 'en' ? 'Cart' : currentLang === 'me' ? 'Korpa' : 'Sepet');
---

<header class="main-header">
  <div class="header-container">
    <a href={`/${currentLang}`} class="logo-link">
      {logoUrl && <img src={logoUrl} alt="TURSKA PIJACA" class="site-logo" />}
      <div class="brand-text-wrap">
        <span class="brand-title">TURSKA PIJACA</span>
        <span class="brand-subtitle">{dict['header.subtitle'] || 'Turski Proizvodi'}</span>
      </div>
    </a>

    <nav class="main-menu">
      <ul>
        {menuItems.map(item => {
          const name = item[`ad${currentLang}`] || item.adtr;
          const rawAddress = item[`adres${currentLang}`] || item.adrestr;
          if (!name || item.kod === 'home' || !rawAddress) return null;

          const cleanAddress = String(rawAddress).replace(/^\//, '');
          const finalPath = `/${currentLang}/${cleanAddress}`.toLowerCase();
          const hasChildren = item.children && item.children.length > 0;

          return (
            <li class={`menu-item ${hasChildren ? 'has-dropdown' : ''}`}>
              <a href={finalPath}>{name} {hasChildren && <span class="arrow">▾</span>}</a>
              {hasChildren && (
                <ul class="dropdown-menu">
                  {item.children.map(child => {
                    const childName = child[`ad${currentLang}`] || child.adtr;
                    const childAddr = child[`adres${currentLang}`] || child.adrestr;
                    return <li><a href={`/${currentLang}/${String(childAddr).replace(/^\//, '')}`.toLowerCase()}>{childName}</a></li>;
                  })}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-right">
      <button id="cart-button" class="cart-btn">
        🛒 <span>{cartText}</span> (<span id="cart-count">0</span>)
      </button>
      <div class="language-switcher">
        {languages.map(lang => (
          <a href={getLangPath(lang.code)} class={currentLang === lang.code ? 'active' : ''}>{lang.label}</a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  function updateCartCount() {
    const cart = JSON.parse(localStorage.getItem('tp_cart') || '[]');
    const countEl = document.getElementById('cart-count');
    if (countEl) countEl.innerText = cart.length;
  }
  document.addEventListener('DOMContentLoaded', updateCartCount);
  window.addEventListener('storage', updateCartCount);
  window.addEventListener('cartUpdated', updateCartCount);

  document.getElementById('cart-button')?.addEventListener('click', () => {
    alert("Sepet sistemi yakında B2B sipariş modülü ile devreye alınacaktır.");
  });
</script>

<style>
  .main-header { background: #0b2218; border-bottom: 1px solid rgba(255,255,255,0.1); position: sticky; top: 0; z-index: 1000; }
  .header-container { max-width: 1300px; margin: 0 auto; padding: 0.8rem 1.5rem; display: flex; justify-content: space-between; align-items: center; }
  .logo-link { display: flex; align-items: center; gap: 0.8rem; text-decoration: none; }
  .site-logo { height: 44px; object-fit: contain; }
  .brand-text-wrap { display: flex; flex-direction: column; }
  .brand-title { color: #ffffff; font-weight: 800; font-size: 1.25rem; }
  .brand-subtitle { color: #34d399; font-size: 0.75rem; font-weight: 600; }
  .main-menu ul { list-style: none; padding: 0; margin: 0; display: flex; gap: 1.5rem; }
  .menu-item { position: relative; }
  .main-menu a { text-decoration: none; color: #cbd5e1; font-weight: 500; font-size: 0.95rem; padding: 0.5rem 0; display: flex; gap: 0.3rem; }
  .main-menu a:hover { color: #34d399; }
  .dropdown-menu { display: none; position: absolute; top: 100%; left: 0; background: #06150f; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 0.5rem 0; min-width: 200px; flex-direction: column; }
  .dropdown-menu a { padding: 0.6rem 1.2rem; }
  .has-dropdown:hover .dropdown-menu { display: flex; }
  .header-right { display: flex; gap: 1rem; align-items: center; }
  .cart-btn { background: #34d399; border: none; padding: 0.4rem 0.8rem; border-radius: 6px; font-weight: 700; cursor: pointer; color: #0b2218; display: flex; gap: 0.4rem; }
  .language-switcher { display: flex; gap: 0.3rem; background: rgba(255,255,255,0.08); padding: 0.25rem; border-radius: 6px; }
  .language-switcher a { color: #94a3b8; font-size: 0.78rem; font-weight: 700; padding: 0.25rem 0.55rem; text-decoration: none; }
  .language-switcher a.active { background: #34d399; color: #0b2218; border-radius: 4px; }
</style>
