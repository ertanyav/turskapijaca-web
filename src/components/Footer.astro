---
import { getTextDictionary } from '../lib/sheets';

const { lang = 'tr' } = Astro.props;
const dict = await getTextDictionary(lang);

const tagline = dict['footer.tagline'] || 'From Türkiye to Montenegro. Direct supply, strong distribution.';
const phone = dict['contact.phone'] || '+382 63 256 666';
const email = dict['contact.email'] || 'info@turskapijaca.com';
const company = dict['company.full_name'] || 'UNIVERCERT-MNE D.O.O.';
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-brand">
      <h3>TURSKA PIJACA</h3>
      <p class="company-name">{company}</p>
      <p class="tagline">{tagline}</p>
    </div>

    <div class="footer-contact">
      <h4>{dict['footer.contact'] || 'İletişim'}</h4>
      <p>📞 {phone}</p>
      <p>✉️ {email}</p>
      <p>📍 Montenegro</p>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} TURSKA PIJACA — UNIVERCERT-MNE D.O.O. Tüm Hakları Saklıdır.</p>
  </div>
</footer>

<style>
  .site-footer { background: #071710; color: #94a3b8; border-top: 1px solid rgba(255,255,255,0.1); padding: 3rem 1.5rem 1.5rem; margin-top: 4rem; }
  .footer-container { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
  .footer-brand h3 { color: #ffffff; margin: 0 0 0.4rem; font-size: 1.4rem; font-weight: 800; }
  .company-name { color: #34d399; font-weight: 700; font-size: 0.88rem; margin: 0 0 0.8rem; }
  .tagline { color: #cbd5e1; font-size: 0.95rem; line-height: 1.6; }
  .footer-contact h4 { color: #ffffff; margin: 0 0 1rem; font-size: 1.05rem; }
  .footer-contact p { margin: 0.4rem 0; font-size: 0.9rem; }
  .footer-bottom { max-width: 1280px; margin: 2rem auto 0; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.06); text-align: center; font-size: 0.8rem; }
</style>
