---
import { getPages, getTexts } from '../lib/sheets';

// URL'den aktif dili tespit et
const pathname = Astro.url.pathname;
let currentLang = 'tr';
if (pathname.startsWith('/en')) {
  currentLang = 'en';
} else if (pathname.startsWith('/me')) {
  currentLang = 'me';
}

const pages = await getPages();
const texts = await getTexts();

// Master SAYFALAR tablosundan Menüde = EVET olanları Sıra'ya göre al
const menuPages = pages
  .filter(p => p.Yayında === 'EVET' && p.Menüde === 'EVET')
  .sort((a, b) => Number(a.Sıra || 0) - Number(b.Sıra || 0));

// Metin çevirileri için yardımcı fonksiyon
function getText(key, defaultVal) {
  const found = texts.find(t => t.Anahtar === key);
  if (!found) return defaultVal;
  if (currentLang === 'en') return found.English || defaultVal;
  if (currentLang === 'me') return found.Crnogorski || defaultVal;
  return found.Türkçe || defaultVal;
}
---

<header class="site-header">
  <div class="header-container">
    <!-- Sol Kısım: Logo ve Marka -->
    <div class="logo-area">
      <a href={`/${currentLang}`} class="logo-link">
        <span class="logo-text">TURSKA PIJACA</span>
      </a>
    </div>

    <!-- Orta Kısım: Dinamik Ana Menü -->
    <nav class="main-nav">
      <ul>
        {menuPages.map((page) => {
          // Master dosyadaki ilgili dil adresini al
          let subPath = page['Adres TR'];
          if (currentLang === 'en') subPath = page['Adres EN'] || subPath;
          if (currentLang === 'me') subPath = page['Adres ME'] || subPath;

          // Rotalama temizliği ve [lang] uyumu (404'leri önlemek için)
          // Örneğin /ana-sayfa yerine doğrudan /tr veya /en/home yapısı
          let href = `/${currentLang}${subPath.startsWith('/') ? subPath : '/' + subPath}`;
          if (subPath === '/ana-sayfa' || subPath === '/home' || subPath === '/početna') {
            href = `/${currentLang}`;
          }

          const titleKey = `${page.Kod}.title`;
          const menuTitle = getText(titleKey, page.Kod);

          return (
            <li>
              <a href={href}>{menuTitle}</a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Sağ Kısım: Dil Seçim Düğmeleri -->
    <div class="lang-switcher">
      <a href="/tr" class={currentLang === 'tr' ? 'active' : ''}>TR</a>
      <span class="divider">|</span>
      <a href="/en" class={currentLang === 'en' ? 'active' : ''}>EN</a>
      <span class="divider">|</span>
      <a href="/me" class={currentLang === 'me' ? 'active' : ''}>ME</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    background: transparent;
    padding: 1rem 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }
  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo-link {
    text-decoration: none;
  }
  .logo-text {
    color: #ffffff;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.5px;
  }
  .main-nav ul {
    display: flex;
    list-style: none;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }
  .main-nav a {
    color: #cbd5e1;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 400;
    transition: color 0.2s;
  }
  .main-nav a:hover {
    color: #ffffff;
  }
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
  }
  .lang-switcher a {
    color: #94a3b8;
    text-decoration: none;
    font-weight: 500;
  }
  .lang-switcher a.active {
    color: #ffffff;
    font-weight: 700;
    text-decoration: underline;
  }
  .lang-switcher .divider {
    color: #475569;
  }
</style>
