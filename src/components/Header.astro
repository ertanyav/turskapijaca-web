---
import { getMenu, getLogoUrl, getTextDictionary } from '../lib/sheets';

const pathname = Astro.url.pathname;
const segments = pathname.split('/').filter(Boolean);

const supportedLanguages = ['tr', 'en', 'me'];
const currentLang = supportedLanguages.includes(segments[0])
  ? segments[0]
  : 'tr';

let menuItems = [];
let logoUrl = '';
let dict = {};

try {
  [menuItems, logoUrl, dict] = await Promise.all([
    getMenu(),
    getLogoUrl(),
    getTextDictionary(currentLang)
  ]);
} catch (error) {
  console.error('Header verileri yüklenemedi:', error);
  menuItems = [];
  logoUrl = '';
  dict = {};
}

const languages = [
  { code: 'tr', label: 'TR' },
  { code: 'en', label: 'EN' },
  { code: 'me', label: 'ME' }
];

function getText(key, fallback) {
  return dict?.[key] || fallback;
}

function getLanguagePath(targetLanguage) {
  const newSegments = [...segments];

  if (supportedLanguages.includes(newSegments[0])) {
    newSegments[0] = targetLanguage;
  } else {
    newSegments.unshift(targetLanguage);
  }

  return `/${newSegments.join('/')}`;
}

function getItemName(item) {
  return item?.[`ad${currentLang}`] || item?.adtr || '';
}

function getItemAddress(item) {
  return item?.[`adres${currentLang}`] || item?.adrestr || '';
}

function getItemPath(item) {
  const address = String(getItemAddress(item))
    .replace(/^\/+/, '')
    .replace(/\/+$/, '');

  return address ? `/${currentLang}/${address}` : `/${currentLang}`;
}

const cartText = getText(
  'common.cart',
  currentLang === 'en'
    ? 'Cart'
    : currentLang === 'me'
      ? 'Korpa'
      : 'Sepet'
);

const checkoutText = getText(
  'cart.checkout',
  currentLang === 'en'
    ? 'Complete order'
    : currentLang === 'me'
      ? 'Naruči'
      : 'Siparişi tamamla'
);

const emptyCartText = getText(
  'cart.empty',
  currentLang === 'en'
    ? 'Cart is empty'
    : currentLang === 'me'
      ? 'Korpa je prazna'
      : 'Sepetiniz boş'
);

const productCodeText = getText(
  'product.code',
  currentLang === 'en'
    ? 'Code'
    : currentLang === 'me'
      ? 'Šifra'
      : 'Kod'
);

const menuText =
  currentLang === 'en'
    ? 'Menu'
    : currentLang === 'me'
      ? 'Meni'
      : 'Menü';

const phone = String(dict?.['contact.phone'] || '38263256666')
  .replace(/[^0-9]/g, '');

const visibleMenuItems = Array.isArray(menuItems)
  ? menuItems.filter((item) => {
      const name = getItemName(item);
      const address = getItemAddress(item);

      return (
        name &&
        address &&
        String(item?.kod || '').toLowerCase() !== 'home'
      );
    })
  : [];
---

<header class="site-header">
  <div class="header-inner">
    <a
      class="logo-link"
      href={`/${currentLang}`}
      aria-label="TURSKA PIJACA"
    >
      {logoUrl ? (
        <img
          class="site-logo"
          src={logoUrl}
          alt="TURSKA PIJACA"
          width="180"
          height="52"
        />
      ) : (
        <span class="logo-text">TURSKA PIJACA</span>
      )}
    </a>

    <button
      id="mobile-menu-button"
      class="mobile-menu-button"
      type="button"
      aria-label={menuText}
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav
      id="main-navigation"
      class="main-navigation"
      aria-label={menuText}
    >
      <ul class="main-menu">
        {visibleMenuItems.map((item) => {
          const name = getItemName(item);
          const address = getItemAddress(item);
          const children = Array.isArray(item?.children)
            ? item.children.filter((child) => {
                return getItemName(child) && getItemAddress(child);
              })
            : [];

          return (
            <li class:list-item={true} class:list-has-children={children.length > 0}>
              <a class="menu-link" href={getItemPath(item)}>
                <span>{name}</span>
                {children.length > 0 && (
                  <span class="menu-arrow" aria-hidden="true">▾</span>
                )}
              </a>

              {children.length > 0 && (
                <ul class="submenu">
                  {children.map((child) => (
                    <li>
                      <a class="submenu-link" href={getItemPath(child)}>
                        {getItemName(child)}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-actions">
      <button
        id="cart-button"
        class="cart-button"
        type="button"
        aria-label={cartText}
        aria-expanded="false"
        aria-controls="cart-panel"
      >
        <svg
          width="21"
          height="21"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path>
        </svg>

        <span id="cart-count" class="cart-count" hidden>0</span>
      </button>

      <div class="language-switcher" aria-label="Language selection">
        {languages.map((language) => (
          <a
            href={getLanguagePath(language.code)}
            class:active-language={currentLang === language.code}
            aria-current={currentLang === language.code ? 'page' : undefined}
          >
            {language.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<div id="mobile-menu-overlay" class="mobile-menu-overlay"></div>

<aside
  id="cart-panel"
  class="cart-panel"
  aria-hidden="true"
  aria-label={cartText}
>
  <div class="cart-panel-header">
    <h2>{cartText}</h2>

    <button
      id="close-cart-button"
      class="close-cart-button"
      type="button"
      aria-label={currentLang === 'en' ? 'Close cart' : 'Sepeti kapat'}
    >
      ×
    </button>
  </div>

  <div id="cart-items" class="cart-items"></div>

  <div class="cart-panel-footer">
    <button
      id="checkout-button"
      class="checkout-button"
      type="button"
      data-phone={phone}
    >
      {checkoutText}
    </button>
  </div>
</aside>

<div id="cart-overlay" class="cart-overlay"></div>

<script define:vars={{ emptyCartText, productCodeText }}>
  const STORAGE_KEY = 'tp_cart';
  const FALLBACK_IMAGE = 'https://via.placeholder.com/70';

  let cart = [];

  function readCart() {
    try {
      const saved = JSON.parse(
        localStorage.getItem(STORAGE_KEY) || '[]'
      );

      if (!Array.isArray(saved)) return [];

      return saved
        .filter((item) => item && item.id)
        .map((item) => ({
          id: String(item.id),
          name: String(item.name || ''),
          img: String(item.img || ''),
          qty: Math.max(1, Number(item.qty) || 1)
        }));
    } catch {
      return [];
    }
  }

  function saveCart() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
  }

  function totalQuantity() {
    return cart.reduce((total, item) => total + item.qty, 0);
  }

  function updateCartCount() {
    const countElement = document.getElementById('cart-count');

    if (!countElement) return;

    const count = totalQuantity();

    countElement.textContent = String(count);
    countElement.hidden = count === 0;
  }

  function createElement(tag, className, text = '') {
    const element = document.createElement(tag);

    if (className) {
      element.className = className;
    }

    if (text) {
      element.textContent = text;
    }

    return element;
  }

  function renderCart() {
    const container = document.getElementById('cart-items');

    updateCartCount();

    if (!container) return;

    container.replaceChildren();

    if (cart.length === 0) {
      container.appendChild(
        createElement('p', 'empty-cart-message', emptyCartText)
      );
      return;
    }

    cart.forEach((item, index) => {
      const row = createElement('div', 'cart-item');

      const image = document.createElement('img');
      image.src = item.img || FALLBACK_IMAGE;
      image.alt = item.name;
      image.width = 70;
      image.height = 70;
      image.loading = 'lazy';

      image.addEventListener(
        'error',
        () => {
          image.src = FALLBACK_IMAGE;
        },
        { once: true }
      );

      const details = createElement('div', 'cart-item-details');
      const name = createElement('strong', 'cart-item-name', item.name);
      const code = createElement(
        'small',
        'cart-item-code',
        `${productCodeText}: ${item.id}`
      );

      const controls = createElement('div', 'quantity-controls');

      const decrease = createElement('button', 'quantity-button', '−');
      decrease.type = 'button';
      decrease.dataset.index = String(index);
      decrease.dataset.change = '-1';
      decrease.setAttribute('aria-label', 'Decrease quantity');

      const quantity = createElement(
        'span',
        'quantity-value',
        String(item.qty)
      );

      const increase = createElement('button', 'quantity-button', '+');
      increase.type = 'button';
      increase.dataset.index = String(index);
      increase.dataset.change = '1';
      increase.setAttribute('aria-label', 'Increase quantity');

      controls.append(decrease, quantity, increase);
      details.append(name, code, controls);
      row.append(image, details);
      container.appendChild(row);
    });
  }

  function openCart() {
    document.getElementById('cart-panel')?.classList.add('open');
    document.getElementById('cart-overlay')?.classList.add('open');
    document.getElementById('cart-button')?.setAttribute(
      'aria-expanded',
      'true'
    );
    document.getElementById('cart-panel')?.setAttribute(
      'aria-hidden',
      'false'
    );

    renderCart();
  }

  function closeCart() {
    document.getElementById('cart-panel')?.classList.remove('open');
    document.getElementById('cart-overlay')?.classList.remove('open');
    document.getElementById('cart-button')?.setAttribute(
      'aria-expanded',
      'false'
    );
    document.getElementById('cart-panel')?.setAttribute(
      'aria-hidden',
      'true'
    );
  }

  function updateQuantity(index, change) {
    if (!cart[index]) return;

    cart[index].qty += change;

    if (cart[index].qty <= 0) {
      cart.splice(index, 1);
    }

    saveCart();
    renderCart();
  }

  function toggleMobileMenu() {
    const navigation = document.getElementById('main-navigation');
    const button = document.getElementById('mobile-menu-button');
    const overlay = document.getElementById('mobile-menu-overlay');

    const isOpen = navigation?.classList.toggle('mobile-open');

    button?.setAttribute('aria-expanded', String(Boolean(isOpen)));
    overlay?.classList.toggle('open', Boolean(isOpen));
    document.body.classList.toggle('menu-open', Boolean(isOpen));
  }

  function closeMobileMenu() {
    document.getElementById('main-navigation')?.classList.remove(
      'mobile-open'
    );
    document.getElementById('mobile-menu-overlay')?.classList.remove('open');
    document.getElementById('mobile-menu-button')?.setAttribute(
      'aria-expanded',
      'false'
    );
    document.body.classList.remove('menu-open');
  }

  cart = readCart();

  document
    .getElementById('cart-button')
    ?.addEventListener('click', openCart);

  document
    .getElementById('close-cart-button')
    ?.addEventListener('click', closeCart);

  document
    .getElementById('cart-overlay')
    ?.addEventListener('click', closeCart);

  document
    .getElementById('mobile-menu-button')
    ?.addEventListener('click', toggleMobileMenu);

  document
    .getElementById('mobile-menu-overlay')
    ?.addEventListener('click', closeMobileMenu);

  document
    .getElementById('cart-items')
    ?.addEventListener('click', (event) => {
      const button = event.target.closest('.quantity-button');

      if (!button) return;

      const index = Number(button.dataset.index);
      const change = Number(button.dataset.change);

      if (!Number.isInteger(index) || !Number.isFinite(change)) return;

      updateQuantity(index, change);
    });

  document
    .getElementById('checkout-button')
    ?.addEventListener('click', (event) => {
      if (cart.length === 0) return;

      const phone = event.currentTarget.dataset.phone || '';

      const products = cart.map((item) => {
        return `- ${item.name} (${productCodeText}: ${item.id}) x ${item.qty}`;
      });

      const message = [
        'Merhaba, aşağıdaki ürünler için toptan sipariş/teklif talep ediyorum:',
        '',
        ...products
      ].join('\n');

      window.open(
        `https://wa.me/${phone}?text=${encodeURIComponent(message)}`,
        '_blank',
        'noopener,noreferrer'
      );
    });

  document
    .getElementById('main-navigation')
    ?.addEventListener('click', (event) => {
      if (event.target.closest('a')) {
        closeMobileMenu();
      }
    });

  renderCart();
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.06);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: min(100% - 2rem, 1280px);
    min-height: 76px;
    margin: 0 auto;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    color: #0b2218;
    text-decoration: none;
  }

  .site-logo {
    display: block;
    width: 180px;
    height: 52px;
    object-fit: contain;
  }

  .logo-text {
    font-size: 1.15rem;
    font-weight: 900;
    white-space: nowrap;
  }

  .main-navigation {
    margin-left: auto;
  }

  .main-menu {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list-item {
    position: relative;
  }

  .menu-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.75rem 0.65rem;
    color: #0f172a;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    border-radius: 7px;
  }

  .menu-link:hover,
  .menu-link:focus-visible {
    color: #047857;
    background: #ecfdf5;
  }

  .menu-arrow {
    font-size: 0.7rem;
  }

  .submenu {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0;
    display: none;
    min-width: 220px;
    margin: 0;
    padding: 0.45rem;
    list-style: none;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.14);
  }

  .list-has-children:hover > .submenu,
  .list-has-children:focus-within > .submenu {
    display: block;
  }

  .submenu-link {
    display: block;
    padding: 0.65rem 0.7rem;
    color: #334155;
    font-size: 0.88rem;
    line-height: 1.35;
    text-decoration: none;
    border-radius: 6px;
  }

  .submenu-link:hover,
  .submenu-link:focus-visible {
    color: #047857;
    background: #ecfdf5;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  .cart-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    padding: 0;
    color: #0f172a;
    cursor: pointer;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 50%;
  }

  .cart-button:hover {
    color: #047857;
    border-color: #10b981;
    background: #ecfdf5;
  }

  .cart-count {
    position: absolute;
    top: -5px;
    right: -5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 19px;
    height: 19px;
    padding: 0 4px;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    background: #dc2626;
    border: 2px solid #ffffff;
    border-radius: 999px;
  }

  .cart-count[hidden] {
    display: none;
  }

  .language-switcher {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .language-switcher a {
    padding: 0.35rem 0.4rem;
    color: #64748b;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 5px;
  }

  .language-switcher a:hover,
  .language-switcher a.active-language {
    color: #047857;
    background: #ecfdf5;
  }

  .mobile-menu-button {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 42px;
    height: 42px;
    padding: 0;
    cursor: pointer;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 7px;
  }

  .mobile-menu-button span {
    display: block;
    width: 21px;
    height: 2px;
    background: #0f172a;
    border-radius: 2px;
  }

  .cart-panel {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 1200;
    display: flex;
    flex-direction: column;
    width: min(390px, 100%);
    height: 100vh;
    padding: 1.25rem;
    background: #ffffff;
    transform: translateX(100%);
    transition: transform 0.25s ease;
  }

  .cart-panel.open {
    transform: translateX(0);
  }

  .cart-overlay,
  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 1100;
    display: none;
    background: rgba(15, 23, 42, 0.48);
  }

  .cart-overlay.open,
  .mobile-menu-overlay.open {
    display: block;
  }

  .cart-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .cart-panel-header h2 {
    margin: 0;
    color: #0f172a;
    font-size: 1.25rem;
  }

  .close-cart-button {
    padding: 0.2rem 0.55rem;
    color: #475569;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    background: transparent;
    border: 0;
  }

  .cart-items {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0;
  }

  .empty-cart-message {
    color: #64748b;
    text-align: center;
  }

  .cart-item {
    display: flex;
    gap: 0.75rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid #e2e8f0;
  }

  .cart-item img {
    width: 70px;
    height: 70px;
    flex-shrink: 0;
    object-fit: contain;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
  }

  .cart-item-details {
    min-width: 0;
  }

  .cart-item-name {
    display: block;
    color: #0f172a;
    line-height: 1.35;
  }

  .cart-item-code {
    display: block;
    margin-top: 0.2rem;
    color: #64748b;
  }

  .quantity-controls {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 0.55rem;
  }

  .quantity-button {
    width: 28px;
    height: 28px;
    cursor: pointer;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
  }

  .cart-panel-footer {
    padding-top: 1rem;
    border-top: 1px solid #e2e8f0;
  }

  .checkout-button {
    width: 100%;
    padding: 0.85rem 1rem;
    color: #ffffff;
    font-weight: 700;
    cursor: pointer;
    background: #047857;
    border: 0;
    border-radius: 8px;
  }

  .checkout-button:hover {
    background: #065f46;
  }

  @media (max-width: 950px) {
    .header-inner {
      min-height: 68px;
    }

    .mobile-menu-button {
      display: inline-flex;
      order: 2;
    }

    .logo-link {
      order: 1;
      margin-right: auto;
    }

    .header-actions {
      order: 3;
    }

    .main-navigation {
      position: fixed;
      top: 68px;
      left: 0;
      z-index: 1150;
      width: min(320px, 86vw);
      height: calc(100vh - 68px);
      margin: 0;
      padding: 1rem;
      overflow-y: auto;
      background: #ffffff;
      box-shadow: 8px 0 24px rgba(15, 23, 42, 0.12);
      transform: translateX(-105%);
      transition: transform 0.25s ease;
    }

    .main-navigation.mobile-open {
      transform: translateX(0);
    }

    .main-menu {
      display: block;
    }

    .list-item {
      display: block;
    }

    .menu-link {
      display: flex;
      justify-content: space-between;
      width: 100%;
    }

    .submenu {
      position: static;
      display: block;
      min-width: 0;
      margin: 0.2rem 0 0.5rem 0.75rem;
      padding: 0 0 0 0.5rem;
      border: 0;
      border-left: 2px solid #d1fae5;
      box-shadow: none;
    }

    .site-logo {
      width: 145px;
      height: 44px;
    }
  }

  @media (max-width: 520px) {
    .header-inner {
      width: calc(100% - 1rem);
      gap: 0.45rem;
    }

    .language-switcher {
      display: none;
    }

    .site-logo {
      width: 130px;
    }
  }
</style>
