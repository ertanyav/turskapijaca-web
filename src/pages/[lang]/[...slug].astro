---
import Header from '../../components/Header.astro';
import { getPages } from '../../lib/sheets';

const { lang, slug } = Astro.params;
const validLangs = ['tr', 'en', 'me'];

if (!validLangs.includes(lang)) {
  return Astro.redirect('/tr');
}

const pages = await getPages();

// Gelen URL adresini, Google Sheet'teki sütunlarla eşleştirme
const currentPage = pages.find(p => {
  const pathStr = p[`adres${lang}`] || p['adrestr'] || p.kod;
  if (!pathStr) return false;
  // Tabloda başa slash (/) konmuşsa bile onu temizleyip hatasız kıyaslama yapıyoruz
  const cleanPath = String(pathStr).replace(/^\//, '').toLowerCase();
  return cleanPath === (slug || '').toLowerCase();
});

// Ziyaretçi tabloda OLMAYAN uydurma bir linke girerse, 404 hata sayfası yerine ana sayfaya döndür
if (!currentPage) {
  return Astro.redirect(`/${lang}`);
}

const pageTitle = currentPage[`ad${lang}`] || currentPage['adtr'] || currentPage.kod;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle} | TURSKA PIJACA</title>
  </head>
  <body style="margin: 0; font-family: system-ui, sans-serif; background: #f8fafc;">
    <Header />
    <main style="max-width: 1200px; margin: 3rem auto; padding: 2rem; background: white; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
      <h1 style="color: #0b2218; font-size: 2.2rem; border-bottom: 2px solid #eaeaea; padding-bottom: 1rem;">
        {pageTitle}
      </h1>
      <div style="margin-top: 2rem; color: #475569; line-height: 1.6;">
        <p>Sayfa Kodu: <strong style="background: #e2e8f0; padding: 4px 8px; border-radius: 4px; color:#0b2218;">{currentPage.kod}</strong></p>
        <p>Sihirli sayfa yönlendiricisi devrede! İçerikler, tablondaki bu satırdan ekrana basılacak.</p>
      </div>
    </main>
  </body>
</html>
