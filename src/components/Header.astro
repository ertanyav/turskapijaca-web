---
import { getPages, getTexts, getSettings } from '../lib/sheets';

const pathname = Astro.url.pathname;
let currentLang = 'tr';
if (pathname.startsWith('/en')) currentLang = 'en';
else if (pathname.startsWith('/me')) currentLang = 'me';

const [pages, texts, settings] = await Promise.all([getPages(), getTexts(), getSettings()]);

// AYARLAR sekmesinden Logo Çekimi
const logoSetting = settings.find(s => s.Anahtar === 'logo');
const logoUrl = logoSetting ? logoSetting.Değer : '';

// SAYFALAR tablosundan Menüde=EVET olanları Sıra'ya göre diz
const menuPages = pages
  .filter(p => p.Yayında?.trim() === 'EVET' && p.Menüde?.trim() === 'EVET')
  .sort((a, b) => Number(a.Sıra || 0) - Number(b.Sıra || 0));

function getText(key, defaultVal) {
  const found = texts.find(t => t.Anahtar === key);
  if (!found) return defaultVal;
  if (currentLang === 'en') return found.English || defaultVal;
  if (currentLang === 'me') return found.Crnogorski || defaultVal;
  return found.Türkçe || defaultVal;
}
---

<header class="site-header">
  <div class="header-container">
    <!-- Logo Alanı -->
    <div class="logo-area">
      <a href={`/${currentLang}`} class="logo-link" aria-label="Ana Sayfa">
        <!-- Logo varsa resmi yükle, yoksa yedek metin göster -->
        {logoUrl && (
          <img src={logoUrl} alt="TURSKA PIJACA" class="logo-img" onerror="this.style.display='none'; document.getElementById('fallback-logo').style.display='block';" />
        )}
        <span id="fallback-logo" class="logo-text" style={logoUrl ? "display:none;" : ""}>TURSKA PIJACA</span>
      </a>
    </div>

    <!-- Menü Alanı (Canlı Site ile Birebir) -->
    <nav class="main-nav">
      <ul>
        {menuPages.map((page) => {
          // ÖNEMLİ: 404 hatasını çözen fiziksel rotalama. 
          // Çeviri adresi yerine Astro'nun dosya ismine (Kod) gidiyoruz (örn: /tr/network)
          let href = `/${currentLang}/${page.Kod}`;
          if (page.Kod === 'home') {
            href = `/${currentLang}`;
          }

          // Menü metnini METINLER sekmesinden alıyoruz (örn: Bayi ve dağıtım ağı)
          const menuTitle = getText(`${page.Kod}.title`, page.Kod);

          // Sayfada aktifliği kontrol etmek için
          const isActive = pathname === href || pathname === href + '/';

          return (
            <li>
              <a href={href} class={isActive ? 'active' : ''}>
                {menuTitle}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  /* EKRAN GÖRÜNTÜSÜNDEKİ BEYAZ VE ŞIK HEADER TASARIMI */
  .site-header {
    width: 100%;
    background-color: #ffffff; /* Görseldeki beyaz bar */
    border-bottom: 1px solid #eaeaea;
    padding: 0 2rem;
    height: 70px;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 1000;
  }
  
  .header-container {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .logo-link {
    text-decoration: none;
    display: flex;
    align-items: center;
  }
  
  .logo-img {
    height: 35px;
    width: auto;
    object-fit: contain;
  }
  
  .logo-text {
    color: #4b1b85; /* Görseldeki logoya en yakın mor/koyu ton */
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  
  .main-nav ul {
    display: flex;
    list-style: none;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }
  
  .main-nav a {
    color: #1f2937; /* Görseldeki siyah menü öğeleri */
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.2s ease, font-weight 0.2s;
  }
  
  .main-nav a:hover,
  .main-nav a.active {
    color: #0b2218; /* Üzerine gelindiğinde veya aktifken kurumsal koyu yeşil */
    font-weight: 700;
  }

  /* MOBİL UYUMLULUK (Sayfadan taşmayı önler) */
  @media (max-width: 1024px) {
    .site-header {
      height: auto;
      padding: 1rem;
    }
    .header-container {
      flex-direction: column;
      gap: 1rem;
    }
    .main-nav ul {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }
  }
</style>
