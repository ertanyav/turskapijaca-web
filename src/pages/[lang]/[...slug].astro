---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPages, getTexts, getDocuments } from '../../lib/sheets';

const { lang, slug } = Astro.params;
const validLangs = ['tr', 'en', 'me'];

if (!validLangs.includes(lang)) {
  return Astro.redirect('/tr');
}

const [pages, texts, documents] = await Promise.all([
  getPages(),
  getTexts(),
  getDocuments()
]);

// İlgili sayfayı adrese göre bul
const currentPage = pages.find(p => {
  const pathStr = p[`adres${lang}`] || p['adrestr'] || p.kod;
  if (!pathStr) return false;
  const cleanPath = String(pathStr).replace(/^\//, '').toLowerCase();
  return cleanPath === (slug || '').toLowerCase();
});

if (!currentPage) {
  return Astro.redirect(`/${lang}`);
}

const pageTitle = currentPage[`ad${lang}`] || currentPage['adtr'] || currentPage.kod;
const pageContent = currentPage[`icerik${lang}`] || currentPage['iceriktr'] || currentPage[`aciklama${lang}`] || currentPage['aciklamatr'] || '';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle} | TURSKA PIJACA</title>
    <style>
      body { margin: 0; font-family: system-ui, -apple-system, sans-serif; background-color: #f8fafc; color: #0f172a; }
      .container { max-width: 1100px; margin: 3.5rem auto; padding: 0 1.5rem; min-height: 60vh; }
      .content-card {
        background: white;
        padding: 3rem;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        border: 1px solid #e2e8f0;
      }
      .content-card h1 { color: #0b2218; font-size: 2.2rem; margin-top: 0; margin-bottom: 1.5rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 1rem; }
      .body-text { font-size: 1.1rem; line-height: 1.8; color: #334155; }
      .doc-list { list-style: none; padding: 0; margin-top: 2rem; }
      .doc-item { display: flex; justify-content: space-between; align-items: center; background: #f8fafc; padding: 1rem 1.5rem; border-radius: 8px; margin-bottom: 0.8rem; border: 1px solid #e2e8f0; }
      .doc-btn { background: #0b2218; color: white; padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; font-size: 0.9rem; font-weight: 600; }
    </style>
  </head>
  <body>
    <Header />

    <main class="container">
      <div class="content-card">
        <h1>{pageTitle}</h1>
        
        {pageContent ? (
          <div class="body-text" set:html={pageContent} />
        ) : (
          <div class="body-text">
            <p>TP_MASTER tablosunda bu sayfa için eklenmiş olan içerikler yüklenmektedir.</p>
          </div>
        )}

        {/* Eğer Belgeler/Dokümanlar sayfasıysa tablodaki dokümanları listele */}
        {currentPage.kod && currentPage.kod.toLowerCase().includes('dokuman') && documents && documents.length > 0 && (
          <ul class="doc-list">
            {documents.map(doc => (
              <li class="doc-item">
                <span>📄 {doc[`ad${lang}`] || doc['adtr'] || 'Doküman'}</span>
                <a href={doc.url || doc.link || '#'} target="_blank" class="doc-btn">İndir / İncele</a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </main>

    <Footer lang={lang} />
  </body>
</html>
