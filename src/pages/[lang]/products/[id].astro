---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getProducts, getTexts } from '../../../lib/sheets';

export async function getStaticPaths() {
  const products = await getProducts();
  return ['en', 'me', 'tr'].flatMap(lang => 
    products.map(p => ({
      params: { lang, id: String(p['Ürün no'] || p['Kayıt ID']).trim() },
      props: { product: p }
    }))
  ).filter(p => p.params.id);
}

const { lang, id } = Astro.params;
const { product } = Astro.props;
const texts = await getTexts();

const title = product[`Ad ${lang.toUpperCase()}`] || product['Ad TR'] || product['Ad EN'] || product['İç ad'] || 'Ürün';
const category = product['Kategori'] || 'General';
const brand = product['Marka'] || 'TURSKA PIJACA';
const pack = product['Ambalaj'] || 'Standard';
const packType = product['Ambalaj tipi'] || product['Paket tipi'] || 'Koli / Paket';
const origin = product['Menşe'] || 'Türkiye';
const image = product['Görsel URL'] && product['Görsel URL'].startsWith('http') ? product['Görsel URL'] : 'https://via.placeholder.com/500x500/142e23/d9b871?text=TP';

let rawPrice = (product['Fiyat EUR'] ? String(product['Fiyat EUR']) : '').replace(/TRY|TL|EUR|€|\$/gi, '').trim();
const hasPrice = (rawPrice && rawPrice !== '0' && rawPrice !== '0,00');
const priceDisplay = hasPrice ? `€${parseFloat(rawPrice.replace(',', '.')).toFixed(2)}` : 'Fiyat Sorunuz';
---

<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <title>{title} | TURSKA PIJACA</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>
<body style="margin: 0; font-family: system-ui, sans-serif; background: #0d221a; color: #f0f4ed;">
  <Header lang={lang} texts={texts} />

  <main style="max-width: 1000px; margin: 3rem auto; padding: 0 1.5rem;">
    <!-- Breadcrumb -->
    <div style="margin-bottom: 1.5rem; font-size: 0.85rem; color: #a3c2b5;">
      <a href={`/${lang}/`} target="_self" style="color: #d9b871; text-decoration: none; font-weight: bold;">Katalog</a> / 
      <span>{category}</span> / <strong style="color: #f0f4ed;">{title}</strong>
    </div>

    <!-- Ürün Detay Kartı -->
    <div style="background: #142e23; border-radius: 16px; padding: 2.5rem; border: 1px solid #234d3c; display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem;">
      <div style="background: white; border-radius: 12px; padding: 1.5rem; display: flex; justify-content: center; align-items: center;">
        <img src={image} alt={title} style="max-width: 100%; max-height: 400px; object-fit: contain;" />
      </div>

      <div>
        <span style="background: #173f31; color: #d9b871; font-size: 0.8rem; padding: 0.3rem 0.8rem; border-radius: 4px; font-weight: bold; border: 1px solid #234d3c;">{brand}</span>
        <h1 style="font-size: 2rem; margin: 1rem 0; color: #f0f4ed; font-weight: 800; line-height: 1.25;">{title}</h1>

        <div style="background: #0d221a; padding: 1.2rem; border-radius: 8px; border: 1px solid #234d3c; margin-bottom: 1.5rem;">
          <span style="font-size: 0.75rem; color: #a3c2b5; font-weight: bold; display: block; text-transform: uppercase;">B2B TOPTAN FİYAT</span>
          <span style="font-size: 2.2rem; font-weight: 900; color: #d9b871;">{priceDisplay}</span>
        </div>

        <!-- Tüm Künye Özellikleri (Ürün no, Marka, Ambalaj, Ambalaj tipi, Menşe) -->
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem; margin-bottom: 2rem; color: #a3c2b5;">
          <tr style="border-bottom: 1px solid #234d3c;">
            <td style="padding: 0.7rem 0;">Ürün no (SKU):</td>
            <td style="padding: 0.7rem 0; font-weight: bold; text-align: right; color: #f0f4ed;">{id}</td>
          </tr>
          <tr style="border-bottom: 1px solid #234d3c;">
            <td style="padding: 0.7rem 0;">Marka:</td>
            <td style="padding: 0.7rem 0; font-weight: bold; text-align: right; color: #f0f4ed;">{brand}</td>
          </tr>
          <tr style="border-bottom: 1px solid #234d3c;">
            <td style="padding: 0.7rem 0;">Ambalaj:</td>
            <td style="padding: 0.7rem 0; font-weight: bold; text-align: right; color: #f0f4ed;">{pack}</td>
          </tr>
          <tr style="border-bottom: 1px solid #234d3c;">
            <td style="padding: 0.7rem 0;">Ambalaj tipi:</td>
            <td style="padding: 0.7rem 0; font-weight: bold; text-align: right; color: #f0f4ed;">{packType}</td>
          </tr>
          <tr style="border-bottom: 1px solid #234d3c;">
            <td style="padding: 0.7rem 0;">Menşe:</td>
            <td style="padding: 0.7rem 0; font-weight: bold; text-align: right; color: #f0f4ed;">{origin}</td>
          </tr>
        </table>

        <a href={`https://wa.me/38263256666?text=B2B%20Siparis:%20${encodeURIComponent(title)}%20(${id})`} target="_self" style="display: block; text-align: center; background: #22c55e; color: white; padding: 1rem; border-radius: 10px; text-decoration: none; font-weight: bold; font-size: 1.05rem; box-shadow: 0 4px 12px rgba(34,197,94,0.3);">
          💬 WhatsApp B2B Doğrudan Sipariş
        </a>
      </div>
    </div>
  </main>

  <Footer lang={lang} texts={texts} />
</body>
</html>
