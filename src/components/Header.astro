---
const { lang = 'en', texts = {} } = Astro.props;

const logoUrl = 'https://lh3.googleusercontent.com/d/14BFS24JrQOpz1ALBLzUGd0T-0Jw4c0jy=w200';

const navCatalog = texts['ui.fullCatalog']?.[lang] || 'Ürün Kataloğu';
const navDocs = texts['documents.intro']?.[lang] ? 'Dokümanlar' : 'Dokümanlar';
const navAbout = texts['ui.company']?.[lang] || 'Kurumsal & Lojistik';
---

<header style="background: #173f31; color: #f0f4ed; border-bottom: 3px solid #d9b871; position: sticky; top: 0; z-index: 1000; box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
  <div style="max-width: 1280px; margin: 0 auto; padding: 0.9rem 1.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
    
    <!-- Logo & Title -->
    <a href={`/${lang}/`} target="_self" style="color: white; font-weight: 800; font-size: 1.5rem; text-decoration: none; display: flex; align-items: center; gap: 0.8rem;">
      <img src={logoUrl} alt="TURSKA PIJACA Logo" style="height: 48px; width: auto; object-fit: contain;" />
      <div>
        <span style="color: #f0f4ed; letter-spacing: -0.5px; display: block; font-size: 1.4rem; font-weight: 900;">TURSKA PIJACA</span>
        <span style="font-size: 0.72rem; color: #d9b871; font-weight: 600; display: block; margin-top: -2px;">UNIVERCERT MNE D.O.O. · Seda Gıda Representative</span>
      </div>
    </a>

    <!-- Nav, Corporate Language Switcher & Cart -->
    <div style="display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap;">
      
      <!-- Corporate Language / Domain Selector -->
      <div style="background: #0d221a; border: 1px solid #234d3c; padding: 0.25rem 0.4rem; border-radius: 8px; display: flex; gap: 0.3rem; align-items: center;">
        <a href="https://www.turskapijaca.com/en/" target="_self" style={`padding: 0.25rem 0.6rem; border-radius: 5px; font-size: 0.78rem; font-weight: 700; text-decoration: none; ${lang === 'en' ? 'background: #d9b871; color: #173f31;' : 'color: #a3c2b5;'}`}>
          🌐 EN (.com)
        </a>
        <a href="https://www.turskapijaca.me/me/" target="_self" style={`padding: 0.25rem 0.6rem; border-radius: 5px; font-size: 0.78rem; font-weight: 700; text-decoration: none; ${lang === 'me' ? 'background: #d9b871; color: #173f31;' : 'color: #a3c2b5;'}`}>
          🇲🇪 ME (.me)
        </a>
        <a href="https://www.turskapijaca.com.tr/tr/" target="_self" style={`padding: 0.25rem 0.6rem; border-radius: 5px; font-size: 0.78rem; font-weight: 700; text-decoration: none; ${lang === 'tr' ? 'background: #d9b871; color: #173f31;' : 'color: #a3c2b5;'}`}>
          🇹🇷 TR (.com.tr)
        </a>
      </div>

      <nav style="display: flex; gap: 1.2rem; align-items: center;">
        <a href={`/${lang}/`} target="_self" style="color: #f0f4ed; text-decoration: none; font-weight: 700; font-size: 0.92rem;">{navCatalog}</a>
        <a href={`/${lang}/documents`} target="_self" style="color: #a3c2b5; text-decoration: none; font-weight: 600; font-size: 0.92rem;">{navDocs}</a>
        <a href={`/${lang}/about`} target="_self" style="color: #a3c2b5; text-decoration: none; font-weight: 600; font-size: 0.92rem;">{navAbout}</a>
      </nav>
      
      <!-- Sepet Butonu -->
      <button id="openCartBtn" style="background: #d9b871; color: #173f31; border: none; padding: 0.55rem 1.1rem; border-radius: 8px; font-weight: 800; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; box-shadow: 0 2px 10px rgba(217,184,113,0.3);">
        🛒 <span>Sepetim</span>
        <span id="cartBadge" style="background: #173f31; color: #d9b871; padding: 0.15rem 0.5rem; border-radius: 20px; font-size: 0.75rem; font-weight: 900;">0</span>
      </button>

    </div>
  </div>
</header>
