---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPages, getTexts, getProducts, getCategories, getBrands, getDealers, getDocuments, getTextDictionary } from '../../lib/sheets';

const { lang = 'tr', slug } = Astro.params;
const target = (slug || '').toLowerCase();

const [pages, texts, products, categories, brands, dealers, documents, dict] = await Promise.all([
  getPages(), getTexts(), getProducts(), getCategories(), getBrands(), getDealers(), getDocuments(), getTextDictionary(lang)
]);

const currentPage = pages.find(p => {
  if (!p) return false;
  return target === String(p.adrestr || '').replace(/^\//, '').toLowerCase() || 
         target === String(p.adresen || '').replace(/^\//, '').toLowerCase() || 
         target === (p.kod || '').toLowerCase();
});

const matchedCategory = categories.find(c => target === String(c.adrestr || '').replace(/^\//, '').toLowerCase());
const isProductPage = (currentPage && (currentPage.kod === 'products' || currentPage.kod === 'catalog' || target.includes('urunler'))) || matchedCategory;

const isBrandsPage = currentPage && currentPage.kod === 'brands';
const isDealersPage = currentPage && currentPage.kod === 'network';
const isDocsPage = currentPage && currentPage.kod === 'documents';

let displayedProducts = products || [];
if (matchedCategory) {
  displayedProducts = displayedProducts.filter(p => (p.kategori || '').toUpperCase() === (matchedCategory.kod || '').toUpperCase());
}

let pageTitle = currentPage ? (currentPage[`ad${lang}`] || currentPage.adtr) : (matchedCategory ? matchedCategory[`ad${lang}`] || matchedCategory.adtr : 'Sayfa');
let pageParagraphs = [];

if (texts && currentPage) {
  const langCol = lang === 'en' ? 'english' : lang === 'me' ? 'crnogorski' : 'turkce';
  const pagePrefix = `${(currentPage.kod || '').toLowerCase()}.`;
  texts.forEach(t => {
    const key = (t.anahtar || '').toLowerCase();
    if (key.startsWith(pagePrefix) && !key.endsWith('.title') && (t[langCol] || t.turkce)) {
      pageParagraphs.push(t[langCol] || t.turkce);
    }
  });
}

const txtAddToCart = dict['product.addtocart'] || 'Sepete Ekle';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <style>
      body { margin: 0; font-family: 'Inter', system-ui; background: #f8fafc; color: #0f172a; }
      .container { max-width: 1250px; margin: 3rem auto; padding: 0 1.5rem; min-height: 60vh; }
      .page-header h1 { font-size: 2.2rem; color: #0b2218; font-weight: 800; margin: 0 0 2rem; }
      
      /* Filtreleme */
      .filter-bar { background: white; padding: 1.2rem; border-radius: 8px; border: 1px solid #e2e8f0; display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem; }
      .filter-input { flex: 1; min-width: 200px; padding: 0.8rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 1rem; }
      
      /* Ürün Grid */
      .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem; }
      .product-card { background: white; border-radius: 12px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; overflow: hidden; }
      .product-img { width: 100%; height: 220px; object-fit: contain; padding: 1rem; border-bottom: 1px solid #f1f5f9; }
      .product-info { padding: 1.2rem; display: flex; flex-direction: column; flex-grow: 1; }
      .product-name { font-size: 1.05rem; font-weight: 700; color: #0f172a; margin: 0 0 0.5rem; }
      .product-meta { font-size: 0.85rem; color: #64748b; margin-bottom: 1rem; }
      .product-price { font-size: 1.2rem; font-weight: 800; color: #059669; margin-bottom: 1rem; }
      .btn-add { background: #34d399; color: #0b2218; border: none; padding: 0.8rem; border-radius: 6px; font-weight: 800; font-size: 0.95rem; cursor: pointer; text-align: center; margin-top: auto; }

      /* Marka ve Bayi Kartları */
      .entities-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 1.5rem; margin-bottom: 3rem; }
      .entity-card { background: white; border: 1px solid #e2e8f0; padding: 1.8rem; border-radius: 12px; text-decoration: none; color: inherit; display: flex; flex-direction: column; }
      .entity-img { width: 100%; height: 90px; object-fit: contain; margin-bottom: 1rem;}
    </style>
  </head>
  <body>
    <Header />
    <main class="container">
      <div class="page-header"><h1>{pageTitle}</h1></div>

      {isProductPage ? (
        <div>
          <div class="filter-bar">
            <input type="text" id="searchInput" class="filter-input" placeholder="Ürün ara / Search products..." />
            <select id="catSelect" class="filter-input">
              <option value="">Tüm Kategoriler</option>
              {categories.map(c => <option value={(c.kod || '').toLowerCase()}>{c[`ad${lang}`] || c.adtr}</option>)}
            </select>
            <select id="brandSelect" class="filter-input">
              <option value="">Tüm Markalar</option>
              {brands.map(b => <option value={(b.marka || '').toLowerCase()}>{b.marka}</option>)}
            </select>
          </div>

          <div class="products-grid" id="productsGrid">
            {displayedProducts.map(p => {
              const name = p[`ad${lang}`] || p.adtr || p.icad;
              const code = p.urunno || p.kayitid || '';
              const priceNum = parseFloat(String(p.fiyateur || '0').replace(',', '.')) || 0;
              const priceStr = priceNum > 0 ? `${p.fiyateur} €` : '';

              return (
                <div class="product-card" data-name={name.toLowerCase()} data-code={code.toLowerCase()} data-cat={(p.kategori||'').toLowerCase()} data-brand={(p.marka||'').toLowerCase()}>
                  <img src={p.gorselurl || 'https://via.placeholder.com/400'} class="product-img" loading="lazy" />
                  <div class="product-info">
                    <div class="product-name">{name}</div>
                    <div class="product-meta">{p.marka || '-'} | Kod: {code}</div>
                    {priceStr && <div class="product-price">{priceStr}</div>}
                    <button class="btn-add" onclick={`addToCart('${code}', '${name.replace(/'/g, "\\'")}', '${p.gorselurl || ''}', ${priceNum})`}>
                      🛒 {txtAddToCart}
                    </button>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ) : (
        <div style="background: white; padding: 3rem; border-radius: 16px; border: 1px solid #e2e8f0;">
          {pageParagraphs.map(txt => <p style="font-size: 1.1rem; line-height: 1.8; color: #475569;">{txt}</p>)}
          
          {isBrandsPage && brands && (
            <>
              <h2 style="color:#0b2218; margin-top:2rem;">Distribütörlüğünü Yaptığımız Markalar</h2>
              <div class="entities-grid">
                {brands.filter(b => b.tur.includes('DISTRIBUTOR')).map(b => (
                  <a href={`/${lang}/ürünler/tüm-ürünler?marka=${b.marka}`} class="entity-card">
                    {b.gorselurl ? <img src={b.gorselurl} class="entity-img" /> : <h3>{b.marka}</h3>}
                  </a>
                ))}
              </div>
              <h2 style="color:#0b2218;">Satış Portföyümüzdeki Markalar</h2>
              <div class="entities-grid">
                {brands.filter(b => b.tur.includes('PORTFOLIO') || !b.tur.includes('DISTRIBUTOR')).map(b => (
                  <a href={`/${lang}/ürünler/tüm-ürünler?marka=${b.marka}`} class="entity-card">
                    {b.gorselurl ? <img src={b.gorselurl} class="entity-img" /> : <h3>{b.marka}</h3>}
                  </a>
                ))}
              </div>
            </>
          )}

          {isDealersPage && dealers && (
            <>
              <h2 style="color:#0b2218; margin-top:2rem;">Yetkili Satış Noktaları</h2>
              <div class="entities-grid">
                {dealers.filter(d => d.tur.includes('DEALER')).map(d => (
                  <div class="entity-card">
                    <h3 style="margin: 0; color:#0b2218;">{d.ad}</h3>
                    <div style="font-weight:bold; color:#34d399; margin:0.5rem 0;">{d.sehir}</div>
                    {d.adres && <div>📍 {d.adres}</div>}
                    {d.telefon && <div>📞 {d.telefon}</div>}
                  </div>
                ))}
              </div>
              <h2 style="color:#0b2218;">Depolarımız</h2>
              <div class="entities-grid">
                {dealers.filter(d => d.tur.includes('WAREHOUSE')).map(d => (
                  <div class="entity-card" style="background:#f8fafc;">
                    <h3 style="margin: 0; color:#0b2218;">{d.ad}</h3>
                    <div style="font-weight:bold; margin:0.5rem 0;">{d.sehir}</div>
                    {d.adres && <div>📍 {d.adres}</div>}
                  </div>
                ))}
              </div>
            </>
          )}

          {isDocsPage && documents && (
            <div style="margin-top:2rem;">
              {documents.map(doc => (
                <div style="display:flex; justify-content:space-between; align-items:center; background:#f8fafc; padding:1.5rem; border-radius:8px; margin-bottom:1rem;">
                  <div>
                    <h3 style="margin:0 0 0.5rem;">{doc[`ad${lang}`] || doc.adtr}</h3>
                    <div style="color:#64748b;">{doc[`aciklama${lang}`] || doc.aciklamatr}</div>
                  </div>
                  <a href={`https://drive.google.com/file/d/${doc.driveid}/view`} target="_blank" style="background:#0b2218; color:white; padding:0.8rem 1.5rem; border-radius:6px; text-decoration:none; font-weight:bold;">Görüntüle</a>
                </div>
              ))}
            </div>
          )}
        </div>
      )}
    </main>
    <script>
      const searchInput = document.getElementById('searchInput');
      const catSelect = document.getElementById('catSelect');
      const brandSelect = document.getElementById('brandSelect');
      const grid = document.getElementById('productsGrid');

      if (grid) {
        const cards = Array.from(grid.children);
        const filterCards = () => {
          const q = (searchInput?.value || '').toLowerCase();
          const cat = (catSelect?.value || '').toLowerCase();
          const brand = (brandSelect?.value || '').toLowerCase();

          cards.forEach(card => {
            const matchQ = card.getAttribute('data-name').includes(q) || card.getAttribute('data-code').includes(q);
            const matchCat = !cat || card.getAttribute('data-cat') === cat;
            const matchBrand = !brand || card.getAttribute('data-brand') === brand;
            card.style.display = (matchQ && matchCat && matchBrand) ? 'flex' : 'none';
          });
        };
        searchInput?.addEventListener('input', filterCards);
        catSelect?.addEventListener('change', filterCards);
        brandSelect?.addEventListener('change', filterCards);

        const urlParams = new URLSearchParams(window.location.search);
        const urlBrand = urlParams.get('marka');
        if (urlBrand && brandSelect) {
          brandSelect.value = urlBrand.toLowerCase();
          filterCards();
        }
      }
    </script>
    <Footer lang={lang} />
  </body>
</html>
