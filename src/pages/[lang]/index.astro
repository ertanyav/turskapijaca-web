---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getProducts, getTexts, getBrands } from '../../lib/sheets';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'me' } },
    { params: { lang: 'tr' } }
  ];
}

const { lang } = Astro.params;
const [products, texts, brands] = await Promise.all([
  getProducts(),
  getTexts(),
  getBrands()
]);

const eyebrowText = texts['home.eyebrow']?.[lang] || 'Direct From Factory · UNIVERCERT MNE D.O.O.';

// Google Sheets'ten gelen başlık ve açıklama metinlerini alıyoruz
let rawHeading = texts['home.heading']?.[lang] || (lang === 'tr' ? 'Türkiye’den Karadağ’a.' : lang === 'me' ? 'Od Turske do Crne Gore.' : 'From Turkey to Montenegro.');
let rawIntro = texts['home.intro']?.[lang] || (lang === 'tr' ? 'Doğrudan tedarik, güçlü dağıtım.' : lang === 'me' ? 'Direktno snabdijevanje, jaka distribucija.' : 'Direct supply, strong distribution.');

// Satır atlatma kuralı (Hem başlıkta hem açıklamada "Türkiye’den Karadağ’a." vb. varsa alt alta yazar)
function formatHeading(text: string, l: string) {
  if (!text) return '';
  let target = l === 'tr' ? 'Türkiye’den Karadağ’a.' : l === 'me' ? 'Od Turske do Crne Gore.' : 'From Turkey to Montenegro.';
  if (text.includes(target) && !text.includes(target + '<br>')) {
    return text.replace(target, target + '<br>');
  }
  return text;
}

const headingHtml = formatHeading(rawHeading, lang);
const introHtml = rawIntro;

const distributorIntro = texts['brands.distributorIntro']?.[lang] || 'Karadağ’daki distribütörlük portföyümüzde yer alan markalar.';
const salesIntro = texts['brands.salesIntro']?.[lang] || 'Toptan satış portföyümüzde yer alan seçilmiş markalar.';

const searchPlaceholder = texts['ui.search']?.[lang] || 'Ürün adı veya numarası...';
const clearText = texts['ui.clear']?.[lang] || 'Temizle';
const askPriceText = texts['ui.askPrice']?.[lang] || 'Fiyat İçin İletişime Geçin';

const distributorBrands = brands.filter(b => (b['Tür'] || '').toUpperCase() === 'DISTRIBUTOR');
const salesBrands = brands.filter(b => (b['Tür'] || '').toUpperCase() === 'SALES');

const categoryCounts = products.reduce((acc: any, p: any) => {
  const cat = p['Kategori'];
  if (cat) acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {});

const uniqueCategories = [...new Set(products.map(p => p['Kategori']).filter(Boolean))];
---
