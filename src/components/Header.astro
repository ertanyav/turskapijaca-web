---
const { lang = 'en', texts = {} } = Astro.props;

const siteTitle = texts['site_title']?.[lang] || 'TURSKA PIJACA';
const wholesaleSub = 'UNIVERCERT MNE D.O.O. · Seda Gıda Official Montenegro Representative';

const menuLabels = {
  tr: { catalog: 'Ürün Kataloğu', about: 'Kurumsal & Lojistik', contact: 'İletişim & B2B' },
  en: { catalog: 'B2B Catalog', about: 'About & Logistics', contact: 'Contact & B2B' },
  me: { catalog: 'B2B Katalog', about: 'O nama & Logistika', contact: 'Kontakt & B2B' }
};

const labels = menuLabels[lang] || menuLabels.en;
---

<header style="background: #0f172a; color: white; border-bottom: 3px solid #059669; position: sticky; top: 0; z-index: 1000; box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
  <!-- Top Bar -->
  <div style="background: #1e293b; font-size: 0.8rem; padding: 0.4rem 1.5rem; border-bottom: 1px solid #334155;">
    <div style="max-width: 1280px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
      <div style="color: #94a3b8; display: flex; gap: 1.2rem;">
        <span>🏬 <strong>UNIVERCERT MNE D.O.O.</strong></span>
        <span>🚚 Weekly Direct Factory Transfer (Seda Gıda)</span>
      </div>
      <div style="display: flex; gap: 0.8rem; align-items: center;">
        <span style="color: #64748b; font-size: 0.75rem;">Domains:</span>
        <a href="https://www.turskapijaca.com/en/" target="_self" style={`color: ${lang === 'en' ? '#10b981' : '#94a3b8'}; text-decoration: none; font-weight: bold;`}>Global (.com)</a>
        <a href="https://www.turskapijaca.me/me/" target="_self" style={`color: ${lang === 'me' ? '#10b981' : '#94a3b8'}; text-decoration: none; font-weight: bold;`}>Montenegro (.me)</a>
        <a href="https://www.turskapijaca.com.tr/tr/" target="_self" style={`color: ${lang === 'tr' ? '#10b981' : '#94a3b8'}; text-decoration: none; font-weight: bold;`}>Türkiye (.com.tr)</a>
      </div>
    </div>
  </div>

  <!-- Main Header -->
  <div style="max-width: 1280px; margin: 0 auto; padding: 0.9rem 1.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
    <!-- Logo & Subtitle -->
    <div>
      <a href={`/${lang}/`} target="_self" style="color: white; font-weight: 800; font-size: 1.6rem; text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
        <span style="background: #059669; color: white; padding: 0.2rem 0.6rem; border-radius: 6px; font-size: 1.2rem; font-weight: 900;">TP</span>
        {siteTitle}
      </a>
      <span style="font-size: 0.75rem; color: #94a3b8; display: block; margin-top: 0.15rem;">{wholesaleSub}</span>
    </div>

    <!-- Nav Menu (Aynı pencerede geçiş) -->
    <nav style="display: flex; gap: 1.8rem; align-items: center;">
      <a href={`/${lang}/`} target="_self" style="color: #f8fafc; text-decoration: none; font-weight: 600; font-size: 0.95rem;">{labels.catalog}</a>
      <a href={`/${lang}/about`} target="_self" style="color: #cbd5e1; text-decoration: none; font-weight: 600; font-size: 0.95rem;">{labels.about}</a>
      
      <a href="https://wa.me/38263256666" target="_self" style="background: #22c55e; color: white; padding: 0.55rem 1.1rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 0.88rem; display: flex; align-items: center; gap: 0.4rem; box-shadow: 0 2px 10px rgba(34,197,94,0.3);">
        💬 Direct B2B Order
      </a>
    </nav>
  </div>
</header>
